<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1">통계 분석</h1>
      <p class="text-muted small mb-0">카테고리별 점유율 및 상태별 분포, 일자별 추이를 분석합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <button class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise me-1"></i> 새로고침
      </button>
    </div>
  </div>

  <!-- Key Metric Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body">
          <div class="text-secondary small fw-medium">총 누적 실적 건수</div>
          <h2 class="fw-bold my-1 text-primary"><%= (overview.totalCount || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span></h2>
          <div class="text-success small"><i class="bi bi-check2-all"></i> 정상 집계 완료</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body">
          <div class="text-secondary small fw-medium">총 누적 매출/금액</div>
          <h2 class="fw-bold my-1 text-success"><%= (overview.totalAmount || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">원</span></h2>
          <div class="text-muted small">평균 건당 약 <%= overview.totalCount > 0 ? Math.round(overview.totalAmount / overview.totalCount).toLocaleString() : 0 %>원</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body">
          <div class="text-secondary small fw-medium">완료율 (성공률)</div>
          <% const completionRate = overview.totalCount > 0 ? ((overview.completedCount / overview.totalCount) * 100).toFixed(1) : 0; %>
          <h2 class="fw-bold my-1 text-info"><%= completionRate %><span class="fs-6 fw-normal text-muted ms-1">%</span></h2>
          <div class="text-muted small">총 <%= overview.completedCount %>건 완료 / <%= overview.pendingCount %>건 대기</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row 1 -->
  <div class="row g-4 mb-4">
    <!-- Category Bar Chart -->
    <div class="col-lg-7">
      <div class="card border-0 shadow-sm rounded-3 h-100">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <h5 class="fw-bold mb-0">카테고리별 누적 금액 현황</h5>
        </div>
        <div class="card-body">
          <canvas id="categoryBarChart" style="max-height: 280px;"></canvas>
        </div>
      </div>
    </div>

    <!-- Status Distribution Doughnut Chart -->
    <div class="col-lg-5">
      <div class="card border-0 shadow-sm rounded-3 h-100">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <h5 class="fw-bold mb-0">처리 상태별 분포</h5>
        </div>
        <div class="card-body d-flex align-items-center justify-content-center">
          <canvas id="statusChart" style="max-height: 260px;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Category Breakdown Table -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-0 pt-3 pb-2">
      <h5 class="fw-bold mb-0">카테고리별 상세 집계표</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-4">카테고리</th>
              <th scope="col" class="text-center">건수</th>
              <th scope="col" class="text-center">건수 점유율</th>
              <th scope="col" class="text-end">총 금액</th>
              <th scope="col" class="pe-4 text-end">금액 점유율</th>
            </tr>
          </thead>
          <tbody>
            <% if (categoryStats && categoryStats.length > 0) { %>
              <% categoryStats.forEach(stat => { 
                const countShare = overview.totalCount > 0 ? ((stat.count / overview.totalCount) * 100).toFixed(1) : 0;
                const amountShare = overview.totalAmount > 0 ? ((stat.totalAmount / overview.totalAmount) * 100).toFixed(1) : 0;
              %>
                <tr>
                  <td class="ps-4 fw-semibold"><%= stat.category %></td>
                  <td class="text-center"><%= stat.count.toLocaleString() %>건</td>
                  <td class="text-center">
                    <div class="d-flex align-items-center justify-content-center gap-2">
                      <div class="progress flex-grow-1" style="height: 6px; max-width: 80px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: <%= countShare %>%"></div>
                      </div>
                      <span class="small text-muted"><%= countShare %>%</span>
                    </div>
                  </td>
                  <td class="text-end fw-medium"><%= (stat.totalAmount || 0).toLocaleString() %>원</td>
                  <td class="pe-4 text-end text-secondary"><%= amountShare %>%</td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" class="text-center py-4 text-muted">통계 데이터가 없습니다.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<script>
  const categoryStats = <%- JSON.stringify(categoryStats || []) %>;
  const statusDistribution = <%- JSON.stringify(statusDistribution || []) %>;

  // 1. Category Bar Chart
  const barCtx = document.getElementById('categoryBarChart').getContext('2d');
  new Chart(barCtx, {
    type: 'bar',
    data: {
      labels: categoryStats.map(c => c.category),
      datasets: [{
        label: '총 금액 (원)',
        data: categoryStats.map(c => c.totalAmount),
        backgroundColor: '#3B82F6',
        borderRadius: 4
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          ticks: {
            callback: value => value.toLocaleString() + '원'
          }
        }
      }
    }
  });

  // 2. Status Doughnut Chart
  const statusCtx = document.getElementById('statusChart').getContext('2d');
  new Chart(statusCtx, {
    type: 'pie',
    data: {
      labels: statusDistribution.map(s => s.status),
      datasets: [{
        data: statusDistribution.map(s => s.count),
        backgroundColor: statusDistribution.map(s => s.color)
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });
</script>

<%- include('partials/footer') %>

