<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
        <h1 class="h3 fw-bold mb-0"><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : '어플 회원 관리' %></h1>
        <span class="badge bg-primary-subtle text-primary-emphasis border border-primary-subtle px-2.5 py-1.5 font-monospace">
          <i class="bi bi-clock-history me-1"></i>최신 업로드 일자: <strong><%= stats.lastUploadDt || '-' %></strong>
        </span>
      </div>
      <p class="text-muted small mb-0">앱 회원 데이터 조회 및 엑셀 일괄 업로드를 지원합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <!-- Clear All Button -->
      <button type="button" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1" id="btnClearAllUsers">
        <i class="bi bi-trash3-fill"></i>
        <span>전체 비우기 (초기화)</span>
      </button>
      <!-- Excel Upload Button (강조) -->
      <button type="button" class="btn btn-sm btn-success px-3 shadow-sm d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#excelUploadModal">
        <i class="bi bi-file-earmark-excel-fill fs-6"></i>
        <span class="fw-semibold">엑셀 업로드</span>
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> 새로고침
      </button>
    </div>
  </div>

  <!-- Metric Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-people fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">총 등록 회원</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1">
              <%= (stats.totalUsers || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">명</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-person-check fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">활동 회원 ('I')</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1">
              <%= (stats.activeUsers || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">명</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-danger-subtle text-danger me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-person-x fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">탈퇴 회원 ('O')</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1">
              <%= (stats.inactiveUsers || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">명</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning-subtle text-warning me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-coin fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate" title="탈퇴 회원('O') 제외, 활동 회원('I') 포인트 합산 금액">총 보유 포인트 (활동)</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1 text-truncate">
              <%= (stats.totalPoints || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">P</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Form -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
      <form method="GET" action="/users">
        <input type="hidden" name="limit" value="<%= pagination.limit %>">

        <!-- 1행: 검색 조건, 검색어, 회원 상태 -->
        <div class="row g-2 align-items-center mb-2">
          <div class="col-md-3">
            <select name="searchType" class="form-select form-select-sm">
              <option value="all" <%= filters.searchType === 'all' ? 'selected' : '' %>>전체 검색</option>
              <option value="nm" <%= filters.searchType === 'nm' ? 'selected' : '' %>>회원 이름 (nm)</option>
              <option value="phone" <%= filters.searchType === 'phone' ? 'selected' : '' %>>휴대폰 번호 (phone)</option>
            </select>
          </div>

          <div class="col-md-6">
            <input type="text" name="keyword" class="form-control form-control-sm" placeholder="검색어를 입력하세요..." value="<%= filters.keyword || '' %>">
          </div>

          <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
              <option value="">모든 회원 상태</option>
              <option value="I" <%= filters.status === 'I' ? 'selected' : '' %>>활동 (I: 가입)</option>
              <option value="O" <%= filters.status === 'O' ? 'selected' : '' %>>탈퇴 (O: 탈퇴)</option>
            </select>
          </div>
        </div>

        <!-- 2행: 기간 검색(가입일) 및 검색 버튼 -->
        <div class="row g-2 align-items-center">
          <div class="col-md-6 col-lg-5">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light text-muted fw-medium">가입일</span>
              <input type="date" name="startDate" class="form-control" value="<%= filters.startDate || '' %>" title="가입 시작일">
              <span class="input-group-text bg-light text-muted">~</span>
              <input type="date" name="endDate" class="form-control" value="<%= filters.endDate || '' %>" title="가입 종료일">
            </div>
          </div>

          <div class="col-md-6 col-lg-7 d-flex justify-content-md-end gap-1">
            <button type="submit" class="btn btn-sm btn-dark px-3">
              검색
            </button>
            <a href="/users" class="btn btn-sm btn-light border px-2" title="필터 초기화">
              <i class="bi bi-arrow-counterclockwise"></i>
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Users Table Card -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div class="small text-muted d-flex align-items-center gap-2 flex-wrap">
        <span>검색 결과: <strong class="text-dark"><%= pagination.total.toLocaleString() %></strong>명 | 현재 <strong class="text-primary"><%= pagination.page %></strong> / 최대 <strong class="text-dark"><%= pagination.totalPages || 1 %></strong> 페이지</span>
        <span class="text-secondary opacity-50">|</span>
        <span>최신 업로드: <strong class="text-primary font-monospace"><%= stats.lastUploadDt || '-' %></strong></span>
      </div>
      <div class="d-flex align-items-center gap-2">
        <span class="badge bg-light text-secondary border">
          <i class="bi bi-cursor-fill text-primary me-1"></i>행(Row)을 클릭하면 상세 조회 및 수정이 가능합니다.
        </span>
        <label class="small text-muted mb-0 ms-1">표시 개수:</label>
        <select class="form-select form-select-sm" style="width: auto;" onchange="changeLimit(this.value)">
          <option value="20" <%= pagination.limit === 20 ? 'selected' : '' %>>20개씩</option>
          <option value="30" <%= pagination.limit === 30 ? 'selected' : '' %>>30개씩</option>
          <option value="40" <%= pagination.limit === 40 ? 'selected' : '' %>>40개씩</option>
          <option value="50" <%= pagination.limit === 50 ? 'selected' : '' %>>50개씩</option>
          <option value="100" <%= pagination.limit === 100 ? 'selected' : '' %>>100개씩</option>
        </select>
      </div>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 user-table no-scroll-table">
          <colgroup>
            <col style="width: 4%;">
            <col style="width: 8%;">
            <col style="width: 7%;">
            <col style="width: 11.5%;">
            <col style="width: 8.5%;">
            <col style="width: 12%;">
            <col style="width: 12%;">
            <col style="width: 7%;">
            <col style="width: 7%;">
            <col style="width: 17%;">
            <col style="width: 6%;">
          </colgroup>
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-center col-w-no">No</th>
              <th scope="col" class="text-center col-w-name">이름 (nm)</th>
              <th scope="col" class="text-center col-w-birth">생년월일</th>
              <th scope="col" class="text-center col-w-phone">휴대폰 번호</th>
              <th scope="col" class="text-end col-w-point">포인트</th>
              <th scope="col" class="text-center col-w-datetime">가입일시</th>
              <th scope="col" class="text-center col-w-datetime">최종접속일시</th>
              <th scope="col" class="text-center col-w-approval">가입승인여부</th>
              <th scope="col" class="text-center col-w-status">탈퇴여부</th>
              <th scope="col" class="text-start col-w-memo">메모</th>
              <th scope="col" class="text-center col-w-action">관리</th>
            </tr>
          </thead>
          <tbody>
            <% if (items && items.length > 0) { %>
              <% items.forEach((u, idx) => { %>
                <tr class="clickable-row" data-un="<%= u.un %>" onclick="openUserEditModal(<%= u.un %>, event)" title="클릭하여 회원 상세 정보 확인 및 수정">
                  <td class="text-center text-muted small col-w-no"><%= (pagination.page - 1) * pagination.limit + (idx + 1) %></td>
                  <td class="text-center fw-semibold text-dark col-w-name">
                    <span class="text-primary text-decoration-underline"><%= u.nm %></span>
                  </td>
                  <td class="text-center text-secondary small col-w-birth"><%= formatDate(u.birth_dt) %></td>
                  <td class="text-center font-monospace small col-w-phone"><%= u.phone || '-' %></td>
                  <td class="text-end fw-semibold text-primary col-w-point"><%= (u.point || 0).toLocaleString() %> P</td>
                  <td class="text-center text-muted small col-w-datetime"><%= formatDateTime(u.join_dt) %></td>
                  <td class="text-center text-muted small col-w-datetime"><%= formatDateTime(u.last_login_dt) %></td>
                  <td class="text-center col-w-approval">
                    <% if (u.approval_yn === 'Y' || u.approval_yn === '승인' || !u.approval_yn) { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary">승인</span>
                    <% } else { %>
                      <span class="badge bg-secondary-subtle text-secondary border border-secondary"><%= u.approval_yn %></span>
                    <% } %>
                  </td>
                  <td class="text-center col-w-status">
                    <% if (u.status === 'I') { %>
                      <span class="badge bg-success-subtle text-success border border-success">가입 (I)</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger">탈퇴 (O)</span>
                    <% } %>
                  </td>
                  <td class="td-memo text-muted small text-start col-w-memo text-truncate" style="max-width: 140px;" title="<%= u.memo || '' %>">
                    <%= u.memo || '-' %>
                  </td>
                  <td class="text-center col-w-action" onclick="event.stopPropagation()">
                    <div class="btn-group btn-group-sm">
                      <button type="button" class="btn btn-outline-primary py-0 px-2" title="회원 상세 및 수정" onclick="openUserEditModal(<%= u.un %>, event)">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                      <button type="button" class="btn btn-outline-danger py-0 px-2 btn-delete-user" data-un="<%= u.un %>" data-nm="<%= u.nm %>" title="회원 삭제" onclick="deleteUser(<%= u.un %>, '<%= u.nm %>', event)">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="11" class="text-center py-5 text-muted">
                  <i class="bi bi-person-x fs-2 d-block mb-2 text-secondary"></i>
                  등록된 회원 데이터가 없습니다. 상단의 <strong>[엑셀 업로드]</strong> 버튼을 눌러 회원을 등록해 보세요.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pagination && pagination.total > 0) { %>
      <div class="card-footer bg-white border-0 py-3 d-flex justify-content-center">
        <%- include('partials/pagination', { pagination, filters, baseUrl }) %>
      </div>
    <% } %>
  </div>
</main>

<!-- Excel Upload Modal -->
<div class="modal fade" id="excelUploadModal" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content border-0 shadow">
      <form id="excelUploadForm" enctype="multipart/form-data">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
            <i class="bi bi-file-earmark-excel text-success fs-4"></i>
            엑셀 데이터 업로드
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          <!-- 1. 엑셀 데이터 구분 (Type 선택) -->
          <div class="mb-3">
            <label class="form-label small fw-bold">업로드 대상 구분 <span class="text-danger">*</span></label>
            <div class="row g-2">
              <div class="col-6">
                <input type="radio" class="btn-check" name="excelType" id="typeUser" value="user" checked>
                <label class="btn btn-outline-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2" for="typeUser">
                  <i class="bi bi-people-fill"></i>
                  <span class="fw-semibold">회원 정보</span>
                </label>
              </div>
              <div class="col-6">
                <input type="radio" class="btn-check" name="excelType" id="typeActivation" value="activation">
                <label class="btn btn-outline-success w-100 py-2 d-flex align-items-center justify-content-center gap-2" for="typeActivation">
                  <i class="bi bi-phone-fill"></i>
                  <span class="fw-semibold">개통 이력</span>
                </label>
              </div>
            </div>
          </div>

          <!-- 2-A. 회원(app_user) 컬럼 가이드 -->
          <div id="guideBoxUser" class="alert alert-secondary py-2 px-3 small mb-3">
            <div class="fw-bold mb-1 text-primary"><i class="bi bi-info-circle-fill me-1"></i> [회원 정보] 엑셀 컬럼 순서 안내 (1열~10열)</div>
            <ol class="mb-0 ps-3">
              <li><strong>고객 고유번호 (un)</strong>: 필수 (예: 11340)</li>
              <li><strong>이름 (nm)</strong>: 필수 (예: 정미영)</li>
              <li><strong>포인트 (point)</strong>: 콤마 자동 파싱 (예: 50,100 -> 50100)</li>
              <li><strong>생년월일 (birth_dt)</strong>: 자동 변환 (예: 1978년 01월 12일 -> 1978-01-12)</li>
              <li><strong>휴대폰번호 (phone)</strong>: (예: 010-6296-0067)</li>
              <li><strong>메모 (memo)</strong>: 빈값 가능</li>
              <li><strong>가입일 (join_dt)</strong>: (예: 2026-10-29 06:54:26)</li>
              <li><strong>최종접속일 (last_login_dt)</strong>: (예: 2026-10-29 06:54:26)</li>
              <li><strong>가입승인여부</strong>: 미사용 또는 빈칸</li>
              <li><strong>탈퇴여부 (status)</strong>: 'I'(가입) 또는 'O'(탈퇴)</li>
            </ol>
            <div class="mt-2 text-primary" style="font-size: 0.78rem;">
              * 이미 존재하는 고객 고유번호(un)인 경우 기존 데이터를 최신 정보로 자동 갱신(UPSERT)합니다.
            </div>
          </div>

          <!-- 2-B. 개통(activation_log) 컬럼 가이드 -->
          <div id="guideBoxActivation" class="alert alert-success-subtle border border-success py-2 px-3 small mb-3 d-none">
            <div class="fw-bold mb-1 text-success"><i class="bi bi-check-circle-fill me-1"></i> [개통 이력] 통신사 기본 80개 엑셀 구조 지원</div>
            <div class="small text-secondary mb-1">
              원본 엑셀의 총 80개 컬럼(번호, 관리코드, 개통일, 모델명, 일련번호, 제품구분, ..., 판매약정옵션, 재고구분)이 누락 없이 데이터베이스에 그대로 저장됩니다.
            </div>
            <div class="p-2 bg-white rounded border border-success-subtle" style="font-size: 0.76rem; max-height: 85px; overflow-y: auto;">
              <code>번호 | 관리코드 | 개통일 | 모델명 | 일련번호 | 제품구분 | 출고가 | VAT | 출고가(VAT별도) | 개통처리자 | 고객명 | 개통번호 | 색상 | 생년월일 | ... | 판매약정옵션 | 재고구분</code>
            </div>
            <div class="mt-2 text-success fw-medium" style="font-size: 0.78rem;">
              * 조회 화면에는 업무 핵심 기준 컬럼(관리코드, 고객명, 개통번호, 모델명 등)이 정돈되어 출력됩니다.
            </div>
          </div>

          <!-- File Input -->
          <div class="mb-3">
            <label class="form-label small fw-semibold">엑셀 파일 선택 (.xlsx, .xls) <span class="text-danger">*</span></label>
            <input type="file" name="excelFile" id="excelFileInput" class="form-control" accept=".xlsx, .xls" required>
          </div>

          <!-- Progress / Alert Box -->
          <div id="uploadStatusAlert" class="alert d-none py-2 px-3 small mb-0"></div>
        </div>

        <div class="modal-footer bg-light">
          <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal" id="modalCloseBtn">닫기</button>
          <button type="submit" class="btn btn-sm btn-success px-3" id="uploadSubmitBtn">
            <i class="bi bi-cloud-arrow-up-fill me-1"></i> 업로드 및 일괄 저장
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- 회원 상세 정보 확인 및 수정 모달 인클루드 -->
<%- include('partials/modalUserEdit') %>

<script>
  // 단건 회원 삭제 함수
  async function deleteUser(un, nm, event) {
    if (event) event.stopPropagation();
    if (!confirm(`회원 [${nm}](고유번호: ${un}) 데이터를 정말로 삭제하시겠습니까?`)) {
      return;
    }
    try {
      const res = await fetch(`/api/users/${un}`, { method: 'DELETE' });
      const result = await res.json();
      if (result.success) {
        alert(result.message);
        location.reload();
      } else {
        alert('삭제 실패: ' + result.message);
      }
    } catch (err) {
      alert('삭제 요청 중 오류가 발생했습니다: ' + err.message);
    }
  }

  // 페이지당 표시 개수(limit) 변경 처리
  function changeLimit(newLimit) {
    const url = new URL(window.location.href);
    url.searchParams.set('limit', newLimit);
    url.searchParams.set('page', '1');
    window.location.href = url.pathname + url.search;
  }

  // 전체 회원 데이터 비우기 (TRUNCATE)
  const btnClearAll = document.getElementById('btnClearAllUsers');
  if (btnClearAll) {
    btnClearAll.addEventListener('click', async () => {
      const confirmation = prompt('경고: 모든 회원 데이터가 영구히 삭제되고 1번부터 초기화됩니다.\n진행하시려면 아래 입력창에 "초기화" 라고 정확히 입력해 주세요:');
      if (confirmation !== '초기화') {
        if (confirmation !== null) alert('입력값이 일치하지 않아 취소되었습니다.');
        return;
      }

      try {
        const res = await fetch('/api/users/clear-all', { method: 'POST' });
        const result = await res.json();
        if (result.success) {
          alert(result.message);
          location.reload();
        } else {
          alert('초기화 실패: ' + result.message);
        }
      } catch (err) {
        alert('초기화 요청 중 오류가 발생했습니다: ' + err.message);
      }
    });
  }

  // 엑셀 업로드 타입 라디오 전환 (회원 vs 개통)
  const typeUserRadio = document.getElementById('typeUser');
  const typeActivationRadio = document.getElementById('typeActivation');
  const guideBoxUser = document.getElementById('guideBoxUser');
  const guideBoxActivation = document.getElementById('guideBoxActivation');

  if (typeUserRadio && typeActivationRadio) {
    typeUserRadio.addEventListener('change', () => {
      guideBoxUser.classList.remove('d-none');
      guideBoxActivation.classList.add('d-none');
    });
    typeActivationRadio.addEventListener('change', () => {
      guideBoxUser.classList.add('d-none');
      guideBoxActivation.classList.remove('d-none');
    });
  }

  // 엑셀 업로드 폼 비동기 전송
  document.getElementById('excelUploadForm').addEventListener('submit', async (e) => {
    e.preventDefault();

    const fileInput = document.getElementById('excelFileInput');
    if (!fileInput.files || fileInput.files.length === 0) {
      alert('업로드할 엑셀 파일을 선택해 주세요.');
      return;
    }

    const isActivation = typeActivationRadio && typeActivationRadio.checked;
    const targetUrl = isActivation ? '/api/activations/upload-excel' : '/api/users/upload-excel';
    const redirectUrl = isActivation ? '/activations' : '/users';
    const targetName = isActivation ? '개통 이력 (activation_log)' : '회원 정보 (app_user)';

    const submitBtn = document.getElementById('uploadSubmitBtn');
    const closeBtn = document.getElementById('modalCloseBtn');
    const alertBox = document.getElementById('uploadStatusAlert');

    // UI 로딩 상태 전환
    submitBtn.disabled = true;
    closeBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> 처리 중...';

    alertBox.className = 'alert alert-info py-2 px-3 small mb-0';
    alertBox.innerHTML = `<i class="bi bi-hourglass-split me-1"></i> 엑셀 데이터를 파싱하고 MySQL [${targetName}]에 일괄 저장 중입니다. 잠시만 기다려 주세요...`;
    alertBox.classList.remove('d-none');

    const formData = new FormData(e.target);

    try {
      const res = await fetch(targetUrl, {
        method: 'POST',
        body: formData
      });

      const result = await res.json();

      if (result.success) {
        alertBox.className = 'alert alert-success py-2 px-3 small mb-0';
        alertBox.innerHTML = `<strong><i class="bi bi-check-circle-fill me-1"></i> 완료!</strong> ${result.message}`;
        setTimeout(() => {
          location.href = redirectUrl;
        }, 1200);
      } else if (result.formatMismatch) {
        renderFormatError(result);
        submitBtn.disabled = false;
        closeBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> 다시 시도';
      } else {
        alertBox.className = 'alert alert-danger py-2 px-3 small mb-0';
        alertBox.innerHTML = `<strong><i class="bi bi-exclamation-triangle-fill me-1"></i> 오류:</strong> ${result.message || '해당 과정에서 문제가 발생했습니다. 관리자에게 문의해 주세요.'}`;
        submitBtn.disabled = false;
        closeBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> 다시 시도';
      }
    } catch (err) {
      alertBox.className = 'alert alert-danger py-2 px-3 small mb-0';
      alertBox.innerHTML = `<strong><i class="bi bi-x-circle-fill me-1"></i> 오류:</strong> 해당 과정에서 문제가 발생했습니다. 관리자에게 문의해 주세요.`;
      submitBtn.disabled = false;
      closeBtn.disabled = false;
      submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> 다시 시도';
    }
  });

  // 엑셀 포맷 불일치 상세 진단 렌더러
  function renderFormatError(result) {
    const alertBox = document.getElementById('uploadStatusAlert');
    alertBox.className = 'alert alert-light border border-danger shadow-sm p-3 mb-0 rounded-3 text-start';

    // 컬럼 뱃지 리스트
    let detectedHeadersHtml = '';
    if (result.detectedHeaders && result.detectedHeaders.length > 0) {
      detectedHeadersHtml = `
        <div class="mt-2.5 pt-2 border-top">
          <div class="small fw-semibold text-secondary mb-1">
            <i class="bi bi-card-heading me-1 text-danger"></i>업로드한 파일에서 감지된 상단 컬럼:
          </div>
          <div class="d-flex flex-wrap gap-1" style="max-height: 80px; overflow-y: auto;">
            ${result.detectedHeaders.map(h => `<span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle font-monospace" style="font-size: 0.72rem;">${h}</span>`).join('')}
          </div>
        </div>
      `;
    }

    // 기대 컬럼 리스트
    let expectedColumnsHtml = '';
    if (result.expectedColumns && result.expectedColumns.length > 0) {
      expectedColumnsHtml = `
        <div class="mt-2 pt-2 border-top">
          <div class="small fw-semibold text-secondary mb-1">
            <i class="bi bi-check2-square me-1 text-success"></i>[${result.expectedName}] 정상 필요 규격:
          </div>
          <div class="d-flex flex-wrap gap-1">
            ${result.expectedColumns.slice(0, 8).map(c => `<span class="badge bg-success-subtle text-success-emphasis border border-success-subtle font-monospace" style="font-size: 0.72rem;">${c}</span>`).join('')}
            ${result.expectedColumns.length > 8 ? `<span class="badge bg-light text-muted border" style="font-size: 0.72rem;">+외 ${result.expectedColumns.length - 8}개</span>` : ''}
          </div>
        </div>
      `;
    }

    // 타입 즉시 전환 원클릭 버튼 (교차 감지 시)
    let switchButtonHtml = '';
    if (result.detectedType === 'ACTIVATION') {
      switchButtonHtml = `
        <div class="mt-3">
          <button type="button" class="btn btn-sm btn-outline-success w-100 fw-bold shadow-xs d-flex align-items-center justify-content-center gap-1 py-1.5" onclick="switchUploadMode('ACTIVATION')">
            <i class="bi bi-arrow-repeat fs-6"></i>
            <span>[개통 이력 (activation_log)] 모드로 즉시 전환하기</span>
          </button>
        </div>
      `;
    } else if (result.detectedType === 'USER') {
      switchButtonHtml = `
        <div class="mt-3">
          <button type="button" class="btn btn-sm btn-outline-primary w-100 fw-bold shadow-xs d-flex align-items-center justify-content-center gap-1 py-1.5" onclick="switchUploadMode('USER')">
            <i class="bi bi-arrow-repeat fs-6"></i>
            <span>[회원 정보 (app_user)] 모드로 즉시 전환하기</span>
          </button>
        </div>
      `;
    }

    alertBox.innerHTML = `
      <div class="d-flex align-items-start gap-2 text-danger mb-2">
        <i class="bi bi-exclamation-octagon-fill fs-4 flex-shrink-0 mt-0.5"></i>
        <div class="flex-grow-1 min-w-0">
          <div class="fw-bold fs-6">${result.title || '엑셀 파일 포맷 불일치'}</div>
          <div class="text-dark small fw-medium mt-0.5">${result.message}</div>
        </div>
      </div>

      <div class="alert alert-warning py-2 px-2.5 small mb-2 d-flex align-items-center gap-2 rounded-2">
        <i class="bi bi-lightbulb-fill text-warning flex-shrink-0"></i>
        <div class="text-secondary-emphasis" style="font-size: 0.8rem;">
          ${result.suggestion || '선택한 업로드 대상과 일치하는 올바른 엑셀 양식을 업로드해 주세요.'}
        </div>
      </div>

      <!-- 감지 형식 vs 필요 규격 -->
      <div class="row g-2 mb-1">
        <div class="col-6">
          <div class="p-2 rounded bg-light border">
            <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-file-earmark-break text-danger me-1"></i>업로드한 파일 감지</div>
            <div class="fw-bold text-dark small text-truncate" title="${result.detectedName || ''}">${result.detectedName || '규격 미일치'}</div>
          </div>
        </div>
        <div class="col-6">
          <div class="p-2 rounded bg-light border">
            <div class="text-muted" style="font-size: 0.7rem;"><i class="bi bi-check2-circle text-success me-1"></i>현재 선택된 규격</div>
            <div class="fw-bold text-primary small text-truncate" title="${result.expectedName || ''}">${result.expectedName || ''}</div>
          </div>
        </div>
      </div>

      ${detectedHeadersHtml}
      ${expectedColumnsHtml}
      ${switchButtonHtml}
    `;
    alertBox.classList.remove('d-none');
  }

  // 모드 즉시 전환 함수
  function switchUploadMode(targetMode) {
    const typeUserRadio = document.getElementById('typeUser');
    const typeActivationRadio = document.getElementById('typeActivation');
    const guideBoxUser = document.getElementById('guideBoxUser');
    const guideBoxActivation = document.getElementById('guideBoxActivation');

    if (targetMode === 'ACTIVATION') {
      if (typeActivationRadio) typeActivationRadio.checked = true;
      if (guideBoxUser) guideBoxUser.classList.add('d-none');
      if (guideBoxActivation) guideBoxActivation.classList.remove('d-none');
    } else {
      if (typeUserRadio) typeUserRadio.checked = true;
      if (guideBoxUser) guideBoxUser.classList.remove('d-none');
      if (guideBoxActivation) guideBoxActivation.classList.add('d-none');
    }

    const alertBox = document.getElementById('uploadStatusAlert');
    alertBox.className = 'alert alert-info py-2 px-3 small mb-0 text-start';
    alertBox.innerHTML = `<i class="bi bi-info-circle-fill me-1"></i> [${targetMode === 'ACTIVATION' ? '개통 이력' : '회원 정보'}] 모드로 전환되었습니다. 아래 <strong>[업로드 및 일괄 저장]</strong> 버튼을 다시 클릭해 주세요.`;
  }
</script>

<%- include('partials/footer') %>

