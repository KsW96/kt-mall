<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
        <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi <%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_icon) ? currentMenu.menu_icon : 'bi-clock-history' %> text-primary"></i>
          <span><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : '메세지 발송 이력' %></span>
        </h1>
        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1">
          <i class="bi bi-database-check me-1"></i>실시간 발송 로그 연동됨
        </span>
      </div>
      <p class="text-muted small mb-0">Aligo SMS/LMS 및 알림톡의 고객 발송 이력, 성공·실패 결과 및 통신사 전송 상태를 실시간 조회합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <a href="/notifications/sms" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm">
        <i class="bi bi-send-fill"></i>
        <span>문자 발송 화면으로</span>
      </a>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> 새로고침
      </button>
    </div>
  </div>

  <!-- Notification Live Status Banner -->
  <div class="alert alert-info bg-info-subtle border-0 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 py-2.5 px-3 mb-3 rounded-3 text-dark">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-check-circle-fill text-info-emphasis fs-5 flex-shrink-0"></i>
      <div class="small">
        <strong>[Aligo 발송 로그 연동 안내]</strong> 단일 테스트 및 스케줄 발송 건의 성공/실패 결과가 발송 이력 데이터베이스에 실시간으로 기록됩니다. 행 우측의 상세 아이콘을 클릭하여 전문을 확인하실 수 있습니다.
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-white text-dark border px-2 py-1 small">
        <i class="bi bi-clock-history text-info me-1"></i>실시간 동기화
      </span>
    </div>
  </div>

  <!-- Summary Metric Cards -->
  <div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-send-check fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">당월 총 발송 건수</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.totalCount.toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-info-subtle text-info me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-calendar-check fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">금일 발송</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.todayCount.toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-check2-circle fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">발송 성공 건수</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.successCount.toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-danger-subtle text-danger me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-exclamation-triangle fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">발송 실패 (실패율)</div>
            <div class="fs-4 fw-bold text-danger mb-0 mt-1"><%= stats.failCount %><span class="fs-6 fw-normal text-muted ms-1">건 (성공률 <%= stats.successRate %>)</span></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search and Filter Form (조회 폼) -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-header bg-white border-0 pt-3 pb-2">
      <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
        <i class="bi bi-funnel-fill text-primary"></i>
        <span>메세지 발송 이력 상세 조회</span>
      </h5>
    </div>
    <div class="card-body pt-1 pb-3 px-3">
      <form method="GET" action="/notifications/history" id="filterForm">
        <!-- 1행: 발송 채널, 발송 상태, 키워드 검색창 -->
        <div class="row g-2 align-items-center mb-2">
          <div class="col-md-3 col-lg-2">
            <select class="form-select form-select-sm" name="msgType">
              <option value="">발송 채널 전체</option>
              <option value="SMS" <%= filters.msgType === 'SMS' ? 'selected' : '' %>>문자 (SMS 단문)</option>
              <option value="LMS" <%= filters.msgType === 'LMS' ? 'selected' : '' %>>문자 (LMS 장문)</option>
              <option value="ALIMTALK" <%= filters.msgType === 'ALIMTALK' ? 'selected' : '' %>>카카오 알림톡</option>
            </select>
          </div>
          <div class="col-md-3 col-lg-2">
            <select class="form-select form-select-sm" name="status">
              <option value="">발송 상태 전체</option>
              <option value="SUCCESS" <%= filters.status === 'SUCCESS' ? 'selected' : '' %>>발송 성공</option>
              <option value="FAIL" <%= filters.status === 'FAIL' ? 'selected' : '' %>>발송 실패</option>
            </select>
          </div>
          <div class="col-md-6 col-lg-8">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
              <input type="text" class="form-control" name="keyword" placeholder="고객명, 휴대폰번호, 본문 키워드 검색..." value="<%= filters.keyword || '' %>">
              <button class="btn btn-dark px-3" type="submit">
                검색
              </button>
            </div>
          </div>
        </div>

        <!-- 2행: 발송 기간 선택 및 바로가기 필터 버튼, 초기화 -->
        <div class="row g-2 align-items-center">
          <div class="col-md-6 col-lg-5">
            <div class="input-group input-group-sm">
              <span class="input-group-text bg-light text-muted fw-medium">발송일</span>
              <input type="date" class="form-control" name="startDate" id="startDateInput" value="<%= filters.startDate || '' %>">
              <span class="input-group-text bg-light text-muted">~</span>
              <input type="date" class="form-control" name="endDate" id="endDateInput" value="<%= filters.endDate || '' %>">
            </div>
          </div>
          <div class="col-md-6 col-lg-7 d-flex justify-content-md-end align-items-center gap-2 flex-wrap">
            <div class="btn-group btn-group-sm" role="group">
              <button type="button" class="btn btn-outline-secondary" onclick="setDateRange('today')">오늘</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setDateRange('7days')">최근 7일</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setDateRange('1month')">1개월</button>
              <button type="button" class="btn btn-outline-secondary" onclick="setDateRange('3months')">3개월</button>
              <button type="button" class="btn btn-outline-secondary" onclick="clearDateRange()">전체</button>
            </div>
            <a href="/notifications/history" class="btn btn-sm btn-outline-secondary" title="검색 조건 초기화">
              <i class="bi bi-arrow-counterclockwise"></i> 초기화
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- History Table Card -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
          <i class="bi bi-list-columns-reverse text-primary"></i>
          <span>메세지 발송 내역 목록</span>
          <span class="badge bg-secondary-subtle text-dark ms-1"><%= historyList.length %>건</span>
        </h5>
        <small class="text-muted">실제 통신사 전송 로그 및 카카오 비즈메시지 수신 결과 상세를 확인합니다.</small>
      </div>
      <div>
        <span class="badge bg-light text-secondary border">
          <i class="bi bi-info-circle me-1"></i>최근 발송 순서로 정렬됨
        </span>
      </div>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 user-table no-scroll-table">
          <colgroup>
            <col style="width: 5%;">
            <col style="width: 10%;">
            <col style="width: 9%;">
            <col style="width: 12%;">
            <col style="width: 32%;">
            <col style="width: 14%;">
            <col style="width: 10%;">
            <col style="width: 8%;">
          </colgroup>
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-center">No</th>
              <th scope="col" class="text-center">발송 채널</th>
              <th scope="col" class="text-center">수신자</th>
              <th scope="col" class="text-center">수신 번호</th>
              <th scope="col" class="text-start">발송 제목 / 메시지 내용 요약</th>
              <th scope="col" class="text-center">발송 일시</th>
              <th scope="col" class="text-center">발송 결과</th>
              <th scope="col" class="text-center">상세</th>
            </tr>
          </thead>
          <tbody>
            <% if (historyList && historyList.length > 0) { %>
              <% historyList.forEach((item, idx) => { %>
                <tr>
                  <!-- 1. No -->
                  <td class="text-center text-muted small"><%= idx + 1 %></td>

                  <!-- 2. 발송 채널 -->
                  <td class="text-center">
                    <% if (item.msg_type === 'ALIMTALK') { %>
                      <span class="badge text-dark border px-2 py-1" style="background-color: #FEE500; border-color: #ebd100 !important; font-size: 0.72rem;">
                        <i class="bi bi-chat-quote-fill me-1"></i>알림톡
                      </span>
                    <% } else if (item.msg_type === 'LMS') { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1" style="font-size: 0.72rem;">
                        <i class="bi bi-chat-text-fill me-1"></i>LMS
                      </span>
                    <% } else { %>
                      <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2 py-1" style="font-size: 0.72rem;">
                        <i class="bi bi-chat-dots-fill me-1"></i>SMS
                      </span>
                    <% } %>
                  </td>

                  <!-- 3. 수신자명 -->
                  <td class="text-center fw-semibold text-dark"><%= item.receiver_name %></td>

                  <!-- 4. 수신번호 -->
                  <td class="text-center font-monospace small"><%= item.receiver_phone %></td>

                  <!-- 5. 메시지 내용 요약 -->
                  <td class="text-start">
                    <% if (item.title && item.title !== '-') { %>
                      <strong class="text-dark small d-block text-truncate" style="max-width: 270px;"><%= item.title %></strong>
                    <% } %>
                    <span class="text-muted small text-truncate d-block" style="max-width: 270px;"><%= item.content.replace(/\n/g, ' ') %></span>
                  </td>

                  <!-- 6. 발송 일시 -->
                  <td class="text-center font-monospace small text-muted"><%= item.sent_dt %></td>

                  <!-- 7. 발송 결과 -->
                  <td class="text-center">
                    <% if (item.status === 'SUCCESS') { %>
                      <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                        <i class="bi bi-check-circle-fill me-1"></i>성공
                      </span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1" data-bs-toggle="tooltip" title="<%= item.result_code %>">
                        <i class="bi bi-x-circle-fill me-1"></i>실패
                      </span>
                    <% } %>
                  </td>

                  <!-- 8. 상세 보기 버튼 -->
                  <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" title="발송 원문 상세 보기" onclick='openDetailModal(<%- JSON.stringify(item) %>)'>
                      <i class="bi bi-search"></i>
                    </button>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">
                  검색 조건과 일치하는 메세지 발송 이력이 없습니다.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- ======================================================== -->
<!-- MODAL: 메세지 발송 원문 상세 보기 모달                    -->
<!-- ======================================================== -->
<div class="modal fade" id="modalHistoryDetail" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold fs-6" id="detailModalTitle">
          <i class="bi bi-envelope-paper text-primary me-1"></i> 발송 상세 내역
        </h5>
        <span class="unimplemented-badge ms-2" data-bs-toggle="tooltip" title="현재 화면은 UI 프리뷰입니다.">미구현 (UI 프리뷰)</span>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <!-- 메타 정보 카드 -->
        <div class="card border bg-light mb-3">
          <div class="card-body p-3">
            <div class="row g-2 small">
              <div class="col-6">
                <span class="text-secondary">수신 고객:</span>
                <strong id="detailReceiverName" class="text-dark ms-1">-</strong>
              </div>
              <div class="col-6">
                <span class="text-secondary">수신 번호:</span>
                <span id="detailReceiverPhone" class="font-monospace text-dark ms-1">-</span>
              </div>
              <div class="col-6">
                <span class="text-secondary">발송 채널:</span>
                <span id="detailChannelName" class="ms-1">-</span>
              </div>
              <div class="col-6">
                <span class="text-secondary">통신사:</span>
                <span id="detailCarrier" class="ms-1 text-dark fw-semibold">-</span>
              </div>
              <div class="col-12">
                <span class="text-secondary">발송 일시:</span>
                <span id="detailSentDt" class="font-monospace ms-1 text-dark">-</span>
              </div>
              <div class="col-12">
                <span class="text-secondary">전송 결과:</span>
                <span id="detailResultCode" class="ms-1 font-monospace">-</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 메시지 원문 박스 -->
        <div class="mb-2">
          <label class="form-label small fw-semibold text-secondary">발송 원문 내용</label>
          <div class="p-3 bg-white border rounded-3 text-start small font-monospace" style="white-space: pre-wrap; max-height: 250px; overflow-y: auto; line-height: 1.5;" id="detailContentBox">
          </div>
        </div>
      </div>
      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">닫기</button>
      </div>
    </div>
  </div>
</div>

<script>
  // 빠른 날짜 범위 설정 헬퍼
  function setDateRange(range) {
    const end = new Date();
    const start = new Date();

    if (range === 'today') {
      // 오늘
    } else if (range === '7days') {
      start.setDate(end.getDate() - 7);
    } else if (range === '1month') {
      start.setMonth(end.getMonth() - 1);
    } else if (range === '3months') {
      start.setMonth(end.getMonth() - 3);
    }

    const formatDate = (d) => {
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    document.getElementById('startDateInput').value = formatDate(start);
    document.getElementById('endDateInput').value = formatDate(end);
  }

  function clearDateRange() {
    document.getElementById('startDateInput').value = '';
    document.getElementById('endDateInput').value = '';
  }

  // 발송 상세 보기 모달 오픈
  function openDetailModal(item) {
    document.getElementById('detailReceiverName').textContent = item.receiver_name;
    document.getElementById('detailReceiverPhone').textContent = item.receiver_phone;
    document.getElementById('detailChannelName').textContent = item.channel_name;
    document.getElementById('detailCarrier').textContent = item.carrier || '-';
    document.getElementById('detailSentDt').textContent = item.sent_dt;
    
    const resEl = document.getElementById('detailResultCode');
    if (item.status === 'SUCCESS') {
      resEl.className = 'text-success fw-bold ms-1';
      resEl.textContent = item.result_code;
    } else {
      resEl.className = 'text-danger fw-bold ms-1';
      resEl.textContent = item.result_code;
    }

    let fullText = '';
    if (item.title && item.title !== '-') {
      fullText += `[제목: ${item.title}]\n\n`;
    }
    fullText += item.content;
    document.getElementById('detailContentBox').textContent = fullText;

    const modalEl = document.getElementById('modalHistoryDetail');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }
</script>

<%- include('partials/footer') %>

