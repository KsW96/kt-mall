<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
        <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi <%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_icon) ? currentMenu.menu_icon : 'bi-chat-quote-fill' %>" style="color: #FEE500; text-shadow: 0 0 2px #3c1e1e;"></i>
          <span><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : '알림톡 관리' %></span>
        </h1>
        <span class="badge bg-secondary-subtle text-secondary border border-secondary px-2.5 py-1" data-bs-toggle="tooltip" data-bs-placement="bottom" title="화면 설계 프로토타입 단계이며, 실제 카카오 알림톡 발송 기능은 연동 준비 중입니다.">
          <i class="bi bi-cone-striped me-1 text-warning"></i>미구현 (UI 프로토타입)
        </span>
      </div>
      <p class="text-muted small mb-0">카카오 승인 템플릿 및 고객 개통일자 기준 정기 자동 발송 규칙을 설정하고 관리합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <button type="button" class="btn btn-sm btn-outline-dark d-flex align-items-center gap-1 shadow-sm unimplemented-btn" data-bs-toggle="tooltip" data-bs-placement="bottom" title="기능 준비 중 (미구현)" onclick="openTestSendModal()">
        <i class="bi bi-send-fill text-warning"></i>
        <span>알림톡 테스트 발송</span>
      </button>
      <button type="button" class="btn btn-sm text-dark fw-bold d-flex align-items-center gap-1 shadow-sm unimplemented-btn" style="background-color: #FEE500; border-color: #ebd100;" data-bs-toggle="tooltip" data-bs-placement="bottom" title="기능 준비 중 (미구현)" onclick="openTemplateModal()">
        <i class="bi bi-plus-circle-fill"></i>
        <span>신규 알림톡 등록</span>
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> 새로고침
      </button>
    </div>
  </div>

  <!-- Unimplemented Feature Notice Banner -->
  <div class="alert alert-warning bg-warning-subtle border-0 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 py-2.5 px-3 mb-3 rounded-3 text-dark unimplemented-notice-banner">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-exclamation-triangle-fill text-warning fs-5 flex-shrink-0"></i>
      <div class="small">
        <strong>[화면 설계 프로토타입 안내]</strong> 본 화면은 카카오 알림톡 템플릿·발송 주기·조건 설정을 위한 UI 화면 구성 단계입니다. 실제 카카오 비즈메시지 API 연동 및 발송 기능은 <strong>준비 중 (미구현)</strong>입니다.
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-white text-dark border px-2 py-1 small" data-bs-toggle="tooltip" title="현재 기능 미구현 상태">
        <i class="bi bi-tools text-warning me-1"></i>기능 준비 중 (UI 프로토타입)
      </span>
    </div>
  </div>

  <!-- Summary Metric Cards -->
  <div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 50px; height: 50px; background-color: #FFFDEB; color: #3c1e1e; border: 1px solid #FEE500;">
            <i class="bi bi-chat-square-quote fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">승인 템플릿</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.totalTemplates %><span class="fs-6 fw-normal text-muted ms-1">개</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-check2-circle fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">활성 발송 규칙</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.activeTemplates %><span class="fs-6 fw-normal text-muted ms-1">건 (사용중)</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-send-check fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">당월 알림톡 발송</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.monthlySent.toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning-subtle text-warning me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-graph-up-arrow fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">도달 성공률</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.successRate %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
      <div class="row g-2 align-items-center">
        <div class="col-md-3">
          <select class="form-select form-select-sm" id="filterStatus">
            <option value="">상태 전체 (USE / HIDE)</option>
            <option value="Y">USE (발송 활성)</option>
            <option value="N">HIDE (발송 중지)</option>
          </select>
        </div>
        <div class="col-md-3">
          <select class="form-select form-select-sm" id="filterCondition">
            <option value="">발송 조건 전체 (개통일 기준)</option>
            <option value="D_DAY">개통 당일 (D-Day)</option>
            <option value="AFTER_D">개통 후 N일차 (D+)</option>
          </select>
        </div>
        <div class="col-md-6">
          <div class="input-group input-group-sm">
            <input type="text" class="form-control" placeholder="카카오 템플릿 코드, 명칭 검색...">
            <button class="btn btn-dark" type="button">
              <i class="bi bi-search me-1"></i>검색
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 알림톡 템플릿 관리 구조 테이블 (Template List) -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
          <i class="bi bi-list-check text-primary"></i>
          <span>카카오 알림톡 템플릿 및 자동 발송 규칙</span>
          <span class="badge bg-secondary-subtle text-dark ms-1"><%= templates.length %>건</span>
        </h5>
        <small class="text-muted">카카오 심사 승인이 완료된 템플릿에 한해 개통 조건 매칭 시 알림톡이 자동 발송됩니다.</small>
      </div>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 user-table no-scroll-table">
          <colgroup>
            <col style="width: 5%;">
            <col style="width: 9%;">
            <col style="width: 21%;">
            <col style="width: 18%;">
            <col style="width: 15%;">
            <col style="width: 13%;">
            <col style="width: 8%;">
            <col style="width: 11%;">
          </colgroup>
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-center">No</th>
              <th scope="col" class="text-center">카카오 승인</th>
              <th scope="col" class="text-start">템플릿명 (코드)</th>
              <th scope="col" class="text-start">발송 조건 (개통일 기준)</th>
              <th scope="col" class="text-start">발송 주기 및 시간</th>
              <th scope="col" class="text-start">링크 버튼</th>
              <th scope="col" class="text-center">상태</th>
              <th scope="col" class="text-center">관리</th>
            </tr>
          </thead>
          <tbody>
            <% if (templates && templates.length > 0) { %>
              <% templates.forEach((t, idx) => { %>
                <tr>
                  <td class="text-center text-muted small"><%= idx + 1 %></td>
                  <td class="text-center">
                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                      <i class="bi bi-check-circle-fill me-1"></i><%= t.kakao_status %>
                    </span>
                  </td>
                  <td class="text-start">
                    <strong class="text-dark d-block"><%= t.template_name %></strong>
                    <code class="text-muted small"><%= t.kakao_code %></code>
                  </td>
                  <td class="text-start">
                    <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 mb-1">
                      <i class="bi bi-calendar-event text-primary"></i>
                      <span><%= t.condition_desc %></span>
                    </span>
                    <div class="small text-muted" style="font-size: 0.75rem;">대상: <%= t.target_category %></div>
                  </td>
                  <td class="text-start">
                    <div class="fw-semibold text-dark small"><i class="bi bi-clock me-1 text-secondary"></i><%= t.send_time %></div>
                    <div class="small text-muted" style="font-size: 0.75rem;"><%= t.send_cycle_desc %></div>
                  </td>
                  <td class="text-start">
                    <% (t.buttons || []).forEach(b => { %>
                      <span class="badge bg-light text-dark border d-block mb-1" style="font-size: 0.7rem;">
                        <i class="bi bi-box-arrow-up-right text-primary me-1"></i><%= b.name %>
                      </span>
                    <% }); %>
                  </td>
                  <td class="text-center">
                    <% if (t.use_yn === 'Y') { %>
                      <button type="button" class="btn btn-sm btn-success px-3 py-1 fw-bold shadow-xs unimplemented-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="mockToggleStatus(this, '<%= t.template_name %>')">
                        <i class="bi bi-check-circle-fill me-1"></i>USE
                      </button>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-danger px-3 py-1 fw-bold shadow-xs unimplemented-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="mockToggleStatus(this, '<%= t.template_name %>')">
                        <i class="bi bi-eye-slash-fill me-1"></i>HIDE
                      </button>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <div class="btn-group btn-group-sm">
                      <button type="button" class="btn btn-outline-dark py-0 px-2 unimplemented-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="openTestSendModalWithData(<%= JSON.stringify(t) %>)">
                        <i class="bi bi-send text-warning"></i>
                      </button>
                      <button type="button" class="btn btn-outline-secondary py-0 px-2 unimplemented-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="editTemplate(<%= JSON.stringify(t) %>)">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                      <button type="button" class="btn btn-outline-danger py-0 px-2 unimplemented-btn" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="mockDeleteTemplate('<%= t.template_name %>')">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">등록된 알림톡 템플릿이 없습니다.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- ======================================================== -->
<!-- MODAL 1: 알림톡 템플릿 설정 및 등록/수정 모달              -->
<!-- ======================================================== -->
<div class="modal fade" id="modalTemplate" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow">
      <div class="modal-header" style="background-color: #FFFDEB;">
        <h5 class="modal-title fw-bold fs-6 text-dark" id="modalTemplateTitle">
          <i class="bi bi-chat-quote-fill text-warning me-1"></i> 카카오 알림톡 템플릿 설정
        </h5>
        <span class="unimplemented-badge ms-2" data-bs-toggle="tooltip" title="현재 화면은 UI 프리뷰입니다.">미구현 (UI 프리뷰)</span>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="formTemplate">
          <!-- 1. 기본 템플릿 정보 & 카카오 승인 정보 -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                <i class="bi bi-patch-check-fill text-warning"></i> 1. 카카오 비즈메시지 승인 정보
              </h6>
              <div class="row g-2 mb-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">카카오 템플릿 코드 <span class="text-danger">*</span></label>
                  <input type="text" class="form-control form-control-sm font-monospace text-uppercase" id="tplKakaoCode" value="KT_ALIM_2026_01" placeholder="예: KT_ALIM_01">
                </div>
                <div class="col-md-5">
                  <label class="form-label small fw-semibold text-secondary">템플릿 명칭 <span class="text-danger">*</span></label>
                  <input type="text" class="form-control form-control-sm" id="tplName" value="[알림톡] 개통 완료 및 계약 상세 안내">
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold text-secondary">검수 승인 상태</label>
                  <select class="form-select form-select-sm" id="tplKakaoStatus">
                    <option value="승인완료" selected>승인완료</option>
                    <option value="검수대기">검수대기</option>
                    <option value="반려">반려</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. 발송 조건 설정 (개통일자 기준) -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                <i class="bi bi-calendar-check-fill text-success"></i> 2. 발송 조건 설정 (개통일자 기준)
              </h6>
              <div class="row g-2 mb-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">기준 일자</label>
                  <select class="form-select form-select-sm" id="tplConditionBase">
                    <option value="opening_dt" selected>고객 개통일자 기준</option>
                    <option value="join_dt">회원 가입일자 기준</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">조건 시점</label>
                  <select class="form-select form-select-sm" id="tplConditionType">
                    <option value="D_DAY" selected>기준일 당일 (D-Day 즉시)</option>
                    <option value="AFTER_D">기준일로부터 N일 후 (D+)</option>
                    <option value="BEFORE_D">기준일로부터 N일 전 (D-)</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">일수</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" id="tplConditionDays" value="0" min="0">
                    <span class="input-group-text">일차</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 3. 발송 주기 설정 (Schedule) -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                <i class="bi bi-clock-history text-primary"></i> 3. 발송 주기 설정 (Schedule)
              </h6>
              <div class="row g-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">발송 주기 방식</label>
                  <select class="form-select form-select-sm" id="tplCycle">
                    <option value="REALTIME" selected>조건 충족 시 실시간 즉시 발송</option>
                    <option value="DAILY">매일 정기 자동 발송</option>
                    <option value="WEEKLY">매주 특정 요일 발송</option>
                    <option value="MONTHLY">매월 특정 일자 발송</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">발송 희망 시간</label>
                  <input type="time" class="form-control form-control-sm" id="tplSendTime" value="10:00">
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">표출 상태</label>
                  <select class="form-select form-select-sm" id="tplUseYn">
                    <option value="Y" selected>USE (규칙 활성화)</option>
                    <option value="N">HIDE (발송 중지)</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. 템플릿 본문 및 버튼 링크 설정 -->
          <div class="card border bg-white mb-2">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-1">
                  <i class="bi bi-chat-square-text-fill text-warning"></i> 4. 알림톡 본문 및 버튼 링크
                </h6>
              </div>

              <!-- 치환 변수 삽입 버튼 툴바 -->
              <div class="mb-2 p-2 bg-light rounded border">
                <div class="small fw-semibold text-secondary mb-1">
                  <i class="bi bi-code-slash me-1"></i>치환 변수 태그 (클릭 시 자동 삽입):
                </div>
                <div class="d-flex flex-wrap gap-1">
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{고객명}')">+#{고객명}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{개통번호}')">+#{개통번호}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{단말기명}')">+#{단말기명}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{개통일자}')">+#{개통일자}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{할부원금}')">+#{할부원금}</button>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label small fw-semibold text-secondary">알림톡 본문 내용 <span class="text-danger">*</span></label>
                <textarea class="form-control form-control-sm font-monospace" id="tplContentInput" rows="6">#{고객명} 고객님, KT몰에서 개통이 성공적으로 완료되었습니다.

■ 개통 상세 내역
- 고객명: #{고객명}
- 개통번호: #{개통번호}
- 단말기명: #{단말기명}
- 개통일시: #{개통일자}
- 최종할부원금: #{할부원금}원

자세한 전자계약서는 아래 버튼을 통해 확인하실 수 있습니다.</textarea>
              </div>

              <!-- 알림톡 링크 버튼 설정 -->
              <div class="p-2 border rounded bg-light">
                <div class="small fw-semibold text-secondary mb-2">알림톡 하단 링크 버튼 설정 (최대 2개)</div>
                <div class="row g-2 mb-2">
                  <div class="col-4">
                    <input type="text" class="form-control form-control-sm" placeholder="버튼 1 명칭" value="전자계약서 조회">
                  </div>
                  <div class="col-8">
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="https://..." value="https://m.kt.com">
                  </div>
                </div>
                <div class="row g-2">
                  <div class="col-4">
                    <input type="text" class="form-control form-control-sm" placeholder="버튼 2 명칭 (선택)" value="고객센터 연결">
                  </div>
                  <div class="col-8">
                    <input type="text" class="form-control form-control-sm font-monospace" placeholder="앱 스킴 또는 URL" value="ktmall://cs">
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">닫기</button>
        <button type="button" class="btn btn-sm text-dark fw-bold px-3 unimplemented-btn" style="background-color: #FEE500; border-color: #ebd100;" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="mockSaveTemplate()">
          <i class="bi bi-check-lg me-1"></i>저장하기 (미구현 데모)
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: 5. 알림톡 테스트 발송 및 카카오톡 스마트폰 목업     -->
<!-- ======================================================== -->
<div class="modal fade" id="modalTestSend" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header" style="background-color: #FFFDEB;">
        <h5 class="modal-title fw-bold fs-6 text-dark">
          <i class="bi bi-chat-quote-fill text-warning me-1"></i> 5. 카카오 알림톡 테스트 발송 및 미리보기
        </h5>
        <span class="unimplemented-badge ms-2" data-bs-toggle="tooltip" title="현재 화면은 UI 프리뷰입니다.">미구현 (UI 프리뷰)</span>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="row g-4">
          <!-- 좌측: 테스트 발송 파라미터 입력 영역 -->
          <div class="col-lg-6 border-end">
            <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
              <i class="bi bi-send text-primary"></i>
              <span>테스트 수신자 및 치환 변수 매핑</span>
            </h6>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">발송할 알림톡 템플릿</label>
              <select class="form-select form-select-sm" id="testTplSelect" onchange="onSelectTestTemplate(this.value)">
                <% templates.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.template_name %> (<%= t.kakao_code %>)</option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">테스트 수신 번호 (카카오톡 계정) <span class="text-danger">*</span></label>
              <input type="text" class="form-control form-control-sm font-monospace" id="testPhoneInput" value="010-9876-5432" placeholder="010-0000-0000">
              <div class="form-text small">해당 번호의 카카오톡으로 알림톡 수신 말풍선 포맷을 검증합니다.</div>
            </div>

            <div class="card border bg-light mb-3">
              <div class="card-body p-3">
                <span class="badge bg-secondary-subtle text-dark border mb-2 font-monospace">치환 변수 샘플 값 매핑</span>
                <div class="row g-2">
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{고객명}</label>
                    <input type="text" class="form-control form-control-sm" id="sampleName" value="홍길동" oninput="updatePreviewKakao()">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{단말기명}</label>
                    <input type="text" class="form-control form-control-sm" id="sampleModel" value="갤럭시 S25 Ultra" oninput="updatePreviewKakao()">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{개통일자}</label>
                    <input type="date" class="form-control form-control-sm" id="sampleDate" value="2026-11-06" oninput="updatePreviewKakao()">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{할부원금}</label>
                    <input type="text" class="form-control form-control-sm" id="samplePrincipal" value="850,000" oninput="updatePreviewKakao()">
                  </div>
                </div>
              </div>
            </div>

            <div class="d-grid">
              <button type="button" class="btn text-dark fw-bold py-2 shadow-sm unimplemented-btn" style="background-color: #FEE500; border-color: #ebd100;" data-bs-toggle="tooltip" data-bs-placement="top" title="기능 준비 중 (미구현)" onclick="mockSendTestKakao()">
                <i class="bi bi-chat-quote-fill me-1"></i>테스트 알림톡 즉시 발송하기 (미구현 데모)
              </button>
            </div>
            <div id="testSendAlert" class="alert alert-success mt-3 py-2 px-3 small d-none"></div>
          </div>

          <!-- 우측: 카카오톡 스마트폰 디바이스 목업 (Kakao UI 렌더링) -->
          <div class="col-lg-6 d-flex justify-content-center">
            <div class="phone-mockup shadow-lg rounded-4 p-3 border border-3 border-dark bg-dark" style="width: 320px; min-height: 480px;">
              <!-- Phone Notch -->
              <div class="d-flex justify-content-center mb-2">
                <div class="bg-secondary rounded-pill" style="width: 70px; height: 6px;"></div>
              </div>

              <!-- Kakao Screen Content -->
              <div class="rounded-3 p-2 d-flex flex-column" style="min-height: 440px; background-color: #ABC1D1;">
                <!-- Kakao Channel Header -->
                <div class="d-flex align-items-center gap-2 px-2 py-1 mb-2 bg-white rounded shadow-xs">
                  <div class="rounded-circle d-flex align-items-center justify-content-center text-dark fw-bold" style="width: 28px; height: 28px; background-color: #FEE500; font-size: 0.75rem;">
                    KT
                  </div>
                  <div class="small fw-bold text-dark">KT몰 알림톡</div>
                  <span class="badge bg-secondary-subtle text-secondary ms-auto" style="font-size: 0.6rem;">인증채널</span>
                </div>

                <!-- Kakao Message Bubble -->
                <div class="bg-white p-3 rounded-3 shadow-xs text-start mb-2" style="font-size: 0.78rem; line-height: 1.45; white-space: pre-wrap;" id="kakaoMessageBubble">
홍길동 고객님, KT몰에서 개통이 성공적으로 완료되었습니다.

■ 개통 상세 내역
- 고객명: 홍길동
- 개통번호: 010-9876-5432
- 단말기명: 갤럭시 S25 Ultra
- 개통일시: 2026-11-06
- 최종할부원금: 850,000원

자세한 전자계약서는 아래 버튼을 통해 확인하실 수 있습니다.
                </div>

                <!-- Kakao Action Buttons inside bubble -->
                <div class="d-grid gap-1 mb-2" id="kakaoButtonsBox">
                  <button type="button" class="btn btn-sm btn-light border fw-semibold py-1" style="font-size: 0.75rem;">
                    전자계약서 조회
                  </button>
                  <button type="button" class="btn btn-sm btn-light border fw-semibold py-1" style="font-size: 0.75rem;">
                    고객센터 연결
                  </button>
                </div>

                <div class="mt-auto text-center">
                  <span class="badge bg-light text-secondary border" style="font-size: 0.65rem;">
                    <i class="bi bi-shield-check text-success me-1"></i>카카오 비즈메시지 승인 규격
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const templateList = <%- JSON.stringify(templates) %>;

  function insertVariable(v) {
    const area = document.getElementById('tplContentInput');
    const start = area.selectionStart;
    const end = area.selectionEnd;
    const text = area.value;
    area.value = text.substring(0, start) + v + text.substring(end);
    area.focus();
    area.selectionStart = area.selectionEnd = start + v.length;
  }

  function openTemplateModal() {
    document.getElementById('formTemplate').reset();
    document.getElementById('modalTemplateTitle').innerHTML = '<i class="bi bi-chat-quote-fill text-warning me-1"></i> 신규 카카오 알림톡 등록';
    const modalEl = document.getElementById('modalTemplate');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function editTemplate(t) {
    document.getElementById('modalTemplateTitle').innerHTML = '<i class="bi bi-pencil-square text-warning me-1"></i> 알림톡 수정: ' + t.template_name;
    document.getElementById('tplKakaoCode').value = t.kakao_code;
    document.getElementById('tplName').value = t.template_name;
    document.getElementById('tplKakaoStatus').value = t.kakao_status;
    document.getElementById('tplContentInput').value = t.content;
    document.getElementById('tplUseYn').value = t.use_yn;
    const modalEl = document.getElementById('modalTemplate');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function openTestSendModal() {
    onSelectTestTemplate(document.getElementById('testTplSelect').value);
    const modalEl = document.getElementById('modalTestSend');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function openTestSendModalWithData(t) {
    document.getElementById('testTplSelect').value = t.id;
    onSelectTestTemplate(t.id);
    const modalEl = document.getElementById('modalTestSend');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function onSelectTestTemplate(id) {
    const t = templateList.find(item => String(item.id) === String(id)) || templateList[0];
    if (!t) return;
    updatePreviewKakao();
  }

  function updatePreviewKakao() {
    const tId = document.getElementById('testTplSelect').value;
    const t = templateList.find(item => String(item.id) === String(tId)) || templateList[0];
    if (!t) return;

    let content = t.content;
    const name = document.getElementById('sampleName').value || '고객';
    const model = document.getElementById('sampleModel').value || '단말기';
    const date = document.getElementById('sampleDate').value || '2026-11-06';
    const principal = document.getElementById('samplePrincipal').value || '0';
    const phone = document.getElementById('testPhoneInput').value || '010-0000-0000';

    content = content.replace(/#{고객명}/g, name);
    content = content.replace(/#{단말기명}/g, model);
    content = content.replace(/#{개통일자}/g, date);
    content = content.replace(/#{개통번호}/g, phone);
    content = content.replace(/#{할부원금}/g, principal);

    document.getElementById('kakaoMessageBubble').textContent = content;

    // 버튼 렌더링
    const buttonsBox = document.getElementById('kakaoButtonsBox');
    if (t.buttons && t.buttons.length > 0) {
      buttonsBox.innerHTML = t.buttons.map(b => `
        <button type="button" class="btn btn-sm btn-light border fw-semibold py-1" style="font-size: 0.75rem;">
          ${b.name}
        </button>
      `).join('');
    } else {
      buttonsBox.innerHTML = '';
    }
  }

  function mockSendTestKakao() {
    const phone = document.getElementById('testPhoneInput').value;
    const box = document.getElementById('testSendAlert');
    box.className = 'alert alert-warning mt-3 py-2 px-3 small';
    box.innerHTML = `<i class="bi bi-info-circle-fill me-1"></i> [${phone}] 번호로의 알림톡 발송은 <strong>[미구현 UI 데모]</strong> 상태입니다. 실제 카카오 비즈메시지 API 연동 준비 중입니다.`;
    box.classList.remove('d-none');
    setTimeout(() => box.classList.add('d-none'), 4000);
  }

  function mockSaveTemplate() {
    alert('현재 화면은 알림톡 템플릿 화면 구성 프로토타입이며, 실제 카카오 승인 및 DB 저장 기능은 준비 중(미구현)입니다.');
    const modalEl = document.getElementById('modalTemplate');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getInstance(modalEl) : null;
    if (modal) modal.hide();
  }

  function mockToggleStatus(btn, name) {
    alert(`[${name}] 알림톡의 발송 상태 토글 기능은 현재 준비 중(미구현)입니다.`);
  }

  function mockDeleteTemplate(name) {
    alert(`[${name}] 알림톡 템플릿 삭제 기능은 현재 준비 중(미구현)입니다.`);
  }
</script>

