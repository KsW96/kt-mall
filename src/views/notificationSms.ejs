          <div class="d-flex justify-content-end gap-2 pt-2 border-top">
            <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">닫기</button>
            <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm" id="btnSaveTplModal">
              <i class="bi bi-check-lg me-1"></i>저장하기
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

