<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
        <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi bi-chat-dots-fill text-primary"></i>
          <span>문자 관리 (SMS / LMS)</span>
        </h1>
        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2.5 py-1">
          <i class="bi bi-gear-wide-connected me-1"></i>발송 규칙 엔진 연동
        </span>
      </div>
      <p class="text-muted small mb-0">고객 개통일자 기준 맞춤 발송 조건, 템플릿 및 정기 발송 주기를 설정하고 관리합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <button type="button" class="btn btn-sm btn-outline-primary d-flex align-items-center gap-1 shadow-sm" onclick="openTestSendModal()">
        <i class="bi bi-send-fill"></i>
        <span>테스트 발송</span>
      </button>
      <button type="button" class="btn btn-sm btn-primary d-flex align-items-center gap-1 shadow-sm" onclick="openTemplateModal()">
        <i class="bi bi-plus-circle-fill"></i>
        <span>신규 템플릿 등록</span>
      </button>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> 새로고침
      </button>
    </div>
  </div>

  <!-- Sub Navigation Tabs (문자 관리 vs 알림톡 관리) -->
  <ul class="nav nav-tabs mb-4 border-bottom gap-1">
    <li class="nav-item">
      <a class="nav-link active fw-bold text-primary px-3 py-2 border-bottom-0" href="/notifications/sms">
        <i class="bi bi-chat-dots-fill me-1"></i>문자 관리 (SMS/LMS)
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link text-secondary px-3 py-2" href="/notifications/alimtalk">
        <i class="bi bi-chat-quote-fill me-1"></i>알림톡 관리 (카카오)
      </a>
    </li>
  </ul>

  <!-- Summary Metric Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-card-text fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">등록 템플릿</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.totalTemplates %><span class="fs-6 fw-normal text-muted ms-1">개</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-check2-circle fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">활성 발송 규칙</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.activeTemplates %><span class="fs-6 fw-normal text-muted ms-1">건 (USE)</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-info-subtle text-info me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-send-check fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">당월 누적 발송</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.monthlySent.toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span></div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning-subtle text-warning me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-graph-up-arrow fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium">발송 성공률</div>
            <div class="fs-4 fw-bold text-dark mb-0 mt-1"><%= stats.successRate %></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
      <div class="row g-2 align-items-center">
        <div class="col-md-3">
          <select class="form-select form-select-sm" id="filterStatus" onchange="applyFilter()">
            <option value="">상태 전체 (USE / HIDE)</option>
            <option value="Y">USE (발송 활성)</option>
            <option value="N">HIDE (발송 중지)</option>
          </select>
        </div>
        <div class="col-md-3">
          <select class="form-select form-select-sm" id="filterCondition" onchange="applyFilter()">
            <option value="">발송 조건 전체 (개통일 기준)</option>
            <option value="D_DAY">개통 당일 (D-Day)</option>
            <option value="AFTER_D">개통 후 N일차 (D+)</option>
            <option value="BEFORE_D">약정 만료 전 (D-)</option>
          </select>
        </div>
        <div class="col-md-6">
          <div class="input-group input-group-sm">
            <input type="text" class="form-control" id="searchKeyword" placeholder="템플릿 코드, 템플릿명, 본문 키워드 검색..." onkeyup="if(event.key==='Enter') applyFilter()">
            <button class="btn btn-dark" type="button" onclick="applyFilter()">
              <i class="bi bi-search me-1"></i>검색
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. 템플릿 관리 구조 테이블 (Template List) -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
      <div>
        <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
          <i class="bi bi-list-check text-primary"></i>
          <span>문자 템플릿 및 자동 발송 규칙 목록</span>
          <span class="badge bg-secondary-subtle text-dark ms-1"><%= templates.length %>건</span>
        </h5>
        <small class="text-muted">고객 개통 데이터를 기반으로 스케줄러가 자동 발송 조건을 감지하여 문자를 발송합니다.</small>
      </div>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 user-table" style="min-width: 1050px;">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-center" style="width: 50px;">No</th>
              <th scope="col" class="text-center" style="width: 80px;">유형</th>
              <th scope="col" class="text-start" style="width: 200px;">템플릿명 (코드)</th>
              <th scope="col" class="text-start" style="width: 170px;">발송 조건 (개통일 기준)</th>
              <th scope="col" class="text-start" style="width: 150px;">발송 주기 및 시간</th>
              <th scope="col" class="text-start" style="width: 160px;">치환 변수</th>
              <th scope="col" class="text-center" style="width: 90px;">상태</th>
              <th scope="col" class="text-center" style="width: 140px;">관리</th>
            </tr>
          </thead>
          <tbody>
            <% if (templates && templates.length > 0) { %>
              <% templates.forEach((t, idx) => { %>
                <tr>
                  <td class="text-center text-muted small"><%= idx + 1 %></td>
                  <td class="text-center">
                    <% if (t.msg_type === 'SMS') { %>
                      <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle">SMS</span>
                    <% } else { %>
                      <span class="badge bg-primary-subtle text-primary border border-primary-subtle">LMS</span>
                    <% } %>
                  </td>
                  <td class="text-start">
                    <strong class="text-dark d-block"><%= t.template_name %></strong>
                    <code class="text-muted small"><%= t.template_code %></code>
                  </td>
                  <td class="text-start">
                    <span class="badge bg-light text-dark border d-inline-flex align-items-center gap-1 mb-1">
                      <i class="bi bi-calendar-event text-primary"></i>
                      <span><%= t.condition_desc %></span>
                    </span>
                    <div class="small text-muted" style="font-size: 0.75rem;">대상: <%= t.target_category %></div>
                  </td>
                  <td class="text-start">
                    <div class="fw-semibold text-dark small"><i class="bi bi-clock me-1 text-secondary"></i><%= t.send_time %></div>
                    <div class="small text-muted" style="font-size: 0.75rem;"><%= t.send_cycle_desc %></div>
                  </td>
                  <td class="text-start">
                    <div class="d-flex flex-wrap gap-1">
                      <% (t.variables || []).forEach(v => { %>
                        <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.7rem;"><%= v %></span>
                      <% }); %>
                    </div>
                  </td>
                  <td class="text-center">
                    <% if (t.use_yn === 'Y') { %>
                      <button type="button" class="btn btn-sm btn-success px-3 py-1 fw-bold shadow-xs" onclick="mockToggleStatus(this, '<%= t.template_name %>')">
                        <i class="bi bi-check-circle-fill me-1"></i>USE
                      </button>
                    <% } else { %>
                      <button type="button" class="btn btn-sm btn-danger px-3 py-1 fw-bold shadow-xs" onclick="mockToggleStatus(this, '<%= t.template_name %>')">
                        <i class="bi bi-eye-slash-fill me-1"></i>HIDE
                      </button>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <div class="btn-group btn-group-sm">
                      <button type="button" class="btn btn-outline-primary py-0 px-2" title="미리보기 및 테스트 발송" onclick="openTestSendModalWithData(<%= JSON.stringify(t) %>)">
                        <i class="bi bi-send"></i>
                      </button>
                      <button type="button" class="btn btn-outline-secondary py-0 px-2" title="템플릿 수정" onclick="editTemplate(<%= JSON.stringify(t) %>)">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                      <button type="button" class="btn btn-outline-danger py-0 px-2" title="템플릿 삭제" onclick="mockDeleteTemplate('<%= t.template_name %>')">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-5 text-muted">등록된 문자 템플릿이 없습니다.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- ======================================================== -->
<!-- MODAL 1: 템플릿 설정 및 등록/수정 (발송조건, 주기 포함)     -->
<!-- ======================================================== -->
<div class="modal fade" id="modalTemplate" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold fs-6" id="modalTemplateTitle">
          <i class="bi bi-chat-dots-fill text-primary me-1"></i> 문자 발송 템플릿 설정
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="formTemplate">
          <!-- 1. 기본 템플릿 정보 -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                <i class="bi bi-info-circle-fill text-primary"></i> 1. 템플릿 기본 정보
              </h6>
              <div class="row g-2 mb-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">템플릿 코드 <span class="text-danger">*</span></label>
                  <input type="text" class="form-control form-control-sm font-monospace text-uppercase" id="tplCode" placeholder="예: SMS_WELCOME_01" value="SMS_OPEN_D30">
                </div>
                <div class="col-md-5">
                  <label class="form-label small fw-semibold text-secondary">템플릿 명칭 <span class="text-danger">*</span></label>
                  <input type="text" class="form-control form-control-sm" id="tplName" placeholder="예: 개통 30일차 안심 케어 문자" value="개통 30일차 요금제/단말 점검 안내">
                </div>
                <div class="col-md-3">
                  <label class="form-label small fw-semibold text-secondary">메시지 유형</label>
                  <select class="form-select form-select-sm" id="tplMsgType" onchange="updateMsgTypeLimit(this.value)">
                    <option value="LMS">LMS (장문, 최대 2,000자)</option>
                    <option value="SMS">SMS (단문, 90 Bytes)</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- 2. 발송 조건 설정 (개통일자 기준) -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                <i class="bi bi-calendar-check-fill text-success"></i> 2. 발송 조건 설정 (개통일자 기준)
              </h6>
              <div class="row g-2 mb-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">기준 일자</label>
                  <select class="form-select form-select-sm" id="tplConditionBase">
                    <option value="opening_dt" selected>개통일자 (activation_log.opening_dt)</option>
                    <option value="join_dt">가입일자 (app_user.join_dt)</option>
                    <option value="birth_dt">생년월일 (생일 축하)</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">조건 시점</label>
                  <select class="form-select form-select-sm" id="tplConditionType">
                    <option value="AFTER_D">기준일로부터 N일 후 (D+)</option>
                    <option value="D_DAY">기준일 당일 (D-Day)</option>
                    <option value="BEFORE_D">기준일로부터 N일 전 (D-)</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">일수 (Days)</label>
                  <div class="input-group input-group-sm">
                    <input type="number" class="form-control" id="tplConditionDays" value="30" min="0">
                    <span class="input-group-text">일차</span>
                  </div>
                </div>
              </div>
              <div class="row g-2">
                <div class="col-md-12">
                  <label class="form-label small fw-semibold text-secondary">대상 가입유형 필터 (선택)</label>
                  <div class="d-flex gap-3 small">
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="catAll" checked>
                      <label class="form-check-label" for="catAll">전체</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="catChange">
                      <label class="form-check-label" for="catChange">기기변경</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="catMnp">
                      <label class="form-check-label" for="catMnp">번호이동</label>
                    </div>
                    <div class="form-check">
                      <input class="form-check-input" type="checkbox" id="catNew">
                      <label class="form-check-label" for="catNew">신규가입</label>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- 3. 발송 주기 설정 (Schedule) -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-3">
              <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-1">
                <i class="bi bi-clock-history text-warning"></i> 3. 발송 주기 설정 (Schedule)
              </h6>
              <div class="row g-2">
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">발송 주기 방식</label>
                  <select class="form-select form-select-sm" id="tplCycle">
                    <option value="DAILY" selected>매일 정기 자동 발송</option>
                    <option value="WEEKLY">매주 특정 요일 발송</option>
                    <option value="MONTHLY">매월 특정 일자 발송</option>
                    <option value="REALTIME">조건 충족 시 실시간 즉시 발송</option>
                  </select>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">발송 희망 시간</label>
                  <input type="time" class="form-control form-control-sm" id="tplSendTime" value="10:00">
                  <div class="form-text small" style="font-size: 0.72rem;">* 통신사 광고/안내 규정 (08:00 ~ 20:50)</div>
                </div>
                <div class="col-md-4">
                  <label class="form-label small fw-semibold text-secondary">표출 상태</label>
                  <select class="form-select form-select-sm" id="tplUseYn">
                    <option value="Y" selected>USE (규칙 활성화)</option>
                    <option value="N">HIDE (발송 중지)</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- 4. 템플릿 본문 및 치환 변수 설정 -->
          <div class="card border bg-white mb-2">
            <div class="card-body p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h6 class="fw-bold mb-0 text-dark d-flex align-items-center gap-1">
                  <i class="bi bi-pencil-square text-primary"></i> 4. 메시지 본문 설정
                </h6>
                <div class="small text-muted" id="byteCounterBox">
                  <span id="charCount">0</span>자 / <span id="byteCount" class="fw-bold text-primary">0</span> Bytes
                </div>
              </div>

              <!-- 치환 변수 삽입 버튼 툴바 -->
              <div class="mb-2 p-2 bg-light rounded border">
                <div class="small fw-semibold text-secondary mb-1">
                  <i class="bi bi-code-slash me-1"></i>치환 변수 태그 (클릭 시 본문에 자동 삽입):
                </div>
                <div class="d-flex flex-wrap gap-1">
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{고객명}')">+#{고객명}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{개통번호}')">+#{개통번호}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{단말기명}')">+#{단말기명}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{개통일자}')">+#{개통일자}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{할부원금}')">+#{할부원금}</button>
                  <button type="button" class="btn btn-xs btn-outline-dark" onclick="insertVariable('#{가입유형}')">+#{가입유형}</button>
                </div>
              </div>

              <div class="mb-2">
                <label class="form-label small fw-semibold text-secondary">LMS 제목</label>
                <input type="text" class="form-control form-control-sm" id="tplTitleInput" placeholder="LMS 메시지 상단 제목" value="[KT 마켓] 개통 30일차 안심 케어 안내">
              </div>

              <div>
                <label class="form-label small fw-semibold text-secondary">메시지 본문 내용 <span class="text-danger">*</span></label>
                <textarea class="form-control form-control-sm font-monospace" id="tplContentInput" rows="6" oninput="calculateBytes(this.value)" placeholder="문자 메시지 내용을 작성하세요. 치환 변수를 포함할 수 있습니다.">[KT 마켓] #{고객명}님, 개통 후 30일이 경과하였습니다.
단말기(#{단말기명}) 사용 중 초기 설정이나 통화 품질에 불편함이 있으시다면 언제든 KT 고객센터(1588-0000)로 문의해 주세요.</textarea>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">닫기</button>
        <button type="button" class="btn btn-sm btn-primary px-3" onclick="mockSaveTemplate()">
          <i class="bi bi-check-lg me-1"></i>저장하기 (화면 데모)
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: 5. 테스트 발송 해볼 수 있는 기능 구조 (스마트폰 목업) -->
<!-- ======================================================== -->
<div class="modal fade" id="modalTestSend" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold fs-6">
          <i class="bi bi-phone text-primary me-1"></i> 5. 문자 테스트 발송 및 실시간 미리보기
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <div class="row g-4">
          <!-- 좌측: 테스트 발송 파라미터 입력 영역 -->
          <div class="col-lg-6 border-end">
            <h6 class="fw-bold mb-3 text-dark d-flex align-items-center gap-2">
              <i class="bi bi-send text-primary"></i>
              <span>테스트 수신자 및 치환 변수 매핑</span>
            </h6>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">발송할 템플릿 선택</label>
              <select class="form-select form-select-sm" id="testTplSelect" onchange="onSelectTestTemplate(this.value)">
                <% templates.forEach(t => { %>
                  <option value="<%= t.id %>"><%= t.template_name %> (<%= t.msg_type %>)</option>
                <% }); %>
              </select>
            </div>

            <div class="mb-3">
              <label class="form-label small fw-semibold text-secondary">테스트 수신 번호 <span class="text-danger">*</span></label>
              <input type="text" class="form-control form-control-sm font-monospace" id="testPhoneInput" value="010-9876-5432" placeholder="010-0000-0000">
              <div class="form-text small">관리자 또는 담당자 휴대폰 번호를 입력하여 실제 문자 수신 형태를 검증합니다.</div>
            </div>

            <div class="card border bg-light mb-3">
              <div class="card-body p-3">
                <span class="badge bg-secondary-subtle text-dark border mb-2 font-monospace">치환 변수 샘플 값 매핑</span>
                <div class="row g-2">
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{고객명}</label>
                    <input type="text" class="form-control form-control-sm" id="sampleName" value="홍길동" oninput="updatePreviewPhone()">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{단말기명}</label>
                    <input type="text" class="form-control form-control-sm" id="sampleModel" value="갤럭시 S25 Ultra" oninput="updatePreviewPhone()">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{개통일자}</label>
                    <input type="date" class="form-control form-control-sm" id="sampleDate" value="2026-11-06" oninput="updatePreviewPhone()">
                  </div>
                  <div class="col-6">
                    <label class="form-label small text-muted mb-1">#{할부원금}</label>
                    <input type="text" class="form-control form-control-sm" id="samplePrincipal" value="850,000" oninput="updatePreviewPhone()">
                  </div>
                </div>
              </div>
            </div>

            <div class="d-grid">
              <button type="button" class="btn btn-primary py-2 shadow-sm" onclick="mockSendTestSms()">
                <i class="bi bi-send-fill me-1"></i>테스트 문자 즉시 발송하기
              </button>
            </div>
            <div id="testSendAlert" class="alert alert-success mt-3 py-2 px-3 small d-none"></div>
          </div>

          <!-- 우측: 스마트폰 디바이스 목업 (실제 모바일 화면처럼 렌더링) -->
          <div class="col-lg-6 d-flex justify-content-center">
            <div class="phone-mockup shadow-lg rounded-4 p-3 border border-3 border-dark bg-dark" style="width: 320px; min-height: 480px;">
              <!-- Phone Notch & Speaker -->
              <div class="d-flex justify-content-center mb-2">
                <div class="bg-secondary rounded-pill" style="width: 70px; height: 6px;"></div>
              </div>

              <!-- Phone Screen Content -->
              <div class="bg-white rounded-3 p-3 d-flex flex-column" style="min-height: 440px;">
                <!-- Phone Header -->
                <div class="border-bottom pb-2 mb-3 text-center">
                  <div class="text-muted" style="font-size: 0.65rem;">오늘 오전 10:00</div>
                  <div class="fw-bold small text-dark"><i class="bi bi-chat-fill text-primary me-1"></i>KT 마켓 알림</div>
                  <div class="text-secondary" style="font-size: 0.7rem;" id="previewReceiverPhone">010-9876-5432</div>
                </div>

                <!-- Message Bubble -->
                <div class="bg-light p-3 rounded-3 border mb-2 text-start" style="font-size: 0.8rem; line-height: 1.5; white-space: pre-wrap;" id="phoneMessageBubble">
[KT 마켓] 홍길동님, 개통 후 30일이 경과하였습니다.
단말기(갤럭시 S25 Ultra) 사용 중 초기 설정이나 통화 품질에 불편함이 있으시다면 언제든 KT 고객센터(1588-0000)로 문의해 주세요.
                </div>

                <div class="mt-auto text-center pt-2 border-top">
                  <span class="badge bg-secondary-subtle text-secondary" style="font-size: 0.65rem;">
                    <i class="bi bi-shield-check me-1"></i>통신사 규격 검증 완료
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const templateList = <%- JSON.stringify(templates) %>;

  // 글자 수 및 바이트 계산기
  function calculateBytes(str) {
    let bytes = 0;
    for (let i = 0; i < str.length; i++) {
      const code = str.charCodeAt(i);
      bytes += (code > 128) ? 2 : 1;
    }
    document.getElementById('charCount').textContent = str.length;
    document.getElementById('byteCount').textContent = bytes;
  }

  function updateMsgTypeLimit(type) {
    const titleBox = document.getElementById('tplTitleInput');
    if (type === 'SMS') {
      titleBox.disabled = true;
      titleBox.value = '';
    } else {
      titleBox.disabled = false;
      if (!titleBox.value) titleBox.value = '[KT 마켓] 안내';
    }
  }

  function insertVariable(v) {
    const area = document.getElementById('tplContentInput');
    const start = area.selectionStart;
    const end = area.selectionEnd;
    const text = area.value;
    area.value = text.substring(0, start) + v + text.substring(end);
    area.focus();
    area.selectionStart = area.selectionEnd = start + v.length;
    calculateBytes(area.value);
  }

  function openTemplateModal() {
    document.getElementById('formTemplate').reset();
    document.getElementById('modalTemplateTitle').innerHTML = '<i class="bi bi-chat-dots-fill text-primary me-1"></i> 신규 문자 발송 템플릿 등록';
    calculateBytes(document.getElementById('tplContentInput').value);
    const modalEl = document.getElementById('modalTemplate');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function editTemplate(t) {
    document.getElementById('modalTemplateTitle').innerHTML = '<i class="bi bi-pencil-square text-primary me-1"></i> 템플릿 수정: ' + t.template_name;
    document.getElementById('tplCode').value = t.template_code;
    document.getElementById('tplName').value = t.template_name;
    document.getElementById('tplMsgType').value = t.msg_type;
    document.getElementById('tplTitleInput').value = t.title || '';
    document.getElementById('tplContentInput').value = t.content;
    document.getElementById('tplUseYn').value = t.use_yn;
    calculateBytes(t.content);
    const modalEl = document.getElementById('modalTemplate');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function openTestSendModal() {
    onSelectTestTemplate(document.getElementById('testTplSelect').value);
    const modalEl = document.getElementById('modalTestSend');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function openTestSendModalWithData(t) {
    document.getElementById('testTplSelect').value = t.id;
    onSelectTestTemplate(t.id);
    const modalEl = document.getElementById('modalTestSend');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function onSelectTestTemplate(id) {
    const t = templateList.find(item => String(item.id) === String(id)) || templateList[0];
    if (!t) return;
    updatePreviewPhone();
  }

  function updatePreviewPhone() {
    const tId = document.getElementById('testTplSelect').value;
    const t = templateList.find(item => String(item.id) === String(tId)) || templateList[0];
    if (!t) return;

    let content = t.content;
    const name = document.getElementById('sampleName').value || '고객';
    const model = document.getElementById('sampleModel').value || '단말기';
    const date = document.getElementById('sampleDate').value || '2026-11-06';
    const principal = document.getElementById('samplePrincipal').value || '0';
    const phone = document.getElementById('testPhoneInput').value || '010-0000-0000';

    content = content.replace(/#{고객명}/g, name);
    content = content.replace(/#{단말기명}/g, model);
    content = content.replace(/#{개통일자}/g, date);
    content = content.replace(/#{개통번호}/g, phone);
    content = content.replace(/#{할부원금}/g, principal);

    document.getElementById('phoneMessageBubble').textContent = content;
    document.getElementById('previewReceiverPhone').textContent = phone;
  }

  function mockSendTestSms() {
    const phone = document.getElementById('testPhoneInput').value;
    const box = document.getElementById('testSendAlert');
    box.className = 'alert alert-success mt-3 py-2 px-3 small';
    box.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> [${phone}] 번호로 테스트 문자가 정상 요청되었습니다. (화면 테스트 구조)`;
    box.classList.remove('d-none');
    setTimeout(() => box.classList.add('d-none'), 3500);
  }

  function mockSaveTemplate() {
    alert('템플릿 설정이 성공적으로 저장되었습니다. (화면 구성 데모)');
    const modalEl = document.getElementById('modalTemplate');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getInstance(modalEl) : null;
    if (modal) modal.hide();
  }

  function mockToggleStatus(btn, name) {
    const isUse = btn.classList.contains('btn-success');
    if (isUse) {
      btn.className = 'btn btn-sm btn-danger px-3 py-1 fw-bold shadow-xs';
      btn.innerHTML = '<i class="bi bi-eye-slash-fill me-1"></i>HIDE';
      alert(`[${name}] 템플릿이 [HIDE (발송 중지)] 상태로 변경되었습니다.`);
    } else {
      btn.className = 'btn btn-sm btn-success px-3 py-1 fw-bold shadow-xs';
      btn.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i>USE';
      alert(`[${name}] 템플릿이 [USE (발송 활성)] 상태로 변경되었습니다.`);
    }
  }

  function mockDeleteTemplate(name) {
    if (confirm(`[${name}] 템플릿을 삭제하시겠습니까? (화면 데모)`)) {
      alert(`[${name}] 템플릿이 삭제되었습니다.`);
    }
  }

  function applyFilter() {
    // 화면 필터링 데모
    console.log('Filter applied');
  }

  window.addEventListener('DOMContentLoaded', () => {
    calculateBytes(document.getElementById('tplContentInput').value);
  });
</script>

<%- include('partials/footer') %>

