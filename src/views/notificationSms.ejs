              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="cfgTestmode" id="cfgModeProd" value="N" <%= (aligoConfig && aligoConfig.testmodeYn === 'N') ? 'checked' : '' %>>
                <label class="form-check-label small" for="cfgModeProd">
                  <strong>실제 발송 모드 (N)</strong> <span class="text-danger">(잔여건수 차감)</span>
                </label>
