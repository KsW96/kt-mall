              <div class="form-check">
                <input class="form-check-input" type="radio" name="cfgTestmode" id="cfgModeTest" value="Y" <%= (!aligoConfig || aligoConfig.testmodeYn === 'Y') ? 'checked' : '' %>>
                <label class="form-check-label small" for="cfgModeTest">
                  <strong>테스트 모드 (Y)</strong> <span class="text-muted">(건수 차감 없음)</span>
