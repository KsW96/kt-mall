        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <form id="formTemplateEdit" onsubmit="saveTemplateData(event)">
          <input type="hidden" id="editTplId" value="">

          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label class="form-label small fw-semibold text-secondary">템플릿 코드 <span class="text-danger">*</span></label>
