<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-3 mb-4 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2.5 flex-wrap mb-1.5">
        <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi <%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_icon) ? currentMenu.menu_icon : 'bi-chat-dots-fill' %> text-primary"></i>
          <span><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : '문자 관리' %></span>
        </h1>
        <span class="badge bg-white text-dark border px-2.5 py-1.5 shadow-xs" id="topRemainBadge" style="font-size: 0.78rem;">
          <i class="bi bi-wallet2 text-primary me-1"></i>SMS: <%= (remainInfo && remainInfo.SMS_CNT) ? Number(remainInfo.SMS_CNT).toLocaleString() : 0 %>건 | LMS: <%= (remainInfo && remainInfo.LMS_CNT) ? Number(remainInfo.LMS_CNT).toLocaleString() : 0 %>건
        </span>
      </div>
      <p class="text-muted small mb-0">Aligo 공식 규격 기반 실시간 문자 발송 및 고객 개통 조건별 자동 스케줄 발송을 관리합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2.5 align-items-center">
      <!-- 연두빛 초록색 계열 Aligo 연동 설정 버튼 (내부 우측에 '연동중' / '연동필요' 표시) -->
      <% if (aligoConfig && aligoConfig.apiKey && aligoConfig.sender) { %>
        <button type="button" class="btn btn-sm btn-aligo-status d-flex align-items-center gap-2 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalAligoConfig">
          <i class="bi bi-gear-fill"></i>
          <span>Aligo 연동 설정</span>
          <span class="badge bg-white fw-bold py-0.5 px-2 rounded-pill shadow-xs" style="color: #047857; font-size: 0.72rem;">연동중</span>
        </button>
      <% } else { %>
        <button type="button" class="btn btn-sm btn-aligo-status-off d-flex align-items-center gap-2 shadow-sm fw-semibold" data-bs-toggle="modal" data-bs-target="#modalAligoConfig">
          <i class="bi bi-gear-fill"></i>
          <span>Aligo 연동 설정</span>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold py-0.5 px-2 rounded-pill" style="font-size: 0.72rem;">연동필요</span>
        </button>
      <% } %>

      <button type="button" class="btn btn-sm btn-light border shadow-xs" onclick="checkAligoRemain()">
        <i class="bi bi-arrow-clockwise me-1"></i>잔여건수 갱신
      </button>
      <a href="/notifications/history" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-clock-history me-1"></i>발송 이력
      </a>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> 새로고침
      </button>
    </div>
  </div>

  <style>
    /* 연두빛 초록색 Aligo 연동 상태 버튼 */
    .btn-aligo-status {
      background-color: #10b981;
      border-color: #059669;
      color: #ffffff;
      transition: all 0.15s ease-in-out;
    }
    .btn-aligo-status:hover {
      background-color: #059669;
      border-color: #047857;
      color: #ffffff;
    }
    .btn-aligo-status-off {
      background-color: #f0fdf4;
      border-color: #86efac;
      color: #166534;
      transition: all 0.15s ease-in-out;
    }
    .btn-aligo-status-off:hover {
      background-color: #dcfce7;
      border-color: #4ade80;
      color: #14532d;
    }

    /* 6.5 : 3.5 간격 비율 레이아웃 */
    @media (min-width: 992px) {
      .col-sms-left {
        flex: 0 0 65%;
        max-width: 65%;
        width: 65%;
      }
      .col-sms-right {
        flex: 0 0 35%;
        max-width: 35%;
        width: 35%;
      }
    }
    @media (max-width: 991.98px) {
      .col-sms-left, .col-sms-right {
        flex: 0 0 100%;
        max-width: 100%;
        width: 100%;
      }
      .col-sms-right {
        margin-top: 2rem;
      }
    }

    /* 쾌적하고 균형 잡힌 스마트폰 실물 디바이스 목업 (330px) */
    .compact-phone-mockup {
      width: 100%;
      max-width: 330px;
      min-height: 500px;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.16), 0 4px 12px rgba(0, 0, 0, 0.08) !important;
      border-radius: 36px !important;
    }
    .compact-screen {
      min-height: 460px;
      border-radius: 26px !important;
    }
    .compact-bubble {
      font-size: 0.83rem;
      line-height: 1.6;
      min-height: 180px;
      max-height: 270px;
      overflow-y: auto;
      border-radius: 14px;
      white-space: pre-wrap;
    }

    /* 테이블 행 호버 및 여유로운 패딩 시인성 */
    .table-sm td, .table-sm th {
      padding-top: 0.7rem;
      padding-bottom: 0.7rem;
      padding-left: 0.85rem;
      padding-right: 0.85rem;
    }

    /* 메인 컴포넌트 간격 시스템 (컴포넌트 간 뚜렷한 분리) */
    .sms-main-card {
      margin-bottom: 2.25rem !important;
    }
    .builder-section {
      margin-bottom: 1.85rem !important;
    }
    .builder-box {
      padding: 1.4rem 1.6rem !important;
      border-radius: 0.75rem !important;
    }

    /* 커스텀 간격 유틸리티 정의 (Bootstrap 5 확장) */
    .gap-1\.5 { gap: 0.375rem !important; }
    .gap-2\.5 { gap: 0.65rem !important; }
    .gap-3\.5 { gap: 1.15rem !important; }
    .gap-4\.5 { gap: 1.75rem !important; }
    .mb-0\.5 { margin-bottom: 0.15rem !important; }
    .mb-1\.5 { margin-bottom: 0.375rem !important; }
    .mb-2\.5 { margin-bottom: 0.75rem !important; }
    .mb-3\.5 { margin-bottom: 1.25rem !important; }
    .mb-4\.5 { margin-bottom: 1.75rem !important; }
    .mt-0\.5 { margin-top: 0.15rem !important; }
    .mt-1\.5 { margin-top: 0.375rem !important; }
    .mt-2\.5 { margin-top: 0.75rem !important; }
    .mt-3\.5 { margin-top: 1.25rem !important; }
    .mt-4\.5 { margin-top: 1.75rem !important; }
    .pt-0\.5 { padding-top: 0.15rem !important; }
    .pt-1\.5 { padding-top: 0.375rem !important; }
    .pt-2\.5 { padding-top: 0.75rem !important; }
    .pt-3\.5 { padding-top: 1.25rem !important; }
    .pt-4\.5 { padding-top: 1.75rem !important; }
    .pb-0\.5 { padding-bottom: 0.15rem !important; }
    .pb-1\.5 { padding-bottom: 0.375rem !important; }
    .pb-2\.5 { padding-bottom: 0.75rem !important; }
    .pb-3\.5 { padding-bottom: 1.25rem !important; }
    .pb-4\.5 { padding-bottom: 1.75rem !important; }
    .py-0\.5 { padding-top: 0.15rem !important; padding-bottom: 0.15rem !important; }
    .py-1\.5 { padding-top: 0.375rem !important; padding-bottom: 0.375rem !important; }
    .py-2\.5 { padding-top: 0.65rem !important; padding-bottom: 0.65rem !important; }
    .py-3\.5 { padding-top: 1.25rem !important; padding-bottom: 1.25rem !important; }
    .px-1\.5 { padding-left: 0.375rem !important; padding-right: 0.375rem !important; }
    .px-2\.5 { padding-left: 0.65rem !important; padding-right: 0.65rem !important; }
    .px-3\.5 { padding-left: 1.15rem !important; padding-right: 1.15rem !important; }
    .p-2\.5 { padding: 0.65rem !important; }
    .p-3\.5 { padding: 1.15rem !important; }
    .me-0\.5 { margin-right: 0.15rem !important; }
    .me-1\.5 { margin-right: 0.375rem !important; }
    .me-2\.5 { margin-right: 0.65rem !important; }
    .ms-0\.5 { margin-left: 0.15rem !important; }
    .g-4\.5 { --bs-gutter-x: 1.75rem; --bs-gutter-y: 1.75rem; }
  </style>

  <!-- ======================================================== -->
  <!-- MAIN SPLIT VIEW: 좌측 65% VS 우측 35% 분할 레이아웃 -->
  <!-- ======================================================== -->
  <div class="row g-4 align-items-start">
    
    <!-- ====================================================== -->
    <!-- LEFT COLUMN (65%): 템플릿 목록 및 발송 메시지 파라미터 빌더 -->
    <!-- ====================================================== -->
    <div class="col-sms-left">
      
      <!-- 1. 템플릿 목록 카드 (Template List) -->
      <div class="card border-0 shadow-sm rounded-3 sms-main-card">
        <div class="card-header bg-white border-0 py-3.5 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
              <i class="bi bi-collection-fill text-primary"></i>
              <span>문자 템플릿 목록</span>
            </h5>
            <span class="badge bg-primary-subtle text-primary" id="templateCountBadge"><%= templates.length %>건</span>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary py-1.5 px-3 d-flex align-items-center gap-1.5 shadow-xs fw-semibold" onclick="openTemplateModal()">
              <i class="bi bi-plus-circle-fill"></i>
              <span>신규 템플릿 등록</span>
            </button>
            <button type="button" class="btn btn-sm btn-outline-dark py-1.5 px-2.5 d-flex align-items-center gap-1.5" onclick="selectDirectInput()">
              <i class="bi bi-pencil-square"></i>
              <span>직접 새로 작성</span>
            </button>
          </div>
        </div>

        <!-- 필터 & 검색 바 -->
        <div class="px-4 py-3 border-bottom bg-light-subtle">
          <div class="row g-3">
            <div class="col-md-4">
              <select class="form-select form-select-sm" id="filterCondition" onchange="filterTemplates()">
                <option value="">전체 발송조건</option>
                <option value="D_DAY">개통 당일 (D-Day)</option>
                <option value="AFTER_D">개통 후 N일차 (D+)</option>
                <option value="BEFORE_D">약정 만료 전 (D-)</option>
              </select>
            </div>
            <div class="col-md-8">
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="searchKeyword" placeholder="템플릿명, 키워드 검색..." onkeyup="filterTemplates()">
                <button class="btn btn-outline-secondary" type="button" onclick="filterTemplates()">
                  <i class="bi bi-search"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 템플릿 리스트 테이블 (넓어진 65% 공간 활용) -->
        <div class="card-body p-0">
          <div class="table-responsive" style="max-height: 290px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0" id="templateTable">
              <thead class="table-light sticky-top small" style="z-index: 1;">
                <tr>
                  <th scope="col" class="text-center" style="width: 45px;">선택</th>
                  <th scope="col" class="text-center" style="width: 60px;">유형</th>
                  <th scope="col">템플릿명 (코드)</th>
                  <th scope="col" style="width: 140px;">발송 조건</th>
                  <th scope="col" style="width: 130px;">발송 주기 및 시간</th>
                  <th scope="col" class="text-center" style="width: 70px;">상태</th>
                  <th scope="col" class="text-center" style="width: 75px;">관리</th>
                </tr>
              </thead>
              <tbody id="templateListBody">
                <% if (templates && templates.length > 0) { %>
                  <% templates.forEach((t, idx) => { %>
                    <tr class="template-row <%= idx === 0 ? 'table-active border-primary' : '' %>" 
                        id="tplRow_<%= t.id %>" 
                        style="cursor: pointer;" 
                        onclick="onSelectTemplateRow(<%= t.id %>)">
                      <td class="text-center">
                        <input class="form-check-input" type="radio" name="selectedTemplateRadio" id="radioTpl_<%= t.id %>" value="<%= t.id %>" <%= idx === 0 ? 'checked' : '' %>>
                      </td>
                      <td class="text-center">
                        <% if (t.msg_type === 'SMS') { %>
                          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace" style="font-size: 0.68rem;">SMS</span>
                        <% } else { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.68rem;">LMS</span>
                        <% } %>
                      </td>
                      <td>
                        <strong class="text-dark d-block small"><%= t.template_name %></strong>
                        <code class="text-muted small" style="font-size: 0.7rem;"><%= t.template_code %></code>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border font-monospace py-0.5 px-1.5" style="font-size: 0.7rem;">
                          <%= t.condition_desc || t.condition_type %>
                        </span>
                      </td>
                      <td>
                        <div class="small text-dark font-monospace" style="font-size: 0.72rem;">
                          <i class="bi bi-clock me-1 text-secondary"></i><%= t.send_time %>
                        </div>
                        <div class="text-muted small" style="font-size: 0.68rem;"><%= t.send_cycle_desc || t.send_cycle %></div>
                      </td>
                      <td class="text-center" onclick="event.stopPropagation()">
                        <button type="button" class="btn btn-xs <%= t.use_yn === 'Y' ? 'btn-success' : 'btn-danger' %> py-0.5 px-2 fw-semibold shadow-xs" 
                                onclick="toggleTemplateUse(<%= t.id %>, this)">
                          <%= t.use_yn === 'Y' ? 'USE' : 'HIDE' %>
                        </button>
                      </td>
                      <td class="text-center" onclick="event.stopPropagation()">
                        <div class="btn-group btn-group-sm">
                          <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1.5" title="템플릿 속성 수정" onclick="editTemplateModal(<%= t.id %>)">
                            <i class="bi bi-pencil"></i>
                          </button>
                          <button type="button" class="btn btn-xs btn-outline-danger py-0 px-1.5" title="삭제" onclick="deleteTemplate(<%= t.id %>, '<%= t.template_name %>')">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted small">등록된 템플릿이 없습니다.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 2. 메시지 빌더 및 Aligo 발송 설정 카드 (Message Builder) -->
      <div class="card border-0 shadow-sm rounded-3 sms-main-card" id="messageBuilderCard">
        <div class="card-header bg-white border-0 py-3.5 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
              <i class="bi bi-sliders text-primary"></i>
              <span>메시지 내용 및 발송 설정</span>
            </h5>
          </div>
          <span class="badge bg-secondary-subtle text-secondary font-monospace py-1.5 px-2.5" id="currentLoadedTplName">템플릿 로드됨</span>
        </div>

        <div class="card-body p-4 pt-3">
          <!-- 숨겨진 필드: 현재 선택된 템플릿 ID 및 코드 -->
          <input type="hidden" id="activeTemplateId" value="<%= (templates && templates.length > 0) ? templates[0].id : '' %>">
          <input type="hidden" id="activeTemplateCode" value="<%= (templates && templates.length > 0) ? templates[0].template_code : 'TEST_DIRECT' %>">

          <!-- 발송 대상 모드 선택 바 -->
          <div class="builder-box bg-light border builder-section">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
              <div class="d-flex align-items-center gap-3">
                <span class="fw-bold text-dark fs-6 d-flex align-items-center gap-1.5">
                  <i class="bi bi-send-check-fill text-primary"></i>
                  <span>발송 방식:</span>
                </span>
                <div class="d-flex gap-2" role="group">
                  <input type="radio" class="btn-check" name="sendTargetMode" id="targetModeBulk" value="BULK" checked onchange="switchTargetSendMode('BULK')">
                  <label class="btn btn-sm btn-outline-primary fw-bold px-3 py-2 rounded-2" for="targetModeBulk">
                    <i class="bi bi-people-fill me-1"></i>단체 발송 (하단 고객 대상)
                  </label>

                  <input type="radio" class="btn-check" name="sendTargetMode" id="targetModeDirect" value="DIRECT" onchange="switchTargetSendMode('DIRECT')">
                  <label class="btn btn-sm btn-outline-secondary fw-bold px-3 py-2 rounded-2" for="targetModeDirect">
                    <i class="bi bi-telephone-plus me-1"></i>직접 입력 (1건 테스트)
                  </label>
                </div>
              </div>

              <!-- 단체 발송 모드 안내 요약 바 (기본 표출) -->
              <div id="targetBulkSummaryArea" class="d-flex align-items-center gap-2">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 py-2 px-3 fw-semibold">
                  발송 대상: <strong class="font-monospace fs-6" id="summarySelectedTargetCount"><%= (typeof targetCount !== 'undefined') ? targetCount : 12 %></strong>명 선택됨
                </span>
                <a href="#targetRecipientsCard" class="btn btn-sm btn-outline-secondary py-1.5 px-2.5 text-decoration-none">
                  <i class="bi bi-arrow-down-circle me-1"></i>명단 보기
                </a>
              </div>
            </div>

            <!-- 직접 번호 입력 폼 (DIRECT 토글 시 표출) -->
            <div id="targetDirectInputArea" class="row g-3 align-items-center d-none mt-2 pt-3 border-top">
              <div class="col-md-7">
                <label class="form-label small fw-bold text-secondary mb-1">
                  직접 수신 번호 입력 <span class="text-danger">*</span>
                </label>
                <div class="input-group">
                  <span class="input-group-text bg-white text-secondary px-3"><i class="bi bi-telephone-fill"></i></span>
                  <input type="text" class="form-control font-monospace py-2" id="sendReceiverInput" value="010-0000-0000" 
                         placeholder="수신 번호 입력 (예: 01012345678)" 
                         data-format="phone"
                         oninput="onReceiverInputChange()"
                         onblur="onReceiverBlur(this)">
                </div>
              </div>
              <div class="col-md-5">
                <label class="form-label small fw-bold text-secondary mb-1">사전 등록 발신 번호</label>
                <div class="input-group">
                  <span class="input-group-text bg-white text-secondary px-3"><i class="bi bi-broadcast-pin"></i></span>
                  <input type="text" class="form-control font-monospace bg-light py-2" id="sendSenderInput" value="02-805-1999" readonly>
                </div>
              </div>
            </div>
          </div>

          <!-- LMS 제목 입력란 (LMS일 때만 필수/활성) -->
          <div class="builder-section" id="titleGroupWrapper">
            <div class="d-flex justify-content-between align-items-center mb-2.5">
              <label class="form-label fw-bold text-dark fs-6 mb-0">
                메시지 제목 <span class="text-muted fw-normal small">(LMS 장문 시 상단에 표시)</span>
              </label>
              <span class="text-muted small">
                <strong id="titleByteCount" class="text-dark">0</strong> / 44 Byte
              </span>
            </div>
            <input type="text" class="form-control py-2.5 px-3.5 fs-6" id="sendTitleInput" 
                   value="<%= (templates && templates.length > 0 && templates[0].title) ? templates[0].title : '[KT몰] 개통 안내' %>" 
                   placeholder="[KT몰] LMS 메시지 상단 제목 (최대 44Byte)" 
                   oninput="onTitleInputChange()">
          </div>

          <!-- 메시지 본문 입력란 (시원하고 여유로운 대형 에디터) -->
          <div class="builder-section">
            <div class="d-flex justify-content-between align-items-center mb-2.5">
              <label class="form-label fw-bold text-dark fs-6 mb-0">
                메시지 본문 (Msg) <span class="text-danger">*</span>
              </label>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace py-1.5 px-2.5 fs-6" id="msgTypeBadge">SMS</span>
                <span class="text-muted" style="font-size: 0.85rem;">
                  <strong id="contentByteCount" class="text-dark fs-6">0</strong> / 2,000 Byte (<span id="contentCharCount">0</span>자)
                </span>
              </div>
            </div>
            <textarea class="form-control font-monospace px-4 py-3.5" id="sendContentInput" rows="10" 
                      style="font-size: 0.95rem; line-height: 1.65; min-height: 240px;" 
                      placeholder="문자 메시지 내용을 입력하세요..." 
                      oninput="onContentInputChange()"><%= (templates && templates.length > 0) ? templates[0].content : '' %></textarea>
            
            <!-- 치환 변수 원클릭 삽입 버튼 툴바 (여유로운 간격과 폰트) -->
            <div class="d-flex flex-wrap align-items-center gap-2 mt-3.5 p-3.5 px-4 bg-light rounded-3 border">
              <span class="fw-bold text-secondary me-2" style="font-size: 0.82rem;">
                <i class="bi bi-code-slash text-primary me-1"></i>치환 변수 원클릭 삽입:
              </span>
              <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2.5 py-1.5" onclick="insertVariableToContent('#{고객명}')">#{고객명}</button>
              <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2.5 py-1.5" onclick="insertVariableToContent('#{개통번호}')">#{개통번호}</button>
              <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2.5 py-1.5" onclick="insertVariableToContent('#{단말기명}')">#{단말기명}</button>
              <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2.5 py-1.5" onclick="insertVariableToContent('#{개통일자}')">#{개통일자}</button>
              <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2.5 py-1.5" onclick="insertVariableToContent('#{할부원금}')">#{할부원금}</button>
              <button type="button" class="btn btn-sm btn-outline-primary fw-semibold px-2.5 py-1.5" onclick="insertVariableToContent('#{요금제}')">#{요금제}</button>
            </div>
          </div>

          <!-- 치환 변수 샘플 매핑 값 (우측 모바일 화면에 즉시 치환 반영) -->
          <div class="builder-box bg-light border builder-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <span class="fw-bold text-dark fs-6">
                <i class="bi bi-magic text-primary me-1"></i>치환 변수 미리보기 값 (하단 고객 선택 시 자동 갱신)
              </span>
            </div>
            <div class="row g-4">
              <div class="col-6 col-sm-3">
                <label class="form-label small fw-bold text-secondary mb-1.5">#{고객명}</label>
                <input type="text" class="form-control py-2 px-3" id="varSampleName" value="홍길동" placeholder="고객명 입력" oninput="updateMobileMockup()">
              </div>
              <div class="col-6 col-sm-3">
                <label class="form-label small fw-bold text-secondary mb-1.5">#{단말기명}</label>
                <input type="text" class="form-control py-2 px-3" id="varSampleModel" value="갤럭시 S25 Ultra" placeholder="단말기명" oninput="updateMobileMockup()">
              </div>
              <div class="col-6 col-sm-3">
                <label class="form-label small fw-bold text-secondary mb-1.5 d-flex justify-content-between">
                  <span>#{개통일자}</span>
                  <span class="text-muted fw-normal" style="font-size: 0.7rem;">YYYY-MM-DD</span>
                </label>
                <input type="text" class="form-control font-monospace py-2 px-3" id="varSampleDate" value="2026-11-07" 
                       placeholder="예: 20261107" 
                       data-format="date"
                       onfocus="this.value = AppFormatters.rawDigits(this.value)"
                       onblur="this.value = AppFormatters.formatBirthOrDate(this.value); updateMobileMockup();"
                       oninput="updateMobileMockup()">
              </div>
              <div class="col-6 col-sm-3">
                <label class="form-label small fw-bold text-secondary mb-1.5 d-flex justify-content-between">
                  <span>#{할부원금}</span>
                  <span class="text-muted fw-normal" style="font-size: 0.7rem;">원단위 쉼표</span>
                </label>
                <input type="text" class="form-control font-monospace text-end py-2 px-3" id="varSamplePrice" value="850,000" 
                       placeholder="예: 7000 또는 850000" 
                       data-format="currency"
                       onfocus="this.value = AppFormatters.rawDigits(this.value)"
                       onblur="this.value = AppFormatters.formatCurrency(this.value, false); updateMobileMockup();"
                       oninput="updateMobileMockup()">
              </div>
            </div>
          </div>

          <!-- Aligo 발송 설정: 예약 발송 & 발송 모드 (좌우 여백 넉넉한 분할 레이아웃) -->
          <div class="builder-box bg-light border mb-2">
            <div class="row g-4 align-items-center">
              <!-- 좌측: 예약 발송 설정 (왼쪽 벽에서 넉넉하게 이격) -->
              <div class="col-md-6 border-end-md ps-md-3 pe-md-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                  <div class="form-check form-switch ps-0 m-0 d-flex align-items-center">
                    <input class="form-check-input ms-0 me-2.5 float-none" type="checkbox" id="chkReservation" role="switch" onchange="toggleReservationInputs(this.checked)" style="width: 2.4rem; height: 1.25rem; cursor: pointer;">
                    <label class="form-check-label fw-bold text-dark fs-6" for="chkReservation" style="cursor: pointer;">
                      예약 발송 설정 (지정 일시 발송)
                    </label>
                  </div>
                </div>
                <div class="row g-3 d-none mt-2" id="reservationInputArea">
                  <div class="col-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">예약 날짜</label>
                    <input type="date" class="form-control py-2 px-3" id="sendRdate">
                  </div>
                  <div class="col-6">
                    <label class="form-label small fw-semibold text-secondary mb-1">예약 시간</label>
                    <input type="time" class="form-control py-2 px-3" id="sendRtime">
                  </div>
                  <div class="col-12 mt-1">
                    <small class="text-muted" style="font-size: 0.74rem;">* 현재 시간 기준 최소 10분 이후 시간으로 지정해야 합니다.</small>
                  </div>
                </div>
              </div>

              <!-- 우측: 발송 모드 설정 (테스트 vs 실제 발송) -->
              <div class="col-md-6 ps-md-3 pe-md-3">
                <label class="form-label fw-bold text-dark fs-6 mb-2.5 d-block">
                  <i class="bi bi-shield-check text-primary me-1"></i>발송 모드 선택
                </label>
                <div class="d-flex gap-4 align-items-center flex-wrap">
                  <div class="form-check ps-0 m-0 d-flex align-items-center gap-1.5">
                    <input class="form-check-input ms-0 me-1.5 float-none" type="radio" name="sendTestmodeRadio" id="modeTest" value="Y" checked style="width: 1.2rem; height: 1.2rem; cursor: pointer;">
                    <label class="form-check-label fs-6" for="modeTest" style="cursor: pointer;">
                      <strong>테스트 모드</strong> <span class="text-muted small">(건수 미차감)</span>
                    </label>
                  </div>
                  <div class="form-check ps-0 m-0 d-flex align-items-center gap-1.5">
                    <input class="form-check-input ms-0 me-1.5 float-none" type="radio" name="sendTestmodeRadio" id="modeProd" value="N" style="width: 1.2rem; height: 1.2rem; cursor: pointer;">
                    <label class="form-check-label fs-6 text-danger" for="modeProd" style="cursor: pointer;">
                      <strong>실제 발송</strong> <span class="text-muted small">(1건 차감)</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- 3. 발송 대상 설정 & 발송 예정 고객 리스트 카드 (Recipient List) -->
      <div class="card border-0 shadow-sm rounded-3 sms-main-card" id="targetRecipientsCard">
        <div class="card-header bg-white border-0 pt-3.5 pb-2.5 px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div class="d-flex align-items-center gap-2">
            <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
              <i class="bi bi-people-fill text-primary"></i>
              <span>발송 예정 대상 고객 리스트</span>
            </h5>
            <span class="badge bg-primary text-white font-monospace px-2.5 py-1" id="recipientCountBadge">
              <%= (typeof targetCount !== 'undefined') ? targetCount : 12 %>명 매칭
            </span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <span class="badge bg-light text-secondary border small d-none d-md-inline-block py-1.5 px-2.5">
              <i class="bi bi-phone-flip me-1 text-primary"></i>고객을 클릭하면 해당 고객에게 전송될 실제 문자 내용으로 우측 미리보기가 바뀝니다
            </span>
            <button type="button" class="btn btn-sm btn-outline-secondary py-1 px-2.5" onclick="refreshTargetRecipients()">
              <i class="bi bi-arrow-clockwise me-1"></i>새로고침
            </button>
          </div>
        </div>

        <div class="card-body p-4 pt-3">
          <!-- 타겟팅 조건 셀렉트 바 (컴팩트 & 쾌적한 1줄 구성) -->
          <div class="builder-box bg-light border mb-3.5 d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2.5 flex-grow-1" style="max-width: 580px;">
              <label class="form-label fw-bold text-dark mb-0 fs-6 text-nowrap">
                <i class="bi bi-funnel-fill text-primary me-1"></i>대상 조건:
              </label>
              <select class="form-select form-select-sm fw-semibold border-primary text-primary py-1.5" id="selectTargetCondition" onchange="onTargetConditionChange(this.value)">
                <option value="AFTER_183D" selected>개통 183일 이상 경과 고객 (의무 요금제 만료 안내)</option>
                <option value="D_DAY">개통 당일 고객 (가입 감사 인사)</option>
                <option value="AFTER_3D">개통 3일차 고객 (안심 케어 및 통화품질 점검)</option>
                <option value="AFTER_100D">개통 100일차 고객 (요금제 변경 안내)</option>
                <option value="ALL">전체 개통 고객 리스트</option>
              </select>
            </div>
            <div class="small text-muted py-0.5" id="targetConditionDescText">
              개통 183일 경과: 의무 요금제 하향 및 부가서비스 해지 대상
            </div>
          </div>

          <!-- 테이블 상단: 일괄 선택 체크박스 & 검색창 -->
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
              <div class="form-check mb-0">
                <input class="form-check-input" type="checkbox" id="chkAllRecipients" checked onchange="toggleSelectAllRecipients(this.checked)">
                <label class="form-check-label small fw-semibold text-secondary" for="chkAllRecipients">
                  전체 선택 (<span id="selectedCountText"><%= (typeof targetCount !== 'undefined') ? targetCount : 12 %></span>/<span id="totalCountText"><%= (typeof targetCount !== 'undefined') ? targetCount : 12 %></span>명)
                </label>
              </div>
              <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2.5" onclick="deselectAllRecipients()">선택 해제</button>
            </div>

            <div class="d-flex align-items-center gap-2">
              <div class="input-group input-group-sm" style="width: 240px;">
                <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0 py-1" id="recipientSearchInput" placeholder="고객명, 전화번호 검색..." oninput="filterRecipientTable(this.value)">
              </div>
            </div>
          </div>

          <!-- 발송 대상 고객 목록 테이블 -->
          <div class="table-responsive border rounded-3" style="max-height: 350px; overflow-y: auto;">
            <table class="table table-hover table-sm align-middle mb-0 user-table" style="font-size: 0.82rem;">
              <thead class="table-light sticky-top">
                <tr>
                  <th scope="col" class="text-center py-2" style="width: 44px;">선택</th>
                  <th scope="col" class="py-2" style="width: 90px;">고객명</th>
                  <th scope="col" class="py-2" style="width: 130px;">휴대폰번호</th>
                  <th scope="col" class="py-2" style="width: 100px;">개통일자</th>
                  <th scope="col" class="text-center py-2" style="width: 95px;">경과일수</th>
                  <th scope="col" class="py-2">개통 단말기 모델명</th>
                  <th scope="col" class="py-2" style="width: 135px;">가입 요금제</th>
                  <th scope="col" class="text-end py-2" style="width: 105px;">할부원금</th>
                  <th scope="col" class="text-center py-2" style="width: 85px;">미리보기</th>
                </tr>
              </thead>
              <tbody id="targetRecipientsBody">
                <% if (typeof initialRecipients !== 'undefined' && initialRecipients && initialRecipients.length > 0) { %>
                  <% initialRecipients.forEach((c, idx) => { %>
                    <tr class="recipient-row <%= idx === 0 ? 'table-primary border-primary' : '' %>" 
                        id="recRow_<%= c.id %>" 
                        style="cursor: pointer;" 
                        onclick="onSelectRecipientRow(<%= c.id %>)">
                      <td class="text-center" onclick="event.stopPropagation()">
                        <input class="form-check-input recipient-checkbox" type="checkbox" value="<%= c.id %>" id="chkRec_<%= c.id %>" checked onchange="onRecipientCheckChange()">
                      </td>
                      <td>
                        <strong class="text-dark"><%= c.cust_nm %></strong>
                      </td>
                      <td class="font-monospace text-secondary">
                        <%= c.phone_num %>
                      </td>
                      <td class="font-monospace text-muted">
                        <%= c.opening_dt %>
                      </td>
                      <td class="text-center">
                        <span class="badge <%= (c.elapsed_days >= 183) ? 'bg-danger-subtle text-danger border border-danger-subtle' : 'bg-primary-subtle text-primary border border-primary-subtle' %> font-monospace py-0.5 px-1.5" style="font-size: 0.7rem;">
                          D+<%= c.elapsed_days %>일
                        </span>
                      </td>
                      <td class="text-dark fw-medium text-truncate" style="max-width: 180px;" title="<%= c.model_nm %>">
                        <%= c.model_nm %>
                      </td>
                      <td class="text-muted small text-truncate" style="max-width: 130px;" title="<%= c.plan_nm || '-' %>">
                        <%= c.plan_nm || '-' %>
                      </td>
                      <td class="text-end font-monospace fw-semibold text-dark">
                        <%= Number(c.installment_principal || 0).toLocaleString() %>원
                      </td>
                      <td class="text-center" onclick="event.stopPropagation()">
                        <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-2" title="이 고객에게 전송될 문자 미리보기" onclick="onSelectRecipientRow(<%= c.id %>)">
                          <i class="bi bi-eye me-0.5"></i>보기
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="9" class="text-center py-4 text-muted small">
                      <i class="bi bi-exclamation-circle me-1"></i>선택한 조건에 해당하는 고객이 없습니다.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

          <!-- 하단 요약 및 바로가기 바 -->
          <div class="d-flex justify-content-between align-items-center pt-2 mt-1">
            <small class="text-secondary" id="recipientSelectionSummary">
              선택된 <strong class="text-primary font-monospace" id="summarySelectedNumber"><%= (typeof targetCount !== 'undefined') ? targetCount : 12 %></strong>명에게 단체 발송이 진행됩니다.
            </small>
            <div class="d-flex gap-2">
              <span class="small text-muted" style="font-size: 0.73rem;">
                개통 183일 경과 기준: 개통일로부터 6개월 지난 고객 자동 추출
              </span>
            </div>
          </div>

        </div>
      </div>

    </div>

    <!-- ====================================================== -->
    <!-- RIGHT COLUMN (35%): 컴팩트 모바일 Sample 디바이스 목업 & 즉시 발송 컨트롤 -->
    <!-- ====================================================== -->
    <div class="col-sms-right" style="position: sticky; top: 1.5rem;">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 py-3.5 px-4 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
            <i class="bi bi-phone text-primary"></i>
            <span>모바일 미리보기</span>
          </h5>
          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace py-1 px-2.5" id="mockupBadge" style="font-size: 0.72rem;">SMS</span>
        </div>

        <div class="card-body p-4 d-flex flex-column align-items-center justify-content-center bg-light-subtle rounded-bottom-3">
          
          <!-- 스마트폰 실물 디바이스 목업 (330px 사이즈) -->
          <div class="compact-phone-mockup shadow rounded-4 p-3 border border-3 border-dark bg-dark mb-3.5">
            <!-- Notch & Speaker -->
            <div class="d-flex justify-content-center align-items-center gap-2 mb-2.5">
              <div class="bg-secondary rounded-pill" style="width: 56px; height: 4px;"></div>
              <div class="rounded-circle bg-secondary" style="width: 6px; height: 6px;"></div>
            </div>

            <!-- Phone Screen Content -->
            <div class="compact-screen bg-white rounded-3 p-3 d-flex flex-column">
              
              <!-- Screen Header (Carrier & Sender Info) -->
              <div class="border-bottom pb-2 mb-2.5 text-center">
                <div class="d-flex justify-content-between text-muted mb-1.5" style="font-size: 0.74rem;">
                  <span><i class="bi bi-reception-4 me-0.5"></i>KT</span>
                  <span id="mockupClock">오후 12:00</span>
                  <span><i class="bi bi-battery-full"></i> 100%</span>
                </div>
                <div class="fw-bold text-dark mt-1" style="font-size: 0.92rem;">
                  <i class="bi bi-chat-fill text-primary me-1"></i>KT몰 메시지
                </div>
                <div class="text-secondary font-monospace mt-0.5" style="font-size: 0.82rem;" id="mockupReceiverDisplay">
                  010-0000-0001
                </div>
                <div class="badge bg-light text-dark border small mt-1 py-1 px-2.5" style="font-size: 0.74rem;" id="mockupSenderDisplay">
                  발신: <%= (aligoConfig && aligoConfig.sender) ? aligoConfig.sender : '02-805-1999' %>
                </div>
              </div>

              <!-- Message Title Box (LMS 전용) -->
              <div class="p-2.5 mb-2.5 rounded bg-light border-start border-3 border-primary fw-bold text-dark small" id="mockupTitleBox" style="font-size: 0.82rem; word-break: break-all;">
                [KT몰] 개통 안내
              </div>

              <!-- Message Bubble -->
              <div class="compact-bubble bg-light p-3 rounded-3 border mb-2.5 text-start flex-grow-1" 
                   id="mockupContentBubble">
                문자 메시지 내용이 여기에 실시간으로 표시됩니다.
              </div>

              <!-- Bottom Byte Meter Bar -->
              <div class="mt-auto pt-2.5 border-top">
                <div class="d-flex justify-content-between align-items-center small mb-1" style="font-size: 0.72rem;">
                  <span class="text-muted">용량:</span>
                  <span class="fw-bold text-dark" id="mockupByteStatus">0 / 90 Byte (SMS)</span>
                </div>
                <div class="progress" style="height: 5px;">
                  <div class="progress-bar bg-primary" role="progressbar" id="mockupProgressBar" style="width: 10%;"></div>
                </div>
              </div>

            </div>
          </div>

          <!-- 발송 실행 버튼 (목업 너비 330px 매칭) -->
          <div class="w-100" style="max-width: 330px;">
            <button type="button" class="btn btn-primary w-100 py-2.5 shadow-sm fw-bold fs-6 d-flex align-items-center justify-content-center gap-2 mt-2" 
                    id="btnExecuteSend" onclick="executeAligoSend()">
              <i class="bi bi-send-fill"></i>
              <span id="btnExecuteSendText">Aligo 문자 발송 실행</span>
            </button>

            <!-- 발송 결과 피드백 카드 영역 -->
            <div id="sendResultFeedbackArea" class="mt-3.5 d-none"></div>

            <!-- 하단 알리고 계정 잔여량 위젯 카드 -->
            <div class="card border bg-white mt-3.5 shadow-xs">
              <div class="card-body p-3 d-flex justify-content-between align-items-center">
                <div>
                  <small class="text-muted d-block" style="font-size: 0.72rem;">Aligo 잔여 발송 건수</small>
                  <span class="fw-bold text-dark font-monospace" id="cardRemainDisplay" style="font-size: 0.82rem;">
                    SMS: <%= (remainInfo && remainInfo.SMS_CNT) ? Number(remainInfo.SMS_CNT).toLocaleString() : 0 %>건 |
                    LMS: <%= (remainInfo && remainInfo.LMS_CNT) ? Number(remainInfo.LMS_CNT).toLocaleString() : 0 %>건
                  </span>
                </div>
                <button type="button" class="btn btn-xs btn-outline-secondary py-1 px-2.5" onclick="checkAligoRemain(true)" style="font-size: 0.74rem;">
                  <i class="bi bi-arrow-clockwise"></i> 새로고침
                </button>
              </div>
            </div>

          </div>

        </div>
      </div>
    </div>

  </div>
</main>

