<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
    <div>
      <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
        <h1 class="h3 fw-bold mb-0 d-flex align-items-center gap-2">
          <i class="bi <%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_icon) ? currentMenu.menu_icon : 'bi-chat-dots-fill' %> text-primary"></i>
          <span><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : '문자 관리' %></span>
        </h1>
        <% if (aligoConfig && aligoConfig.apiKey && aligoConfig.sender) { %>
          <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1" data-bs-toggle="tooltip" title="Aligo SMS API 연동 정상 구동 중">
            <i class="bi bi-broadcast me-1"></i>Aligo 연동 활성 <%= aligoConfig.testmodeYn === 'Y' ? '(테스트모드: 건수 미차감)' : '(운영 발송 모드)' %>
          </span>
        <% } else { %>
          <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2.5 py-1" data-bs-toggle="tooltip" title="상단 [Aligo 연동 설정] 버튼을 클릭해 API 키와 발신번호를 등록하세요.">
            <i class="bi bi-key-fill me-1"></i>Aligo API 키 미등록 (설정 필요)
          </span>
        <% } %>
      </div>
      <p class="text-muted small mb-0">Aligo 공식 규격 기반 실시간 문자 발송 및 고객 개통 조건별 자동 스케줄 발송을 관리합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <!-- Aligo API Config Button -->
      <button type="button" class="btn btn-sm btn-outline-dark d-flex align-items-center gap-1 shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAligoConfig">
        <i class="bi bi-gear-fill text-secondary"></i>
        <span>Aligo 연동 설정</span>
      </button>
      <button type="button" class="btn btn-sm btn-light border shadow-xs" onclick="checkAligoRemain()">
        <i class="bi bi-wallet2 text-primary me-1"></i>잔여 건수 조회
      </button>
      <a href="/notifications/history" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-clock-history me-1"></i>발송 이력
      </a>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="location.reload()">
        <i class="bi bi-arrow-clockwise"></i> 새로고침
      </button>
    </div>
  </div>

  <!-- Aligo Live Status Banner -->
  <div class="alert alert-primary bg-primary-subtle border-0 shadow-sm d-flex align-items-center justify-content-between flex-wrap gap-2 py-2 px-3 mb-3 rounded-3 text-dark">
    <div class="d-flex align-items-center gap-2">
      <i class="bi bi-info-circle-fill text-primary fs-5 flex-shrink-0"></i>
      <div class="small">
        <strong>[Aligo API 연동 상태]</strong>
        <% if (aligoConfig && aligoConfig.apiKey && aligoConfig.sender) { %>
          발신번호(<code><%= aligoConfig.sender %></code>), 계정 ID(<code><%= aligoConfig.userId %></code>)가 정상 등록되어 있습니다.
          좌측에서 템플릿을 선택하거나 직접 작성하여 우측 모바일 화면에서 즉시 발송 테스트를 진행하세요.
        <% } else { %>
          계정 ID, API Key, 인증된 발신번호가 아직 설정되지 않았습니다. 
          상단의 <strong>[Aligo 연동 설정]</strong> 버튼을 눌러 계정 정보를 입력하시면 즉시 실전송이 가능합니다.
        <% } %>
      </div>
    </div>
    <div class="d-flex align-items-center gap-2">
      <span class="badge bg-white text-dark border px-2 py-1 small" id="topRemainBadge">
        SMS: <%= (remainInfo && remainInfo.SMS_CNT) ? Number(remainInfo.SMS_CNT).toLocaleString() : 0 %>건 |
        LMS: <%= (remainInfo && remainInfo.LMS_CNT) ? Number(remainInfo.LMS_CNT).toLocaleString() : 0 %>건
      </span>
    </div>
  </div>

  <style>
    /* 6.5 : 3.5 간격 비율 레이아웃 */
    @media (min-width: 992px) {
      .col-sms-left {
        flex: 0 0 65%;
        max-width: 65%;
        width: 65%;
      }
      .col-sms-right {
        flex: 0 0 35%;
        max-width: 35%;
        width: 35%;
      }
    }
    @media (max-width: 991.98px) {
      .col-sms-left, .col-sms-right {
        flex: 0 0 100%;
        max-width: 100%;
        width: 100%;
      }
      .col-sms-right {
        margin-top: 1.5rem;
      }
    }

    /* 컴팩트 스마트폰 목업 */
    .compact-phone-mockup {
      width: 100%;
      max-width: 295px;
      min-height: 440px;
    }
    .compact-screen {
      min-height: 400px;
    }
    .compact-bubble {
      font-size: 0.76rem;
      line-height: 1.45;
      min-height: 150px;
      max-height: 230px;
      overflow-y: auto;
    }
  </style>

  <!-- ======================================================== -->
  <!-- MAIN SPLIT VIEW: 좌측 65% VS 우측 35% 분할 레이아웃 -->
  <!-- ======================================================== -->
  <div class="row g-3 align-items-start">
    
    <!-- ====================================================== -->
    <!-- LEFT COLUMN (65%): 템플릿 목록 및 발송 메시지 파라미터 빌더 -->
    <!-- ====================================================== -->
    <div class="col-sms-left">
      
      <!-- 1. 템플릿 목록 카드 (Template List) -->
      <div class="card border-0 shadow-sm rounded-3 mb-3">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <div>
            <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
              <i class="bi bi-collection-fill text-primary"></i>
              <span>문자 템플릿 목록</span>
              <span class="badge bg-primary-subtle text-primary ms-1" id="templateCountBadge"><%= templates.length %>건</span>
            </h5>
            <small class="text-muted" style="font-size: 0.75rem;">원하는 템플릿을 클릭하면 우측 스마트폰 화면에 즉시 로딩됩니다.</small>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-xs btn-outline-primary py-1 px-2.5 d-flex align-items-center gap-1 shadow-xs" onclick="openTemplateModal()">
              <i class="bi bi-plus-circle-fill"></i>
              <span>신규 템플릿 등록</span>
            </button>
            <button type="button" class="btn btn-xs btn-outline-dark py-1 px-2.5 d-flex align-items-center gap-1" onclick="selectDirectInput()">
              <i class="bi bi-pencil-square"></i>
              <span>직접 새로 작성</span>
            </button>
          </div>
        </div>

        <!-- 필터 & 검색 바 -->
        <div class="px-3 pb-2 pt-1 border-bottom bg-light-subtle">
          <div class="row g-2">
            <div class="col-md-4">
              <select class="form-select form-select-sm" id="filterCondition" onchange="filterTemplates()">
                <option value="">전체 발송조건</option>
                <option value="D_DAY">개통 당일 (D-Day)</option>
                <option value="AFTER_D">개통 후 N일차 (D+)</option>
                <option value="BEFORE_D">약정 만료 전 (D-)</option>
              </select>
            </div>
            <div class="col-md-8">
              <div class="input-group input-group-sm">
                <input type="text" class="form-control" id="searchKeyword" placeholder="템플릿명, 키워드 검색..." onkeyup="filterTemplates()">
                <button class="btn btn-outline-secondary" type="button" onclick="filterTemplates()">
                  <i class="bi bi-search"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- 템플릿 리스트 테이블 (넓어진 65% 공간 활용) -->
        <div class="card-body p-0">
          <div class="table-responsive" style="max-height: 290px; overflow-y: auto;">
            <table class="table table-hover align-middle mb-0" id="templateTable">
              <thead class="table-light sticky-top small" style="z-index: 1;">
                <tr>
                  <th scope="col" class="text-center" style="width: 45px;">선택</th>
                  <th scope="col" class="text-center" style="width: 60px;">유형</th>
                  <th scope="col">템플릿명 (코드)</th>
                  <th scope="col" style="width: 140px;">발송 조건</th>
                  <th scope="col" style="width: 130px;">발송 주기 및 시간</th>
                  <th scope="col" class="text-center" style="width: 70px;">상태</th>
                  <th scope="col" class="text-center" style="width: 75px;">관리</th>
                </tr>
              </thead>
              <tbody id="templateListBody">
                <% if (templates && templates.length > 0) { %>
                  <% templates.forEach((t, idx) => { %>
                    <tr class="template-row <%= idx === 0 ? 'table-active border-primary' : '' %>" 
                        id="tplRow_<%= t.id %>" 
                        style="cursor: pointer;" 
                        onclick="onSelectTemplateRow(<%= t.id %>)">
                      <td class="text-center">
                        <input class="form-check-input" type="radio" name="selectedTemplateRadio" id="radioTpl_<%= t.id %>" value="<%= t.id %>" <%= idx === 0 ? 'checked' : '' %>>
                      </td>
                      <td class="text-center">
                        <% if (t.msg_type === 'SMS') { %>
                          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace" style="font-size: 0.68rem;">SMS</span>
                        <% } else { %>
                          <span class="badge bg-primary-subtle text-primary border border-primary-subtle font-monospace" style="font-size: 0.68rem;">LMS</span>
                        <% } %>
                      </td>
                      <td>
                        <strong class="text-dark d-block small"><%= t.template_name %></strong>
                        <code class="text-muted small" style="font-size: 0.7rem;"><%= t.template_code %></code>
                      </td>
                      <td>
                        <span class="badge bg-light text-dark border font-monospace py-0.5 px-1.5" style="font-size: 0.7rem;">
                          <%= t.condition_desc || t.condition_type %>
                        </span>
                      </td>
                      <td>
                        <div class="small text-dark font-monospace" style="font-size: 0.72rem;">
                          <i class="bi bi-clock me-1 text-secondary"></i><%= t.send_time %>
                        </div>
                        <div class="text-muted small" style="font-size: 0.68rem;"><%= t.send_cycle_desc || t.send_cycle %></div>
                      </td>
                      <td class="text-center" onclick="event.stopPropagation()">
                        <button type="button" class="btn btn-xs <%= t.use_yn === 'Y' ? 'btn-success' : 'btn-danger' %> py-0.5 px-2 fw-semibold shadow-xs" 
                                onclick="toggleTemplateUse(<%= t.id %>, this)">
                          <%= t.use_yn === 'Y' ? 'USE' : 'HIDE' %>
                        </button>
                      </td>
                      <td class="text-center" onclick="event.stopPropagation()">
                        <div class="btn-group btn-group-sm">
                          <button type="button" class="btn btn-xs btn-outline-secondary py-0 px-1.5" title="템플릿 속성 수정" onclick="editTemplateModal(<%= t.id %>)">
                            <i class="bi bi-pencil"></i>
                          </button>
                          <button type="button" class="btn btn-xs btn-outline-danger py-0 px-1.5" title="삭제" onclick="deleteTemplate(<%= t.id %>, '<%= t.template_name %>')">
                            <i class="bi bi-trash"></i>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="text-center py-4 text-muted small">등록된 템플릿이 없습니다.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 2. 메시지 빌더 및 Aligo 발송 설정 카드 (Message Builder) -->
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
            <i class="bi bi-sliders text-primary"></i>
            <span>메시지 내용 및 발송 설정 (Aligo 규격)</span>
          </h5>
          <span class="badge bg-secondary-subtle text-secondary font-monospace" id="currentLoadedTplName">템플릿 로드됨</span>
        </div>

        <div class="card-body p-3 pt-2">
          <!-- 숨겨진 필드: 현재 선택된 템플릿 ID 및 코드 -->
          <input type="hidden" id="activeTemplateId" value="<%= (templates && templates.length > 0) ? templates[0].id : '' %>">
          <input type="hidden" id="activeTemplateCode" value="<%= (templates && templates.length > 0) ? templates[0].template_code : 'TEST_DIRECT' %>">

          <!-- 수신 번호 & 발신 번호 행 -->
          <div class="row g-2 mb-3">
            <div class="col-md-7">
              <label class="form-label small fw-semibold text-secondary d-flex justify-content-between mb-1">
                <span>수신 번호 (Receiver) <span class="text-danger">*</span></span>
                <span class="text-muted" style="font-size: 0.7rem;">숫자만 입력 시 자동 하이픈 (컴마 다중 가능)</span>
              </label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-secondary"><i class="bi bi-telephone-fill"></i></span>
                <input type="text" class="form-control font-monospace" id="sendReceiverInput" value="010-9876-5432" 
                       placeholder="숫자 연속 입력 (예: 01012345678)" 
                       data-format="phone"
                       oninput="onReceiverInputChange()"
                       onblur="onReceiverBlur(this)">
              </div>
            </div>
            <div class="col-md-5">
              <label class="form-label small fw-semibold text-secondary mb-1">발신 번호 (Sender)</label>
              <div class="input-group input-group-sm">
                <span class="input-group-text bg-light text-secondary"><i class="bi bi-broadcast-pin"></i></span>
                <input type="text" class="form-control font-monospace bg-light" id="sendSenderInput" value="02-805-1999" readonly>
              </div>
            </div>
          </div>

          <!-- LMS 제목 입력란 (LMS일 때만 필수/활성) -->
          <div class="mb-3" id="titleGroupWrapper">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label small fw-semibold text-secondary mb-0">
                메시지 제목 (LMS 장문 시 표출)
              </label>
              <span class="text-muted" style="font-size: 0.72rem;">
                <strong id="titleByteCount" class="text-dark">0</strong> / 44 Byte
              </span>
            </div>
            <input type="text" class="form-control form-control-sm" id="sendTitleInput" 
                   value="<%= (templates && templates.length > 0 && templates[0].title) ? templates[0].title : '[KT몰] 개통 안내' %>" 
                   placeholder="[KT몰] LMS 메시지 상단 제목 (최대 44Byte)" 
                   oninput="onTitleInputChange()">
          </div>

          <!-- 메시지 본문 입력란 -->
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <label class="form-label small fw-semibold text-secondary mb-0">
                메시지 본문 (Msg) <span class="text-danger">*</span>
              </label>
              <div class="d-flex align-items-center gap-2">
                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" id="msgTypeBadge">SMS</span>
                <span class="text-muted small" style="font-size: 0.74rem;">
                  <strong id="contentByteCount" class="text-dark">0</strong> / 2,000 Byte (<span id="contentCharCount">0</span>자)
                </span>
              </div>
            </div>
            <textarea class="form-control font-monospace" id="sendContentInput" rows="5" 
                      style="font-size: 0.83rem; line-height: 1.45;" 
                      placeholder="문자 메시지 내용을 입력하세요..." 
                      oninput="onContentInputChange()"><%= (templates && templates.length > 0) ? templates[0].content : '' %></textarea>
            
            <!-- 치환 변수 원클릭 삽입 버튼 툴바 -->
            <div class="d-flex flex-wrap align-items-center gap-1.5 mt-2 p-2 bg-light rounded border">
              <span class="small fw-semibold text-secondary me-1" style="font-size: 0.72rem;">치환 변수 삽입:</span>
              <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-1.5" onclick="insertVariableToContent('#{고객명}')">#{고객명}</button>
              <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-1.5" onclick="insertVariableToContent('#{개통번호}')">#{개통번호}</button>
              <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-1.5" onclick="insertVariableToContent('#{단말기명}')">#{단말기명}</button>
              <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-1.5" onclick="insertVariableToContent('#{개통일자}')">#{개통일자}</button>
              <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-1.5" onclick="insertVariableToContent('#{할부원금}')">#{할부원금}</button>
              <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-1.5" onclick="insertVariableToContent('#{요금제}')">#{요금제}</button>
            </div>
          </div>

          <!-- 치환 변수 실시간 매핑 샘플 값 (우측 모바일 화면에 즉시 치환 반영) -->
          <div class="card border bg-light mb-3">
            <div class="card-body p-2.5">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="badge bg-secondary-subtle text-dark border font-monospace" style="font-size: 0.7rem;">치환 변수 실시간 미리보기 값</span>
                <small class="text-muted" style="font-size: 0.7rem;">수정 즉시 우측 모바일 화면에 치환 반영됩니다</small>
              </div>
              <div class="row g-2">
                <div class="col-6 col-sm-3">
                  <label class="form-label small text-muted mb-0" style="font-size: 0.7rem;">#{고객명}</label>
                  <input type="text" class="form-control form-control-sm" id="varSampleName" value="홍길동" placeholder="고객명 입력" oninput="updateMobileMockup()">
                </div>
                <div class="col-6 col-sm-3">
                  <label class="form-label small text-muted mb-0" style="font-size: 0.7rem;">#{단말기명}</label>
                  <input type="text" class="form-control form-control-sm" id="varSampleModel" value="갤럭시 S25 Ultra" placeholder="단말기명" oninput="updateMobileMockup()">
                </div>
                <div class="col-6 col-sm-3">
                  <label class="form-label small text-muted mb-0 d-flex justify-content-between" style="font-size: 0.7rem;">
                    <span>#{개통일자}</span>
                    <span class="text-secondary" style="font-size: 0.65rem;">YYYY-MM-DD</span>
                  </label>
                  <input type="text" class="form-control form-control-sm font-monospace" id="varSampleDate" value="2026-11-07" 
                         placeholder="예: 20261107" 
                         data-format="date"
                         onfocus="this.value = AppFormatters.rawDigits(this.value)"
                         onblur="this.value = AppFormatters.formatBirthOrDate(this.value); updateMobileMockup();"
                         oninput="updateMobileMockup()">
                </div>
                <div class="col-6 col-sm-3">
                  <label class="form-label small text-muted mb-0 d-flex justify-content-between" style="font-size: 0.7rem;">
                    <span>#{할부원금}</span>
                    <span class="text-secondary" style="font-size: 0.65rem;">원단위 쉼표</span>
                  </label>
                  <input type="text" class="form-control form-control-sm font-monospace text-end" id="varSamplePrice" value="850,000" 
                         placeholder="예: 7000 또는 850000" 
                         data-format="currency"
                         onfocus="this.value = AppFormatters.rawDigits(this.value)"
                         onblur="this.value = AppFormatters.formatCurrency(this.value, false); updateMobileMockup();"
                         oninput="updateMobileMockup()">
                </div>
              </div>
            </div>
          </div>

          <!-- Aligo 발송 옵션: 예약 발송(rdate/rtime) 및 발송 모드(testmode_yn) -->
          <div class="border rounded p-2.5 bg-white mb-2">
            <div class="row g-2 align-items-center">
              <div class="col-md-6 border-end-md">
                <div class="form-check form-switch mb-1">
                  <input class="form-check-input" type="checkbox" id="chkReservation" onchange="toggleReservationInputs(this.checked)">
                  <label class="form-check-label small fw-semibold text-secondary" for="chkReservation">
                    예약 발송 설정 (Aligo rdate/rtime)
                  </label>
                </div>
                <div class="row g-1 d-none" id="reservationInputArea">
                  <div class="col-6">
                    <input type="date" class="form-control form-control-sm" id="sendRdate">
                  </div>
                  <div class="col-6">
                    <input type="time" class="form-control form-control-sm" id="sendRtime">
                  </div>
                  <div class="col-12">
                    <small class="text-muted" style="font-size: 0.68rem;">* 현재 시간 기준 10분 이후 시간으로 지정해야 합니다.</small>
                  </div>
                </div>
              </div>

              <div class="col-md-6 ps-md-3">
                <label class="form-label small fw-semibold text-secondary mb-1">발송 모드</label>
                <div class="d-flex gap-2">
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="sendTestmodeRadio" id="modeTest" value="Y" checked>
                    <label class="form-check-label small" for="modeTest">
                      <strong>테스트 모드</strong> <span class="text-muted" style="font-size: 0.7rem;">(건수 미차감)</span>
                    </label>
                  </div>
                  <div class="form-check">
                    <input class="form-check-input" type="radio" name="sendTestmodeRadio" id="modeProd" value="N">
                    <label class="form-check-label small text-danger" for="modeProd">
                      <strong>실제 발송</strong> <span class="text-muted" style="font-size: 0.7rem;">(1건 차감)</span>
                    </label>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- ====================================================== -->
    <!-- RIGHT COLUMN (35%): 컴팩트 모바일 Sample 디바이스 목업 & 즉시 발송 컨트롤 -->
    <!-- ====================================================== -->
    <div class="col-sms-right" style="position: sticky; top: 1.5rem;">
      <div class="card border-0 shadow-sm rounded-3">
        <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-1.5" style="font-size: 0.88rem !important;">
            <i class="bi bi-phone text-primary"></i>
            <span>모바일 화면 (Sample)</span>
          </h5>
          <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace" id="mockupBadge" style="font-size: 0.68rem;">SMS</span>
        </div>

        <div class="card-body p-3 d-flex flex-column align-items-center justify-content-center bg-light-subtle rounded-bottom-3">
          
          <!-- 스마트폰 실물 디바이스 목업 (컴팩트 295px 사이즈) -->
          <div class="compact-phone-mockup shadow rounded-4 p-2.5 border border-3 border-dark bg-dark mb-2.5">
            <!-- Notch & Speaker -->
            <div class="d-flex justify-content-center align-items-center gap-1.5 mb-1.5">
              <div class="bg-secondary rounded-pill" style="width: 48px; height: 4px;"></div>
              <div class="rounded-circle bg-secondary" style="width: 5px; height: 5px;"></div>
            </div>

            <!-- Phone Screen Content -->
            <div class="compact-screen bg-white rounded-3 p-2.5 d-flex flex-column">
              
              <!-- Screen Header (Carrier & Sender Info) -->
              <div class="border-bottom pb-1.5 mb-2 text-center">
                <div class="d-flex justify-content-between text-muted mb-1" style="font-size: 0.62rem;">
                  <span><i class="bi bi-reception-4 me-0.5"></i>KT</span>
                  <span id="mockupClock">오후 12:00</span>
                  <span><i class="bi bi-battery-full"></i> 100%</span>
                </div>
                <div class="fw-bold small text-dark mt-0.5" style="font-size: 0.78rem;">
