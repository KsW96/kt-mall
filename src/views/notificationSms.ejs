          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">LMS 제목</label>
            <input type="text" class="form-control form-control-sm" id="editModalTitleInput" placeholder="[KT몰] 제목 입력 (LMS인 경우)">
          </div>

          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">메시지 본문 내용 <span class="text-danger">*</span></label>
            <textarea class="form-control form-control-sm font-monospace" id="editModalContentInput" rows="6" placeholder="문자 메시지 내용을 작성하세요..." required></textarea>
