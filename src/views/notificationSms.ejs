<!-- 클라이언트 인터랙션 및 Aligo 연동 스크립트 -->
<!-- ======================================================== -->
<script>
  // 서버로부터 전달받은 템플릿 원본 데이터
  const templatesData = <%- JSON.stringify(templates || []) %>;
  let activeTemplate = templatesData.length > 0 ? templatesData[0] : null;

  document.addEventListener('DOMContentLoaded', () => {
    // 실시간 시계 표시
    updateClock();
    setInterval(updateClock, 30000);

    // 초기 화면 바인딩
    if (activeTemplate) {
      loadTemplateIntoBuilder(activeTemplate);
    } else {
      updateMobileMockup();
    }
  });

  function updateClock() {
    const now = new Date();
    const hours = now.getHours();
    const minutes = String(now.getMinutes()).padStart(2, '0');
    const ampm = hours >= 12 ? '오후' : '오전';
    const displayHour = hours % 12 || 12;
    const clockEl = document.getElementById('mockupClock');
    if (clockEl) clockEl.textContent = `${ampm} ${displayHour}:${minutes}`;
  }

  // 바이트 수 계산 (한글 2Byte, 영문/기호 1Byte - EUC-KR 규격)
  function calculateBytes(str) {
    if (!str) return 0;
    let bytes = 0;
    for (let i = 0; i < str.length; i++) {
      const code = str.charCodeAt(i);
      bytes += (code > 128) ? 2 : 1;
    }
    return bytes;
  }

  // 템플릿 행 클릭 시 선택 로직
  function onSelectTemplateRow(id) {
    const t = templatesData.find(item => item.id === id);
    if (!t) return;

    activeTemplate = t;

    // 테이블 행 스타일 갱신
    document.querySelectorAll('.template-row').forEach(r => r.classList.remove('table-active', 'border-primary'));
    const targetRow = document.getElementById('tplRow_' + id);
    if (targetRow) targetRow.classList.add('table-active', 'border-primary');

    const radio = document.getElementById('radioTpl_' + id);
    if (radio) radio.checked = true;

    // 빌더 및 모바일 목업에 로드
    loadTemplateIntoBuilder(t);
  }

  // 빌더 폼에 템플릿 데이터 채우기
  function loadTemplateIntoBuilder(t) {
    document.getElementById('activeTemplateId').value = t.id || '';
    document.getElementById('activeTemplateCode').value = t.template_code || 'TEST_DIRECT';
    document.getElementById('currentLoadedTplName').textContent = `템플릿: ${t.template_name}`;

    const titleInput = document.getElementById('sendTitleInput');
    titleInput.value = t.title || (t.msg_type === 'LMS' ? '[KT몰] 안내' : '');

    const contentInput = document.getElementById('sendContentInput');
    contentInput.value = t.content || '';

    updateMobileMockup();
  }

  // 직접 새로 작성 모드
  function selectDirectInput() {
    activeTemplate = null;
    document.querySelectorAll('.template-row').forEach(r => r.classList.remove('table-active', 'border-primary'));
    document.querySelectorAll('input[name="selectedTemplateRadio"]').forEach(radio => radio.checked = false);

    document.getElementById('activeTemplateId').value = '';
    document.getElementById('activeTemplateCode').value = 'TEST_DIRECT';
    document.getElementById('currentLoadedTplName').textContent = '직접 새로 작성';

    document.getElementById('sendTitleInput').value = '[KT몰] 안내';
    document.getElementById('sendContentInput').value = '';
    document.getElementById('sendContentInput').focus();

    updateMobileMockup();
  }

  // 수신 번호 입력 및 blur 핸들러
  function onReceiverInputChange() {
    updateMobileMockup();
  }

  function onReceiverBlur(el) {
    if (window.AppFormatters) {
      el.value = AppFormatters.formatPhone(el.value);
    }
    updateMobileMockup();
  }

  // 제목 입력 시 이벤트
  function onTitleInputChange() {
    updateMobileMockup();
  }

  // 치환 변수 삽입
  function insertVariableToContent(v) {
    const area = document.getElementById('sendContentInput');
    const start = area.selectionStart;
    const end = area.selectionEnd;
    const text = area.value;
    area.value = text.substring(0, start) + v + text.substring(end);
    area.focus();
    area.selectionStart = area.selectionEnd = start + v.length;
    updateMobileMockup();
  }

  // 모바일 목업 및 바이트 계산 실시간 업데이트
  function updateMobileMockup() {
    const rawReceiver = document.getElementById('sendReceiverInput').value.trim() || '010-9876-5432';
    const sender = document.getElementById('sendSenderInput').value.trim() || '02-805-1999';
    let title = document.getElementById('sendTitleInput').value.trim();
    let rawContent = document.getElementById('sendContentInput').value;

    // 전화번호 포맷팅 (01012345678 -> 010-1234-5678)
    const formattedReceiver = window.AppFormatters ? AppFormatters.formatPhone(rawReceiver) : rawReceiver;

    // 제목 바이트 계산
    const titleBytes = calculateBytes(title);
    document.getElementById('titleByteCount').textContent = titleBytes;

    // 치환 변수 매핑 값 (입력 시 숫자로 들어와도 표출 시 상황별 자동 포맷팅)
    const sampleName = document.getElementById('varSampleName').value.trim() || '홍길동';
    const sampleModel = document.getElementById('varSampleModel').value.trim() || '갤럭시 S25 Ultra';
    
    // 생년월일 / 개통일자 (20261107 -> 2026-11-07)
    const rawDate = document.getElementById('varSampleDate').value.trim() || '2026-11-07';
    const sampleDate = window.AppFormatters ? AppFormatters.formatBirthOrDate(rawDate) : rawDate;

    // 금액 (7000 -> 7,000, 850000 -> 850,000)
    const rawPrice = document.getElementById('varSamplePrice').value.trim() || '850,000';
    const samplePrice = window.AppFormatters ? AppFormatters.formatCurrency(rawPrice, false) : rawPrice;

    // 본문 내 변수 치환
    let renderedContent = rawContent
      .replace(/#\{고객명\}|\{NAME\}|\{고객명\}/gi, sampleName)
      .replace(/#\{개통번호\}|\{PHONE\}|\{개통번호\}/gi, formattedReceiver)
      .replace(/#\{단말기명\}|\{MODEL\}|\{단말기명\}/gi, sampleModel)
      .replace(/#\{개통일자\}|\{DATE\}|\{개통일자\}/gi, sampleDate)
      .replace(/#\{할부원금\}|\{PRICE\}|\{할부원금\}/gi, samplePrice)
      .replace(/#\{요금제\}|\{PLAN\}|\{요금제\}/gi, '5G 베이직');

    // 바이트 계산 (치환 후 기준)
    const contentBytes = calculateBytes(renderedContent);
    const contentChars = renderedContent.length;
    const isLms = contentBytes > 90;

    // 좌측 빌더 뱃지 갱신
    const msgTypeBadge = document.getElementById('msgTypeBadge');
    msgTypeBadge.textContent = isLms ? 'LMS' : 'SMS';
    msgTypeBadge.className = isLms 
      ? 'badge bg-primary-subtle text-primary border border-primary-subtle' 
      : 'badge bg-info-subtle text-info-emphasis border border-info-subtle';

    document.getElementById('contentByteCount').textContent = contentBytes;
    document.getElementById('contentCharCount').textContent = contentChars;

    // 우측 모바일 목업에 반영
    document.getElementById('mockupReceiverDisplay').textContent = formattedReceiver;
    document.getElementById('mockupSenderDisplay').textContent = `발신: ${sender}`;

    const mockupBadge = document.getElementById('mockupBadge');
    mockupBadge.textContent = isLms ? 'LMS (장문)' : 'SMS (단문)';
    mockupBadge.className = isLms 
      ? 'badge bg-primary-subtle text-primary border border-primary-subtle font-monospace' 
      : 'badge bg-info-subtle text-info-emphasis border border-info-subtle font-monospace';

    // LMS 제목 박스 표시 여부
    const mockupTitleBox = document.getElementById('mockupTitleBox');
    if (isLms) {
      mockupTitleBox.classList.remove('d-none');
      mockupTitleBox.textContent = title || '[KT몰] 알림';
    } else {
      mockupTitleBox.classList.add('d-none');
    }

    // 본문 말풍선
    const bubble = document.getElementById('mockupContentBubble');
    bubble.textContent = renderedContent || '(메시지 본문 내용을 입력하세요)';

    // 바이트 게이지 바
    const maxBytes = isLms ? 2000 : 90;
    const percentage = Math.min(100, Math.round((contentBytes / maxBytes) * 100));
    document.getElementById('mockupByteStatus').textContent = `${contentBytes} / ${maxBytes} Byte (${isLms ? 'LMS' : 'SMS'})`;
    const progressBar = document.getElementById('mockupProgressBar');
    progressBar.style.width = `${percentage}%`;
    progressBar.className = isLms ? 'progress-bar bg-primary' : 'progress-bar bg-info';
  }

  // 예약 발송 체크박스 토글
  function toggleReservationInputs(checked) {
    const area = document.getElementById('reservationInputArea');
    if (checked) {
      area.classList.remove('d-none');
      // 기본값 세팅 (현재 시간 + 15분)
      const now = new Date(Date.now() + 15 * 60 * 1000);
      const yyyy = now.getFullYear();
      const mm = String(now.getMonth() + 1).padStart(2, '0');
      const dd = String(now.getDate()).padStart(2, '0');
      const hh = String(now.getHours()).padStart(2, '0');
      const min = String(now.getMinutes()).padStart(2, '0');
      document.getElementById('sendRdate').value = `${yyyy}-${mm}-${dd}`;
      document.getElementById('sendRtime').value = `${hh}:${min}`;
    } else {
      area.classList.add('d-none');
      document.getElementById('sendRdate').value = '';
      document.getElementById('sendRtime').value = '';
    }
  }

  // 템플릿 필터링 (검색 & 조건)
  function filterTemplates() {
    const keyword = document.getElementById('searchKeyword').value.toLowerCase().trim();
    const cond = document.getElementById('filterCondition').value;

    const rows = document.querySelectorAll('#templateListBody tr.template-row');
    let visibleCount = 0;

    rows.forEach(r => {
      const text = r.textContent.toLowerCase();
      let match = true;
      if (keyword && !text.includes(keyword)) match = false;
      if (cond && !r.innerHTML.includes(cond)) match = false;

      r.style.display = match ? '' : 'none';
      if (match) visibleCount++;
    });

    document.getElementById('templateCountBadge').textContent = `${visibleCount}건`;
  }

  // ========================================================
  // Aligo 문자 발송 실행 (sms_sample 규격 POST 전송)
  // ========================================================
  async function executeAligoSend() {
    const receiver = document.getElementById('sendReceiverInput').value.trim();
    const title = document.getElementById('sendTitleInput').value.trim();
    const rawContent = document.getElementById('sendContentInput').value;
    const templateCode = document.getElementById('activeTemplateCode').value || 'TEST_DIRECT';

    if (!receiver) {
      alert('수신 번호를 입력해 주세요.');
      document.getElementById('sendReceiverInput').focus();
      return;
    }
    if (!rawContent || !rawContent.trim()) {
      alert('발송할 메시지 본문을 입력해 주세요.');
      document.getElementById('sendContentInput').focus();
      return;
    }

    // 치환 변수 적용된 본문 생성
    const sampleName = document.getElementById('varSampleName').value.trim() || '홍길동';
    const sampleModel = document.getElementById('varSampleModel').value.trim() || '갤럭시 S25 Ultra';
    const sampleDate = document.getElementById('varSampleDate').value.trim() || '2026-11-07';
    const samplePrice = document.getElementById('varSamplePrice').value.trim() || '850,000';

    const finalContent = rawContent
      .replace(/#\{고객명\}|\{NAME\}|\{고객명\}/gi, sampleName)
      .replace(/#\{개통번호\}|\{PHONE\}|\{개통번호\}/gi, receiver)
      .replace(/#\{단말기명\}|\{MODEL\}|\{단말기명\}/gi, sampleModel)
      .replace(/#\{개통일자\}|\{DATE\}|\{개통일자\}/gi, sampleDate)
      .replace(/#\{할부원금\}|\{PRICE\}|\{할부원금\}/gi, samplePrice)
      .replace(/#\{요금제\}|\{PLAN\}|\{요금제\}/gi, '5G 베이직');

    // 예약 발송 파라미터
    const isReserved = document.getElementById('chkReservation').checked;
    let rdate = '';
    let rtime = '';
    if (isReserved) {
      rdate = document.getElementById('sendRdate').value.trim();
      rtime = document.getElementById('sendRtime').value.trim();
      if (!rdate || !rtime) {
        alert('예약 발송 일자와 시간을 모두 지정해 주세요.');
        return;
      }
    }

    // 발송 모드 (Y: 테스트, N: 실제)
    const testmode = document.querySelector('input[name="sendTestmodeRadio"]:checked').value;

    const btn = document.getElementById('btnExecuteSend');
    const btnText = document.getElementById('btnExecuteSendText');
    const resultArea = document.getElementById('sendResultFeedbackArea');

    btn.disabled = true;
    btnText.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span>Aligo 전송 중...';

    try {
      const res = await fetch('/api/notifications/sms/send-test', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          receiver,
          receiverName: sampleName,
          title,
          content: finalContent,
          templateCode,
          rdate,
          rtime,
          testmode
        })
      });

      const data = await res.json();
      resultArea.classList.remove('d-none');

      if (data.success) {
        resultArea.innerHTML = `
          <div class="alert alert-success border-0 shadow-sm py-2.5 px-3 mb-0 rounded-3">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <strong class="d-flex align-items-center gap-1.5 text-success">
                <i class="bi bi-check-circle-fill"></i> 발송 성공 (결과코드: ${data.result_code})
              </strong>
              <span class="badge bg-success-subtle text-success border border-success-subtle">${data.msg_type} (${data.byteLength} Byte)</span>
            </div>
            <div class="small text-dark mb-1">${data.message || '성공적으로 전송요청 하였습니다.'}</div>
            <div class="small text-muted font-monospace" style="font-size: 0.73rem;">
              • 메시지 ID: <strong>${data.msg_id || '-'}</strong> | 수신번호: <strong>${receiver}</strong><br>
              • 발송 모드: ${data.testmode ? '<span class=\"text-warning-emphasis fw-bold\">테스트모드 (건수 미차감)</span>' : '<span class=\"text-primary fw-bold\">실제 발송 완료</span>'}
            </div>
            <div class="mt-2 pt-2 border-top d-flex justify-content-between align-items-center">
              <span class="small text-secondary">발송 이력 테이블(sms_log)에 기록되었습니다.</span>
              <a href="/notifications/history" class="btn btn-xs btn-outline-success py-0 px-2 small">이력 확인</a>
            </div>
          </div>
        `;
        // 잔여량 새로고침
        checkAligoRemain(true);
      } else {
        const isIpError = (data.message && data.message.includes('IP')) || (data.result_code === -101 || data.result_code === '-101');
        resultArea.innerHTML = `
          <div class="alert alert-danger border-0 shadow-sm py-2.5 px-3 mb-0 rounded-3">
            <div class="fw-bold mb-1 d-flex align-items-center gap-1.5 text-danger">
              <i class="bi bi-exclamation-triangle-fill"></i> 발송 실패 (결과코드: ${data.result_code || '-'})
            </div>
            <div class="small text-dark mb-1">${data.message}</div>
            ${isIpError ? `
              <div class="p-2 mt-2 bg-white rounded border border-danger-subtle small">
                <div class="fw-bold text-dark mb-1"><i class="bi bi-shield-exclamation text-danger me-1"></i>해결 방법: 알리고 발송 서버 IP 등록 필요</div>
                <div class="text-secondary mb-1" style="font-size: 0.72rem;">현재 PC/서버의 공인 IP: <code class="fw-bold text-primary">222.108.71.219</code></div>
                <div class="d-flex gap-2">
                  <button type="button" class="btn btn-xs btn-outline-primary py-0.5 px-2" onclick="navigator.clipboard.writeText('222.108.71.219'); alert('222.108.71.219 가 복사되었습니다.');">
                    <i class="bi bi-clipboard me-1"></i>IP 복사
                  </button>
                  <a href="https://smartsms.aligo.in" target="_blank" class="btn btn-xs btn-outline-dark py-0.5 px-2">
                    <i class="bi bi-box-arrow-up-right me-1"></i>알리고 관리자 열기
                  </a>
                </div>
              </div>
            ` : ''}
            ${data.isSimulated ? `
              <div class="mt-2 pt-2 border-top">
                <button type="button" class="btn btn-sm btn-outline-danger py-0.5 px-2 small" data-bs-toggle="modal" data-bs-target="#modalAligoConfig">
                  <i class="bi bi-gear-fill me-1"></i>Aligo 연동 설정 바로가기
                </button>
              </div>
            ` : ''}
          </div>
        `;
      }
    } catch (err) {
      resultArea.classList.remove('d-none');
      resultArea.innerHTML = `
        <div class="alert alert-danger border-0 shadow-sm py-2.5 px-3 mb-0 rounded-3">
          <div class="fw-bold text-danger mb-1"><i class="bi bi-x-circle-fill me-1"></i> 통신 에러 발생</div>
          <div class="small text-muted">${err.message}</div>
        </div>
      `;
    } finally {
      btn.disabled = false;
      btnText.textContent = 'Aligo 문자 발송 실행';
    }
  }

  // ========================================================
  // 템플릿 상태(USE/HIDE) 토글 (실제 API 연동)
  // ========================================================
  async function toggleTemplateUse(id, btn) {
    try {
      const res = await fetch(`/api/notifications/templates/${id}/toggle`, { method: 'POST' });
      const data = await res.json();
      if (data.success) {
        if (data.use_yn === 'Y') {
          btn.className = 'btn btn-xs btn-success py-0.5 px-2 fw-semibold shadow-xs';
          btn.textContent = 'USE';
        } else {
          btn.className = 'btn btn-xs btn-danger py-0.5 px-2 fw-semibold shadow-xs';
          btn.textContent = 'HIDE';
        }
      } else {
        alert(data.message || '상태 변경 실패');
      }
    } catch (e) {
      alert('오류 발생: ' + e.message);
    }
  }

  // 템플릿 삭제
  async function deleteTemplate(id, name) {
    if (!confirm(`'${name}' 템플릿을 정말 삭제하시겠습니까?`)) return;
    try {
      const res = await fetch(`/api/notifications/templates/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        alert('삭제되었습니다.');
        location.reload();
      } else {
        alert(data.message || '삭제 실패');
      }
    } catch (e) {
      alert('오류 발생: ' + e.message);
    }
  }

  // ========================================================
  // 템플릿 신규 등록 / 수정 모달 제어
  // ========================================================
  function openTemplateModal() {
    document.getElementById('tplModalTitle').innerHTML = '<i class="bi bi-plus-circle-fill text-primary"></i><span>신규 템플릿 등록</span>';
    document.getElementById('editTplId').value = '';
    document.getElementById('editTplCode').value = 'SMS_' + Date.now().toString().slice(-6);
    document.getElementById('editTplName').value = '';
    document.getElementById('editModalTitleInput').value = '[KT몰] ';
    document.getElementById('editModalContentInput').value = '';
    const modal = new bootstrap.Modal(document.getElementById('modalTemplateEdit'));
    modal.show();
  }

  function editTemplateModal(id) {
    const t = templatesData.find(item => item.id === id);
    if (!t) return;
    document.getElementById('tplModalTitle').innerHTML = '<i class="bi bi-pencil-square text-primary"></i><span>템플릿 속성 수정</span>';
    document.getElementById('editTplId').value = t.id;
    document.getElementById('editTplCode').value = t.template_code;
    document.getElementById('editTplName').value = t.template_name;
    document.getElementById('editConditionType').value = t.condition_type || 'D_DAY';
    document.getElementById('editConditionDays').value = t.condition_days || 0;
    document.getElementById('editSendCycle').value = t.send_cycle || 'REALTIME';
    document.getElementById('editSendTime').value = t.send_time || '10:00';
    document.getElementById('editModalTitleInput').value = t.title || '';
    document.getElementById('editModalContentInput').value = t.content || '';

    const modal = new bootstrap.Modal(document.getElementById('modalTemplateEdit'));
    modal.show();
  }

  async function saveTemplateData(e) {
    e.preventDefault();
    const id = document.getElementById('editTplId').value;
    const template_code = document.getElementById('editTplCode').value.trim();
    const template_name = document.getElementById('editTplName').value.trim();
    const condition_type = document.getElementById('editConditionType').value;
    const condition_days = document.getElementById('editConditionDays').value;
    const send_cycle = document.getElementById('editSendCycle').value;
    const send_time = document.getElementById('editSendTime').value.trim();
    const title = document.getElementById('editModalTitleInput').value.trim();
    const content = document.getElementById('editModalContentInput').value.trim();
    const msg_type = calculateBytes(content) > 90 ? 'LMS' : 'SMS';

    const btn = document.getElementById('btnSaveTplModal');
    btn.disabled = true;

    try {
      const res = await fetch('/api/notifications/templates/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          id: id || undefined,
          template_code,
          template_name,
          msg_type,
          condition_type,
          condition_days,
          condition_desc: condition_type === 'D_DAY' ? '개통 당일 (D-Day)' : (condition_type === 'AFTER_D' ? `개통 후 D+${condition_days}일` : `약정만료 D-${condition_days}일`),
          send_cycle,
          send_cycle_desc: send_cycle === 'REALTIME' ? '실시간 즉시 발송' : (send_cycle === 'DAILY' ? '매일 정기 발송' : '매주 정기 발송'),
          send_time,
          title,
          content
        })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
        location.reload();
      } else {
        alert(data.message || '저장 실패');
      }
    } catch (err) {
      alert('오류: ' + err.message);
    } finally {
      btn.disabled = false;
    }
  }

  // ========================================================
  // Aligo 연동 설정 저장 및 잔여량 조회
  // ========================================================
  async function saveAligoConfig(e) {
    e.preventDefault();
    const apiKey = document.getElementById('cfgApiKey').value.trim();
    const userId = document.getElementById('cfgUserId').value.trim();
    const sender = document.getElementById('cfgSender').value.trim();
    const testmodeYn = document.querySelector('input[name="cfgTestmode"]:checked').value;

    const btn = document.getElementById('btnSaveAligoConfig');
    btn.disabled = true;

    try {
      const res = await fetch('/api/notifications/sms/config', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ apiKey, userId, sender, testmodeYn })
      });
      const data = await res.json();
      if (data.success) {
        alert('Aligo 연동 설정이 sys_config 에 안전하게 저장되었습니다.');
        location.reload();
      } else {
        alert(data.message || '설정 저장 실패');
      }
    } catch (err) {
      alert('오류: ' + err.message);
    } finally {
      btn.disabled = false;
    }
  }

  async function checkAligoRemain(isSilent = false) {
    try {
      const res = await fetch('/api/notifications/sms/remain');
      const data = await res.json();
      if (data.configured && !data.error) {
        const text = `SMS: ${Number(data.SMS_CNT || 0).toLocaleString()}건 | LMS: ${Number(data.LMS_CNT || 0).toLocaleString()}건`;
        const cardDisplay = document.getElementById('cardRemainDisplay');
        const topBadge = document.getElementById('topRemainBadge');
        if (cardDisplay) cardDisplay.textContent = text;
        if (topBadge) topBadge.textContent = text;

        if (!isSilent) {
          alert(`[Aligo 계정 잔여 건수]\n\n• SMS (단문): ${Number(data.SMS_CNT || 0).toLocaleString()} 건\n• LMS (장문): ${Number(data.LMS_CNT || 0).toLocaleString()} 건\n• MMS (그림): ${Number(data.MMS_CNT || 0).toLocaleString()} 건`);
        }
      } else {
        if (!isSilent) alert(data.message || 'Aligo 연동 정보를 확인해 주세요.');
      }
    } catch (e) {
      if (!isSilent) alert('잔여 건수 조회 오류: ' + e.message);
    }
  }
</script>

