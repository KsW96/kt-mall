            </div>
            <button type="button" class="btn btn-xs btn-outline-dark py-0.5 px-2" onclick="navigator.clipboard.writeText('222.108.71.219'); alert('공인 IP가 클립보드에 복사되었습니다: 222.108.71.219');">
              <i class="bi bi-clipboard me-1"></i>IP 복사
