<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : title %> | Admin Portal</title>
  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <!-- Bootstrap Icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <!-- Custom Admin CSS -->
  <link rel="stylesheet" href="/css/style.css">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    // 사이드바 접힘 상태 즉시 복원 (페이지 로드 시 깜빡임 방지)
    (function() {
      try {
        if (localStorage.getItem('admin_sidebar_collapsed') === 'true') {
          document.documentElement.classList.add('sidebar-collapsed');
        }
      } catch (e) {}
    })();
  </script>
</head>
<body class="bg-light">
  <!-- Top Navbar -->
  <header class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top px-3 py-2 shadow-sm">
    <div class="d-flex align-items-center">
      <button class="btn btn-outline-light btn-sm me-3 d-inline-flex align-items-center justify-content-center" id="sidebarToggle" type="button" title="사이드바 열기/닫기 (화면 넓게 보기)" aria-label="사이드바 토글">
        <i class="bi bi-layout-sidebar-inset fs-6" id="sidebarToggleIcon"></i>
      </button>
      <a class="navbar-brand fw-bold d-flex align-items-center gap-2 mb-0" href="/">
        <i class="bi bi-grid-1x2-fill text-primary"></i>
        <span>Admin Portal</span>
      </a>
    </div>

    <div class="ms-auto d-flex align-items-center gap-2">
      <!-- Auto Reload Controller Dropdown -->
      <div class="dropdown" id="autoReloadDropdownContainer">
        <button class="btn btn-sm btn-outline-light dropdown-toggle d-flex align-items-center gap-1.5 py-1 px-2.5" type="button" id="btnAutoReload" data-bs-toggle="dropdown" aria-expanded="false" title="자동 새로고침 주기 및 스마트 변경 감지 설정">
          <i class="bi bi-arrow-repeat text-light" id="autoReloadIcon"></i>
          <span class="small font-monospace" id="autoReloadLabel">자동갱신: 스마트</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm" style="min-width: 210px; font-size: 0.82rem;">
          <li><h6 class="dropdown-header small text-muted">새로고침 방식 설정</h6></li>
          <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between active" type="button" onclick="setAutoReloadMode('smart')">
              <span><i class="bi bi-magic text-primary me-2"></i>데이터 변경 시 자동</span>
              <i class="bi bi-check2 auto-reload-check" data-mode="smart"></i>
            </button>
          </li>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between" type="button" onclick="setAutoReloadMode('1m')">
              <span><i class="bi bi-stopwatch me-2 text-secondary"></i>1분 주기</span>
              <i class="bi bi-check2 auto-reload-check d-none" data-mode="1m"></i>
            </button>
          </li>
          <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between" type="button" onclick="setAutoReloadMode('3m')">
              <span><i class="bi bi-stopwatch me-2 text-secondary"></i>3분 주기</span>
              <i class="bi bi-check2 auto-reload-check d-none" data-mode="3m"></i>
            </button>
          </li>
          <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between" type="button" onclick="setAutoReloadMode('5m')">
              <span><i class="bi bi-stopwatch me-2 text-secondary"></i>5분 주기</span>
              <i class="bi bi-check2 auto-reload-check d-none" data-mode="5m"></i>
            </button>
          </li>
          <li><hr class="dropdown-divider my-1"></li>
          <li>
            <button class="dropdown-item d-flex align-items-center justify-content-between" type="button" onclick="setAutoReloadMode('off')">
              <span><i class="bi bi-pause-circle me-2 text-danger"></i>자동 갱신 끄기 (수동)</span>
              <i class="bi bi-check2 auto-reload-check d-none" data-mode="off"></i>
            </button>
          </li>
        </ul>
      </div>

      <!-- Database Status Badge -->
      <% if (dbStatus && dbStatus.connected) { %>
        <span class="badge bg-success-subtle text-success border border-success px-2 py-1 d-flex align-items-center gap-1">
          <i class="bi bi-database-fill-check"></i> MySQL Connected
        </span>
      <% } else { %>
        <span class="badge bg-warning-subtle text-warning-emphasis border border-warning px-2 py-1 d-flex align-items-center gap-1" title="MySQL 미연결 상태: 샘플 Mock 데이터로 동작 중">
          <i class="bi bi-database-exclamation"></i> Mock Data Mode
        </span>
      <% } %>

      <div class="dropdown">
        <button class="btn btn-sm btn-outline-secondary dropdown-toggle text-light" type="button" data-bs-toggle="dropdown">
          <i class="bi bi-person-circle me-1"></i> 관리자
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
          <li><span class="dropdown-item-text text-muted small">admin@system.local</span></li>
          <li><hr class="dropdown-divider"></li>
          <li><a class="dropdown-item" href="/dashboard"><i class="bi bi-speedometer2 me-2"></i>대시보드</a></li>
          <li><a class="dropdown-item" href="/data"><i class="bi bi-table me-2"></i>데이터 관리</a></li>
        </ul>
      </div>
    </div>
  </header>

  <!-- Smart Data Change Floating Notification Toast -->
  <div id="dataChangeToast" class="position-fixed top-0 end-0 p-3 d-none" style="z-index: 9999; margin-top: 50px;">
    <div class="toast show shadow-lg border border-primary-subtle rounded-3" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="toast-header bg-primary text-white py-2">
        <i class="bi bi-bell-fill me-2"></i>
        <strong class="me-auto">최신 데이터 감지</strong>
        <small class="text-white-50">실시간 감지</small>
        <button type="button" class="btn-close btn-close-white" onclick="dismissDataChangeToast()"></button>
      </div>
      <div class="toast-body bg-white text-dark small py-2.5">
        <p class="mb-2 text-secondary">출력 중인 데이터의 최신 변경 내역이 감지되었습니다.</p>
        <div class="d-flex justify-content-end gap-2">
          <button type="button" class="btn btn-sm btn-light border py-1 px-2.5 small" onclick="dismissDataChangeToast()">나중에</button>
          <button type="button" class="btn btn-sm btn-primary py-1 px-2.5 small fw-semibold" onclick="location.reload()">
            <i class="bi bi-arrow-clockwise me-1"></i>지금 새로고침
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="container-fluid">
    <div class="row">

