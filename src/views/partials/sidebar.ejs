<!-- Sidebar Navigation -->
<nav id="sidebarMenu" class="col-md-3 col-lg-2 d-md-block bg-white sidebar shadow-sm min-vh-100 p-3">
  <div class="position-sticky pt-2">
    <div class="d-flex align-items-center justify-content-between px-2 mb-2 pb-1 border-bottom">
      <div class="text-uppercase text-secondary fw-semibold small" style="font-size: 0.75rem; letter-spacing: 0.05em;">
        메인 메뉴
      </div>
      <div class="d-flex align-items-center gap-1">
        <!-- 데스크탑 사이드바 접기 버튼 -->
        <button type="button" class="btn btn-sm btn-light border-0 text-secondary p-1 rounded-2 d-none d-md-inline-flex align-items-center justify-content-center" id="sidebarCollapseBtn" title="사이드바 접기 (화면 넓게 보기)" style="width: 26px; height: 26px;">
          <i class="bi bi-chevron-bar-left fs-6"></i>
        </button>
        <!-- 모바일 사이드바 닫기 버튼 -->
        <button type="button" class="btn-close d-md-none small" id="sidebarCloseMobile" aria-label="사이드바 닫기" style="font-size: 0.75rem;"></button>
      </div>
    </div>
    <ul class="nav flex-column gap-1">
      <% if (typeof sidebarTree !== 'undefined' && sidebarTree && sidebarTree.length > 0) { %>
        <% sidebarTree.forEach(root => { %>
          <% const hasChildren = root.children && root.children.length > 0; %>
          <% const isRootActive = (typeof activeMenu !== 'undefined' && (root.menu_url === '/' + activeMenu)); %>
          <% const isChildActive = hasChildren && root.children.some(c => (typeof activeMenu !== 'undefined' && (
               c.menu_url === '/' + activeMenu ||
               (activeMenu === 'system-menus' && c.menu_url === '/system/menus') ||
               (activeMenu === 'system-configs' && c.menu_url === '/system/configs') ||
               (activeMenu === 'notification-sms' && c.menu_url === '/notifications/sms') ||
               (activeMenu === 'notification-alimtalk' && c.menu_url === '/notifications/alimtalk') ||
               (activeMenu === 'notification-history' && c.menu_url === '/notifications/history')
             ))); %>
          <% const isGroupActive = isRootActive || isChildActive; %>

          <% if (hasChildren) { %>
            <!-- 상위-하위 계층형 드롭다운/토글 메뉴 (아코디언) -->
            <% const isRootUnimplemented = false; %>
            <li class="nav-item">
              <a class="nav-link rounded-3 d-flex align-items-center gap-2 text-dark <%= isGroupActive ? 'fw-bold bg-light' : '' %> <%= isGroupActive ? '' : 'collapsed' %> <%= isRootUnimplemented ? 'unimplemented-sidebar-link' : '' %>"
                 data-bs-toggle="collapse"
                 href="#collapse-menu-<%= root.menu_id %>"
                 role="button"
                 aria-expanded="<%= isGroupActive ? 'true' : 'false' %>"
                 <% if (isRootUnimplemented) { %>data-bs-toggle="tooltip" data-bs-placement="right" title="기능 준비 중 (UI 프로토타입)"<% } %>>
                <i class="bi <%= root.menu_icon || 'bi-folder-fill' %>"></i>
                <span><%= root.menu_name %></span>
                <% if (isRootUnimplemented) { %>
                  <span class="unimplemented-badge ms-1">미구현</span>
                <% } %>
                <i class="bi bi-chevron-down ms-auto sidebar-chevron small text-secondary"></i>
              </a>
              <div class="collapse <%= isGroupActive ? 'show' : '' %>" id="collapse-menu-<%= root.menu_id %>">
                <div class="sidebar-submenu ps-2 py-1 my-1">
                  <ul class="nav flex-column gap-1">
                    <% root.children.forEach(sub => { %>
                      <% const hasSubChildren = sub.children && sub.children.length > 0; %>
                      <% const isSubActive = (typeof activeMenu !== 'undefined' && (
                           sub.menu_url === '/' + activeMenu ||
                           (activeMenu === 'system-menus' && sub.menu_url === '/system/menus') ||
                           (activeMenu === 'system-configs' && sub.menu_url === '/system/configs') ||
                           (activeMenu === 'notification-sms' && sub.menu_url === '/notifications/sms') ||
                           (activeMenu === 'notification-alimtalk' && sub.menu_url === '/notifications/alimtalk') ||
                           (activeMenu === 'notification-history' && sub.menu_url === '/notifications/history')
                         )); %>
                      <% const isSubGroupActive = isSubActive || (hasSubChildren && sub.children.some(leaf => typeof activeMenu !== 'undefined' && (leaf.menu_url === '/' + activeMenu))); %>
                      <% const isSubUnimplemented = sub.menu_url && sub.menu_url === '/notifications/alimtalk'; %>
                      
                      <% if (hasSubChildren) { %>
                        <!-- 소메뉴를 가진 중메뉴 (2차 아코디언 토글) -->
                        <li class="nav-item">
                          <a class="nav-link d-flex align-items-center gap-2 <%= isSubGroupActive ? 'fw-semibold text-primary' : 'text-secondary' %> <%= isSubGroupActive ? '' : 'collapsed' %> <%= isSubUnimplemented ? 'unimplemented-sidebar-link' : '' %>"
                             data-bs-toggle="collapse"
                             href="#collapse-sub-<%= sub.menu_id %>"
                             role="button"
                             aria-expanded="<%= isSubGroupActive ? 'true' : 'false' %>">
                            <i class="bi <%= sub.menu_icon || 'bi-folder2' %>" style="font-size: 0.85rem;"></i>
                            <span><%= sub.menu_name %></span>
                            <% if (isSubUnimplemented) { %>
                              <span class="unimplemented-badge ms-auto">미구현</span>
                            <% } %>
                            <i class="bi bi-chevron-down ms-auto sidebar-chevron small text-secondary" style="font-size: 0.7rem;"></i>
                          </a>
                          <div class="collapse <%= isSubGroupActive ? 'show' : '' %>" id="collapse-sub-<%= sub.menu_id %>">
                            <div class="sidebar-submenu ps-3 py-1 my-1 border-start ms-2">
                              <ul class="nav flex-column gap-1">
                                <% sub.children.forEach(leaf => { %>
                                  <% const isLeafActive = (typeof activeMenu !== 'undefined' && (leaf.menu_url.includes(activeMenu) || leaf.menu_url === '/' + activeMenu)); %>
                                  <% const isLeafUnimplemented = leaf.menu_url && leaf.menu_url === '/notifications/alimtalk'; %>
                                  <li class="nav-item">
                                    <a class="nav-link py-1 d-flex align-items-center gap-2 <%= isLeafActive ? 'active fw-bold text-primary' : 'text-muted' %> <%= isLeafUnimplemented ? 'unimplemented-sidebar-link' : '' %>" 
                                       href="<%= leaf.menu_url %>" 
                                       style="font-size: 0.82rem;"
                                       <% if (isLeafUnimplemented) { %>data-bs-toggle="tooltip" data-bs-placement="right" title="기능 준비 중 (미구현)"<% } %>>
                                      <i class="bi <%= leaf.menu_icon || 'bi-dash' %>" style="font-size: 0.75rem;"></i>
                                      <span><%= leaf.menu_name %></span>
                                      <% if (isLeafUnimplemented) { %>
                                        <span class="unimplemented-badge ms-auto">미구현</span>
                                      <% } %>
                                    </a>
                                  </li>
                                <% }); %>
                              </ul>
                            </div>
                          </div>
                        </li>
                      <% } else { %>
                        <!-- 단일 중메뉴 링크 -->
                        <li class="nav-item">
                          <a class="nav-link d-flex align-items-center gap-2 <%= isSubActive ? 'active' : '' %> <%= isSubUnimplemented ? 'unimplemented-sidebar-link' : '' %>" 
                             href="<%= sub.menu_url %>"
                             <% if (isSubUnimplemented) { %>data-bs-toggle="tooltip" data-bs-placement="right" title="기능 준비 중 (미구현)"<% } %>>
                            <i class="bi <%= sub.menu_icon || 'bi-dot' %>" style="font-size: 0.8rem;"></i>
                            <span><%= sub.menu_name %></span>
                            <% if (isSubUnimplemented) { %>
                              <span class="unimplemented-badge ms-auto">미구현</span>
                            <% } %>
                          </a>
                        </li>
                      <% } %>
                    <% }); %>
                  </ul>
                </div>
              </div>
            </li>
          <% } else { %>
            <!-- 단일 메뉴 링크 -->
            <li class="nav-item">
              <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= isRootActive ? 'active bg-primary text-white' : 'text-dark' %>" href="<%= root.menu_url %>">
                <i class="bi <%= root.menu_icon || 'bi-circle' %>"></i>
                <span><%= root.menu_name %></span>
              </a>
            </li>
          <% } %>
        <% }); %>
      <% } else { %>
        <!-- 폴백 메뉴 (DB 미연결 등) -->
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= activeMenu === 'dashboard' ? 'active bg-primary text-white' : 'text-dark' %>" href="/dashboard">
            <i class="bi bi-speedometer2"></i>
            <span>대시보드</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= activeMenu === 'stats' ? 'active bg-primary text-white' : 'text-dark' %>" href="/stats">
            <i class="bi bi-bar-chart-line"></i>
            <span>통계 분석</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= activeMenu === 'data' ? 'active bg-primary text-white' : 'text-dark' %>" href="/data">
            <i class="bi bi-table"></i>
            <span>데이터 조회</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= activeMenu === 'users' ? 'active bg-primary text-white' : 'text-dark' %>" href="/users">
            <i class="bi bi-people-fill"></i>
            <span>회원 관리</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= activeMenu === 'activations' ? 'active bg-primary text-white' : 'text-dark' %>" href="/activations">
            <i class="bi bi-phone-fill"></i>
            <span>개통 이력</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= activeMenu === 'user-activations' ? 'active bg-primary text-white' : 'text-dark' %>" href="/user-activations">
            <i class="bi bi-person-lines-fill"></i>
            <span>회원 개통 이력</span>
          </a>
        </li>
        <li class="nav-item">
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 <%= (activeMenu === 'system-menus' || activeMenu === 'system-configs') ? 'active bg-primary text-white' : 'text-dark' %>" href="/system/menus">
            <i class="bi bi-gear-fill"></i>
            <span>시스템 관리</span>
          </a>
        </li>
        <li class="nav-item">
          <% const isNotiActive = (activeMenu === 'notification-sms' || activeMenu === 'notification-alimtalk'); %>
          <a class="nav-link rounded-3 d-flex align-items-center gap-2 text-dark <%= isNotiActive ? 'fw-bold bg-light' : '' %> <%= isNotiActive ? '' : 'collapsed' %>"
             data-bs-toggle="collapse"
             href="#collapse-menu-fallback-noti"
             role="button"
             aria-expanded="<%= isNotiActive ? 'true' : 'false' %>">
            <i class="bi bi-chat-square-text-fill"></i>
            <span>메세지 관리</span>
            <i class="bi bi-chevron-down ms-auto sidebar-chevron small text-secondary"></i>
          </a>
          <div class="collapse <%= isNotiActive ? 'show' : '' %>" id="collapse-menu-fallback-noti">
            <div class="sidebar-submenu ps-2 py-1 my-1">
              <ul class="nav flex-column gap-1">
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2 <%= activeMenu === 'notification-sms' ? 'active' : '' %>" href="/notifications/sms">
                    <i class="bi bi-chat-dots-fill"></i>
                    <span>문자 관리</span>
                  </a>
                </li>
                <li class="nav-item">
                  <a class="nav-link d-flex align-items-center gap-2 <%= activeMenu === 'notification-alimtalk' ? 'active' : '' %>" href="/notifications/alimtalk">
                    <i class="bi bi-chat-quote-fill"></i>
                    <span>알림톡 관리</span>
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </li>
      <% } %>
    </ul>

    <hr class="my-4">

    <div class="text-uppercase text-secondary fw-semibold small px-3 mb-2" style="font-size: 0.75rem; letter-spacing: 0.05em;">
      시스템 정보
    </div>
    <div class="p-3 bg-light rounded-3 small">
      <div class="text-muted mb-1">데이터베이스:</div>
      <div class="fw-bold mb-2">
        <% if (dbStatus && dbStatus.connected) { %>
          <span class="text-success"><i class="bi bi-check-circle-fill"></i> MySQL 활성</span>
        <% } else { %>
          <span class="text-warning-emphasis"><i class="bi bi-info-circle-fill"></i> In-Memory Mock</span>
        <% } %>
      </div>
      <div class="text-muted" style="font-size: 0.75rem;">
        추후 <code>.env</code> 파일의 DB 정보를 실제 MySQL 설정으로 변경하면 즉시 연동됩니다.
      </div>
    </div>
  </div>
</nav>

