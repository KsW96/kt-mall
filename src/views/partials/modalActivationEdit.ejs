                </div>

                <div class="col-md-3 col-sm-6 act-field-item" data-field-name="미비서류 missing_docs">
                  <label class="form-label small fw-semibold text-secondary mb-1">
                    미비서류 <span class="text-muted fw-normal font-monospace" style="font-size:0.72rem;">(missing_docs)</span>
                  </label>
                  <input type="text" class="form-control form-control-sm" id="act_missing_docs" name="missing_docs" placeholder="미비서류 내역">
                </div>

                <div class="col-md-6 col-sm-12 act-field-item" data-field-name="비고1 remark1">
                  <label class="form-label small fw-semibold text-secondary mb-1">
                    비고 1 <span class="text-muted fw-normal font-monospace" style="font-size:0.72rem;">(remark1)</span>
                  </label>
                  <textarea class="form-control form-control-sm" id="act_remark1" name="remark1" rows="2" placeholder="비고 1 메모"></textarea>
                </div>

                <div class="col-md-6 col-sm-12 act-field-item" data-field-name="비고2 remark2">
                  <label class="form-label small fw-semibold text-secondary mb-1">
                    비고 2 <span class="text-muted fw-normal font-monospace" style="font-size:0.72rem;">(remark2)</span>
                  </label>
                  <textarea class="form-control form-control-sm" id="act_remark2" name="remark2" rows="2" placeholder="비고 2 메모"></textarea>
                </div>
              </div>
            </div>

          </div>
        </div>

        <div class="modal-footer bg-light py-2 px-4 d-flex justify-content-between align-items-center">
          <div class="small text-muted">
            <i class="bi bi-info-circle me-1 text-primary"></i>통신사 80개 원본 컬럼 중 수정할 필드를 입력 후 저장을 누르면 DB에 즉시 반영됩니다.
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">닫기</button>
            <button type="submit" class="btn btn-sm btn-primary px-3 shadow-sm" id="btnSaveActivation">
              <i class="bi bi-check-lg me-1"></i>수정 내용 저장
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // 80개 컬럼 전체 필드명 목록 (JS 동적 바인딩용)
  const ALL_80_FIELD_NAMES = [
    'excel_no', 'mgmt_cd', 'opening_dt', 'model_nm', 'serial_num', 'prod_type',
    'factory_price', 'vat', 'factory_price_novat', 'opening_manager_nm',
    'cust_nm', 'phone_num', 'color', 'birth_dt', 'biz_num',
    'holder_group', 'holder_nick_nm', 'holder_nm', 'seller_nick_nm', 'seller_nm',
    'sales_num', 'seller_cd', 'stock_move', 'seller_user_nm', 'receiving_store_nm',
    'opening_store_nm', 'join_type', 'join_category', 'prepaid_yn', 'mnp_type',
    'processor_nm', 'join_fee', 'installment_period', 'yt_generation', 'agency_cd',
    'tertiary_store', 'cust_grade', 'discount_amt', 'sponsor', 'contract_months',
    'bond_fee', 'bond_fee_type', 'monthly_installment', 'prepayment', 'usage_period',
    'usage_amt', 'installment_principal', 'fee_billing', 'contract_discount', 'plan_nm',
    'extra_services', 'return_type', 'return_model_nm', 'return_serial_num', 'doc_num',
    'missing_docs', 'combined_prod', 'cust_id', 'cust_type', 'contract_period',
    'attract_card', 'usim_model_nm', 'usim_prod_type', 'stock_type', 'usim_serial_num',
    'pay_type', 'pay_amt', 'remark1', 'remark2', 'sub_yn',
    'billing_account_num', 'verify_result', 'auto_manual_type', 'accessory', 'form_reg_dt',
    'collection_path', 'common_subsidy', 'add_subsidy', 'agreement_opt', 'stock_category'
  ];

  // 모달 내부 80개 필드 실시간 검색 필터
  function filterActivationModalFields(query) {
    const q = (query || '').toLowerCase().trim();
    const items = document.querySelectorAll('.act-field-item');
    items.forEach(el => {
      const fieldData = (el.dataset.fieldName || '').toLowerCase();
      if (!q || fieldData.includes(q)) {
        el.classList.remove('d-none');
        if (q) {
          el.style.backgroundColor = '#fffbeb';
          el.style.borderRadius = '6px';
        } else {
          el.style.backgroundColor = '';
        }
      } else {
        el.classList.add('d-none');
        el.style.backgroundColor = '';
      }
    });

    // 검색어 입력 시, 일치 항목이 있는 탭을 자동으로 찾아 활성화
    if (q) {
      const activeTabContent = document.querySelector('#actTabContent .tab-pane.active');
      const visibleInActive = activeTabContent ? activeTabContent.querySelectorAll('.act-field-item:not(.d-none)').length : 0;
      if (visibleInActive === 0) {
        // 일치 항목이 있는 첫 번째 탭 찾기
        for (const pane of document.querySelectorAll('#actTabContent .tab-pane')) {
          if (pane.querySelectorAll('.act-field-item:not(.d-none)').length > 0) {
            const triggerBtn = document.querySelector(`[data-bs-target="#${pane.id}"]`);
            if (triggerBtn && window.bootstrap && bootstrap.Tab) {
              bootstrap.Tab.getOrCreateInstance(triggerBtn).show();
            }
            break;
          }
        }
      }
    }
  }

  // 안전한 모달 열기 함수 (Bootstrap 및 Pure JS 폴백 지원)
  function showActivationModalSafe(el) {
    if (!el) return;
    if (el.parentElement !== document.body) {
      document.body.appendChild(el);
    }
    if (window.bootstrap && bootstrap.Modal) {
      try {
        const instance = bootstrap.Modal.getOrCreateInstance(el);
        if (instance) {
          instance.show();
          return;
        }
      } catch (e) {
        try {
          new bootstrap.Modal(el).show();
          return;
        } catch (e2) {}
      }
    }
    // Pure JS fallback
    el.classList.add('show');
    el.style.display = 'block';
    el.setAttribute('aria-modal', 'true');
    el.removeAttribute('aria-hidden');
    document.body.classList.add('modal-open');
    let backdrop = document.querySelector('.modal-backdrop');
    if (!backdrop) {
      backdrop = document.createElement('div');
      backdrop.className = 'modal-backdrop fade show';
      document.body.appendChild(backdrop);
      backdrop.onclick = () => hideActivationModalSafe(el);
    }
  }

  // 안전한 모달 닫기 함수
  function hideActivationModalSafe(el) {
    if (!el) return;
    if (window.bootstrap && bootstrap.Modal) {
      try {
        const instance = bootstrap.Modal.getInstance(el);
        if (instance) {
          instance.hide();
          return;
        }
      } catch (e) {}
    }
    el.classList.remove('show');
    el.style.display = 'none';
    el.setAttribute('aria-hidden', 'true');
    el.removeAttribute('aria-modal');
    document.body.classList.remove('modal-open');
    const backdrop = document.querySelector('.modal-backdrop');
    if (backdrop) backdrop.remove();
  }

  // 개통 상세/수정 모달 열기
  async function openActivationEditModal(id, event, linkedUserData) {
    if (event) {
      if (typeof event.stopPropagation === 'function') event.stopPropagation();
      if (typeof event.preventDefault === 'function') event.preventDefault();
    }

    const modalEl = document.getElementById('modalActivationEdit');
    if (!modalEl) {
      alert('개통 상세 모달 요소를 찾을 수 없습니다.');
      return;
    }

    // 닫기 버튼들에 폴백 이벤트 바인딩
    modalEl.querySelectorAll('[data-bs-dismiss="modal"]').forEach(btn => {
      btn.onclick = () => hideActivationModalSafe(modalEl);
    });

    // 폼 초기화
    document.getElementById('formActivationEdit').reset();
    document.getElementById('editActId').value = id;
    document.getElementById('actFieldQuickFilter').value = '';
    filterActivationModalFields('');

    // 헤더 뱃지 초기화
    document.getElementById('badgeActId').textContent = `ID: ${id}`;
    document.getElementById('badgeActCustNm').textContent = '고객명: 로딩중...';
    document.getElementById('badgeActPhone').textContent = '개통번호: -';
    document.getElementById('badgeActOpeningDt').textContent = '개통일: -';

    // 로딩 알림 표시 후 모달 즉시 오픈! (클릭 시각 피드백 보장)
    const alertBox = document.getElementById('actEditAlert');
    alertBox.className = 'alert alert-info py-2 px-3 small mb-3';
    alertBox.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> 80개 상세 개통 데이터를 불러오는 중입니다...';
    alertBox.classList.remove('d-none');
    showActivationModalSafe(modalEl);

    // 연결 회원 정보 처리
    const linkedUserBox = document.getElementById('actLinkedUserBox');
    if (linkedUserData && linkedUserData.un) {
      linkedUserBox.classList.remove('d-none');
      document.getElementById('linkedUserNm').textContent = linkedUserData.nm || '-';
      document.getElementById('linkedUserUn').textContent = linkedUserData.un || '-';
      document.getElementById('linkedUserBirth').textContent = linkedUserData.birth_dt || '-';
      const btnLink = document.getElementById('btnOpenLinkedUserModal');
      btnLink.onclick = () => {
        hideActivationModalSafe(modalEl);
        setTimeout(() => {
          if (typeof openUserEditModal === 'function') {
            openUserEditModal(linkedUserData.un);
          }
        }, 200);
      };
    } else {
      linkedUserBox.classList.add('d-none');
    }

    // 1번 탭으로 초기화
    const firstTabBtn = document.getElementById('tab-act-cust-tab');
    if (firstTabBtn && window.bootstrap && bootstrap.Tab) {
      bootstrap.Tab.getOrCreateInstance(firstTabBtn).show();
    }

    try {
      const res = await fetch(`/api/activations/${id}`);
      const data = await res.json();

      if (data.success && data.activation) {
        const act = data.activation;

        // 상단 뱃지 갱신
        document.getElementById('badgeActCustNm').textContent = `고객명: ${act.cust_nm || '-'}`;
        document.getElementById('badgeActPhone').textContent = `개통번호: ${act.phone_num || '-'}`;
        document.getElementById('badgeActOpeningDt').textContent = `개통일: ${act.opening_dt || '-'}`;

        // 80개 필드 일괄 매핑
        ALL_80_FIELD_NAMES.forEach(f => {
          const input = document.getElementById(`act_${f}`);
          if (input) {
            input.value = (act[f] !== null && act[f] !== undefined) ? act[f] : '';
          }
        });

        alertBox.classList.add('d-none');
      } else {
        alertBox.className = 'alert alert-danger py-2 px-3 small mb-3';
        alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i> 데이터를 불러오지 못했습니다: ${data.message || '데이터 없음'}`;
      }
    } catch (err) {
      alertBox.className = 'alert alert-danger py-2 px-3 small mb-3';
      alertBox.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i> 통신 에러: ${err.message}`;
    }
  }

  // 개통 정보 수정 폼 비동기 전송
  const formActivationEditEl = document.getElementById('formActivationEdit');
  if (formActivationEditEl) {
    formActivationEditEl.addEventListener('submit', async (e) => {
      e.preventDefault();
      const id = document.getElementById('editActId').value;
      const btn = document.getElementById('btnSaveActivation');
      const alertBox = document.getElementById('actEditAlert');

      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> 저장 중...';

      const updateData = {};
      ALL_80_FIELD_NAMES.forEach(f => {
        const input = document.getElementById(`act_${f}`);
        if (input) {
          updateData[f] = input.value.trim();
        }
      });

      try {
        const res = await fetch(`/api/activations/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(updateData)
        });
        const result = await res.json();

        if (result.success) {
          alertBox.className = 'alert alert-success py-2 px-3 small mb-3';
          alertBox.innerHTML = `<i class="bi bi-check-circle-fill me-1"></i> ${result.message}`;
          alertBox.classList.remove('d-none');
          setTimeout(() => location.reload(), 600);
        } else {
          alertBox.className = 'alert alert-danger py-2 px-3 small mb-3';
          alertBox.innerHTML = `<i class="bi bi-exclamation-triangle-fill me-1"></i> ${result.message}`;
          alertBox.classList.remove('d-none');
          btn.disabled = false;
          btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>수정 내용 저장';
        }
      } catch (err) {
        alertBox.className = 'alert alert-danger py-2 px-3 small mb-3';
        alertBox.innerHTML = `<i class="bi bi-x-circle-fill me-1"></i> 통신 에러: ${err.message}`;
        alertBox.classList.remove('d-none');
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>수정 내용 저장';
      }
    });
  }
</script>

