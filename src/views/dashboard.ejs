<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1"><%= (typeof currentMenu !== 'undefined' && currentMenu && currentMenu.menu_name) ? currentMenu.menu_name : '대시보드' %></h1>
      <p class="text-muted small mb-0">시스템의 전반적인 운영 지표와 현황을 한눈에 확인합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <a href="/users" class="btn btn-sm btn-success">
        <i class="bi bi-people-fill me-1"></i> 회원 관리 (app_user)
      </a>
      <a href="/data" class="btn btn-sm btn-primary">
        <i class="bi bi-search me-1"></i> 데이터 조회
      </a>
      <a href="/stats" class="btn btn-sm btn-outline-secondary">
        <i class="bi bi-graph-up me-1"></i> 통계 분석
      </a>
    </div>
  </div>

  <!-- Metric Summary Cards -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-folder2-open fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">총 데이터 건수</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1">
              <%= (overview.totalCount || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-currency-krw fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">총 누적 금액</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1 text-truncate">
              <%= (overview.totalAmount || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">원</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-info-subtle text-info me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-check-circle fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">처리 완료</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1">
              <%= (overview.completedCount || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-warning-subtle text-warning me-3 flex-shrink-0" style="width: 52px; height: 52px;">
            <i class="bi bi-hourglass-split fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">대기 / 진행중</div>
            <div class="fs-4 fw-bold text-dark mb-0 lh-1 mt-1">
              <%= (overview.pendingCount || 0).toLocaleString() %><span class="fs-6 fw-normal text-muted ms-1">건</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Charts Row -->
  <div class="row g-4 mb-4">
    <!-- Daily Trend Line Chart -->
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm rounded-3 h-100">
        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0">최근 일자별 등록 및 금액 추이</h5>
          <span class="badge bg-light text-secondary">최근 7일</span>
        </div>
        <div class="card-body">
          <canvas id="dailyTrendChart" style="max-height: 280px;"></canvas>
        </div>
      </div>
    </div>

    <!-- Category Distribution Chart -->
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm rounded-3 h-100">
        <div class="card-header bg-white border-0 pt-3 pb-0">
          <h5 class="fw-bold mb-0">카테고리별 비중</h5>
        </div>
        <div class="card-body d-flex align-items-center justify-content-center">
          <canvas id="categoryChart" style="max-height: 260px;"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Data Table -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between align-items-center">
      <div>
        <h5 class="fw-bold mb-0">최근 등록된 데이터</h5>
        <span class="text-muted small">최근 추가된 상위 5건의 데이터입니다.</span>
      </div>
      <a href="/data" class="btn btn-sm btn-outline-primary">전체 목록 보기</a>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th scope="col" class="ps-4">코드</th>
              <th scope="col">건명</th>
              <th scope="col">카테고리</th>
              <th scope="col">금액</th>
              <th scope="col">고객/담당자</th>
              <th scope="col">상태</th>
              <th scope="col" class="pe-4 text-end">등록일시</th>
            </tr>
          </thead>
          <tbody>
            <% if (recentItems && recentItems.length > 0) { %>
              <% recentItems.forEach(item => { %>
                <tr>
                  <td class="ps-4 fw-medium text-secondary"><code><%= item.code %></code></td>
                  <td class="fw-semibold text-dark"><%= item.title %></td>
                  <td><span class="badge bg-secondary-subtle text-secondary"><%= item.category %></span></td>
                  <td><%= (item.amount || 0).toLocaleString() %>원</td>
                  <td><%= item.customer %></td>
                  <td>
                    <% if (item.status === 'COMPLETED') { %>
                      <span class="badge bg-success">완료</span>
                    <% } else if (item.status === 'PENDING') { %>
                      <span class="badge bg-warning text-dark">대기</span>
                    <% } else { %>
                      <span class="badge bg-danger">취소</span>
                    <% } %>
                  </td>
                  <td class="pe-4 text-end text-muted small"><%= item.createdAt || item.created_at %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-muted">등록된 데이터가 없습니다.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<script>
  // Chart Data Injection from EJS
  const dailyTrends = <%- JSON.stringify(dailyTrends || []) %>;
  const categoryStats = <%- JSON.stringify(categoryStats || []) %>;

  // 1. Daily Trend Chart
  const trendCtx = document.getElementById('dailyTrendChart').getContext('2d');
  new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: dailyTrends.map(d => d.date),
      datasets: [
        {
          label: '등록 건수 (건)',
          data: dailyTrends.map(d => d.count),
          borderColor: '#3B82F6',
          backgroundColor: 'rgba(59, 130, 246, 0.1)',
          fill: true,
          tension: 0.3,
          yAxisID: 'y'
        },
        {
          label: '총 금액 (천원)',
          data: dailyTrends.map(d => Math.round(d.totalAmount / 1000)),
          borderColor: '#10B981',
          backgroundColor: 'transparent',
          borderDash: [5, 5],
          tension: 0.3,
          yAxisID: 'y1'
        }
      ]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        y: {
          beginAtZero: true,
          title: { display: true, text: '건수' }
        },
        y1: {
          position: 'right',
          beginAtZero: true,
          grid: { drawOnChartArea: false },
          title: { display: true, text: '금액(천원)' }
        }
      }
    }
  });

  // 2. Category Pie/Doughnut Chart
  const catCtx = document.getElementById('categoryChart').getContext('2d');
  new Chart(catCtx, {
    type: 'doughnut',
    data: {
      labels: categoryStats.map(c => c.category),
      datasets: [{
        data: categoryStats.map(c => c.count),
        backgroundColor: [
          '#3B82F6', '#10B981', '#F59E0B', '#8B5CF6', '#EC4899', '#6B7280'
        ]
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: {
        legend: {
          position: 'bottom'
        }
      }
    }
  });
</script>

<%- include('partials/footer') %>

