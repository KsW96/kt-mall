<%- include('partials/header') %>
<%- include('partials/sidebar') %>

<main class="col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4">
  <!-- Page Header -->
  <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-4 border-bottom">
    <div>
      <h1 class="h3 fw-bold mb-1 d-flex align-items-center gap-2">
        <i class="bi bi-sliders text-success"></i>
        <span>공통 설정 및 코드 관리</span>
      </h1>
      <p class="text-muted small mb-0">시스템 공통 코드, 최근 엑셀 업로드 일시(MEMBER_EXCEL, OPEN_EXCEL), 공인 IP를 Key-Value 구조로 동적 관리합니다.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
      <!-- IP 감지 버튼 -->
      <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-1 shadow-sm" id="btnDetectIp">
        <i class="bi bi-broadcast"></i>
        <span>공인 IP 자동 감지/갱신</span>
      </button>
      <!-- 신규 등록 버튼 -->
      <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm" onclick="openConfigModal()">
        <i class="bi bi-plus-circle-fill"></i>
        <span>신규 설정/코드 등록</span>
      </button>
    </div>
  </div>

  <!-- Navigation Tabs (독립 페이지 탭 네비게이션) -->
  <ul class="nav nav-tabs mb-4 border-bottom gap-1">
    <li class="nav-item">
      <a class="nav-link text-secondary px-3 py-2" href="/system/menus">
        <i class="bi bi-diagram-3 me-1"></i>계층형 메뉴 관리 (sys_menu)
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link active fw-bold text-success px-3 py-2 border-bottom-0" href="/system/configs">
        <i class="bi bi-sliders me-1"></i>공통 설정 및 코드 관리 (sys_config)
      </a>
    </li>
  </ul>

  <!-- Summary Cards -->
  <div class="row g-3 mb-4">
    <!-- Card 1: 회원정보 최근 업로드 -->
    <div class="col-sm-6 col-xl-4">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-file-earmark-person fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">회원 엑셀 최근 업로드</div>
            <div class="fs-6 fw-bold text-dark mb-0 mt-1 text-truncate" id="summaryMemberUpload" title="<%= meta.memberLastUpload %>">
              <%= meta.memberLastUpload %>
            </div>
            <span class="badge bg-primary-subtle text-primary-emphasis mt-1" style="font-size: 0.7rem;">MEMBER_EXCEL</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 2: 개통정보 최근 업로드 -->
    <div class="col-sm-6 col-xl-4">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-success-subtle text-success me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-phone-vibrate fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">개통 엑셀 최근 업로드</div>
            <div class="fs-6 fw-bold text-dark mb-0 mt-1 text-truncate" id="summaryOpenUpload" title="<%= meta.openLastUpload %>">
              <%= meta.openLastUpload %>
            </div>
            <span class="badge bg-success-subtle text-success-emphasis mt-1" style="font-size: 0.7rem;">OPEN_EXCEL</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Card 3: 내 공인 IP 주소 -->
    <div class="col-sm-6 col-xl-4">
      <div class="card h-100 border-0 shadow-sm rounded-3">
        <div class="card-body p-3 d-flex align-items-center">
          <div class="rounded-3 d-flex align-items-center justify-content-center bg-info-subtle text-info me-3 flex-shrink-0" style="width: 50px; height: 50px;">
            <i class="bi bi-hdd-network fs-4"></i>
          </div>
          <div class="flex-grow-1 min-w-0">
            <div class="text-secondary small fw-medium text-truncate">내 공인 IP 주소</div>
            <div class="fs-6 fw-bold font-monospace text-dark mb-0 mt-1 text-truncate" id="summaryPublicIp">
              <%= meta.publicIp %>
            </div>
            <span class="badge bg-info-subtle text-info-emphasis mt-1" style="font-size: 0.7rem;">PUBLIC_IP</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Global Alert Box -->
  <div id="systemAlertBox" class="alert d-none py-2 px-3 small mb-3"></div>

  <!-- Configs Table Card -->
  <div class="card border-0 shadow-sm rounded-3">
    <div class="card-header bg-white border-0 pt-3 pb-2 d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div>
        <h5 class="fw-bold mb-0 fs-6 d-flex align-items-center gap-2">
          <i class="bi bi-sliders text-success"></i>
          <span>공통 설정 및 코드 목록 (Key-Value 통합)</span>
          <span class="badge bg-secondary-subtle text-dark ms-1"><%= configs.length %>건</span>
        </h5>
        <small class="text-muted">그룹 코드(`group_code`)와 항목 코드(`item_code`)를 유니크 키로 시스템 설정을 동적 관리합니다.</small>
      </div>

      <div class="d-flex align-items-center gap-2">
        <!-- 그룹 필터 -->
        <select class="form-select form-select-sm" style="width: auto;" onchange="filterConfigGroup(this.value)">
          <option value="">전체 그룹 코드</option>
          <% groupCodes.forEach(g => { %>
            <option value="<%= g %>" <%= groupFilter === g ? 'selected' : '' %>><%= g %></option>
          <% }); %>
        </select>

        <button type="button" class="btn btn-sm btn-success d-flex align-items-center gap-1 shadow-sm" onclick="openConfigModal()">
          <i class="bi bi-plus-circle-fill"></i>
          <span>신규 등록</span>
        </button>
      </div>
    </div>

    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 user-table" style="min-width: 1050px;">
          <thead class="table-light">
            <tr>
              <th scope="col" class="text-center" style="width: 50px;">ID</th>
              <th scope="col" class="text-center" style="width: 140px;">그룹 코드</th>
              <th scope="col" class="text-start" style="width: 160px;">항목 코드</th>
              <th scope="col" class="text-start" style="width: 180px;">항목 명칭</th>
              <th scope="col" class="text-start" style="width: 220px;">설정 값 (Value)</th>
              <th scope="col" class="text-start" style="width: 200px;">설명</th>
              <th scope="col" class="text-center" style="width: 60px;">순서</th>
              <th scope="col" class="text-center" style="width: 75px;">사용</th>
              <th scope="col" class="text-center" style="width: 85px;">관리</th>
            </tr>
          </thead>
          <tbody>
            <% if (configs && configs.length > 0) { %>
              <% configs.forEach(c => { %>
                <tr>
                  <!-- ID -->
                  <td class="text-center text-muted small"><%= c.id %></td>

                  <!-- 그룹 코드 -->
                  <td class="text-center">
                    <span class="badge bg-secondary-subtle text-dark border font-monospace"><%= c.group_code %></span>
                  </td>

                  <!-- 항목 코드 -->
                  <td class="text-start font-monospace fw-semibold text-primary">
                    <%= c.item_code %>
                  </td>

                  <!-- 항목 명칭 -->
                  <td class="text-start fw-medium text-dark">
                    <%= c.item_name %>
                  </td>

                  <!-- 설정 값 (Value) -->
                  <td class="text-start">
                    <div class="d-flex align-items-center gap-1">
                      <code class="text-break bg-light px-2 py-1 rounded small border text-dark font-monospace flex-grow-1" style="max-height: 48px; overflow-y: auto;">
                        <%= c.item_value !== null && c.item_value !== undefined ? c.item_value : '(null)' %>
                      </code>
                      <button type="button" class="btn btn-sm btn-link text-secondary p-0 btn-quick-edit" title="빠른 값 수정"
                        data-id="<%= c.id %>"
                        data-group="<%= c.group_code %>"
                        data-item="<%= c.item_code %>"
                        data-value="<%= c.item_value || '' %>">
                        <i class="bi bi-pencil"></i>
                      </button>
                    </div>
                  </td>

                  <!-- 설명 -->
                  <td class="text-start small text-muted text-truncate" style="max-width: 200px;" title="<%= c.description || '' %>">
                    <%= c.description || '-' %>
                  </td>

                  <!-- 순서 -->
                  <td class="text-center font-monospace"><%= c.sort_order %></td>

                  <!-- 사용 여부 -->
                  <td class="text-center">
                    <% if (c.use_yn === 'Y') { %>
                      <span class="badge bg-success-subtle text-success">Y</span>
                    <% } else { %>
                      <span class="badge bg-danger-subtle text-danger">N</span>
                    <% } %>
                  </td>

                  <!-- 관리 -->
                  <td class="text-center">
                    <div class="btn-group btn-group-sm">
                      <button type="button" class="btn btn-outline-secondary py-0 px-2 btn-edit-config" title="상세 수정"
                        data-config="<%- encodeURIComponent(JSON.stringify(c)) %>">
                        <i class="bi bi-pencil-square"></i>
                      </button>
                      <button type="button" class="btn btn-outline-danger py-0 px-2" title="삭제" onclick="deleteConfig(<%= c.id %>, '<%= c.item_code %>')">
                        <i class="bi bi-trash"></i>
                      </button>
                    </div>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="9" class="text-center py-5 text-muted">
                  등록된 설정 데이터가 없습니다. 상단의 <strong>[신규 등록]</strong> 버튼을 클릭하여 추가해 보세요.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<!-- ======================================================== -->
<!-- MODAL 1: 공통 설정 등록 / 수정 (sys_config)              -->
<!-- ======================================================== -->
<div class="modal fade" id="modalConfig" tabindex="-1" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <form id="formConfig">
        <input type="hidden" name="config_id" id="configIdInput">
        <div class="modal-header bg-light">
          <h5 class="modal-title fw-bold fs-6" id="modalConfigTitle">
            <i class="bi bi-sliders text-success me-1"></i> 설정 및 코드 등록
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body p-4">
          <!-- 그룹 코드 -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">그룹 코드 (group_code) <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm font-monospace text-uppercase" name="group_code" id="configGroupInput" list="groupDatalist" placeholder="예: UPLOAD_META, SERVER_ENV, COMMON_CODE" required>
            <datalist id="groupDatalist">
              <option value="UPLOAD_META">
              <option value="SERVER_ENV">
              <option value="COMMON_CODE">
              <option value="SECURITY">
            </datalist>
          </div>

          <!-- 항목 코드 -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">항목 코드 (item_code) <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm font-monospace text-uppercase" name="item_code" id="configItemInput" placeholder="예: MEMBER_EXCEL, OPEN_EXCEL, PUBLIC_IP" required>
            <div class="form-text small">동일 그룹 내에서 고유(Unique)해야 합니다.</div>
          </div>

          <!-- 항목 명칭 -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">항목 명칭 (item_name) <span class="text-danger">*</span></label>
            <input type="text" class="form-control form-control-sm" name="item_name" id="configNameInput" placeholder="예: 회원정보 최근 업로드 일시" required>
          </div>

          <!-- 설정 값 -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">설정 값 (item_value)</label>
            <textarea class="form-control form-control-sm font-monospace" name="item_value" id="configValueInput" rows="3" placeholder="저장할 설정 값 또는 JSON/일시 문자열"></textarea>
          </div>

          <!-- 설명 -->
          <div class="mb-3">
            <label class="form-label small fw-semibold text-secondary">설명 (description)</label>
            <input type="text" class="form-control form-control-sm" name="description" id="configDescInput" placeholder="설정의 용도 및 상세 설명">
          </div>

          <div class="row g-2 mb-2">
            <!-- 정렬 순서 -->
            <div class="col-sm-6">
              <label class="form-label small fw-semibold text-secondary">정렬 순서</label>
              <input type="number" class="form-control form-control-sm" name="sort_order" id="configSortInput" value="0" min="0">
            </div>

            <!-- 사용 여부 -->
            <div class="col-sm-6">
              <label class="form-label small fw-semibold text-secondary">사용 여부</label>
              <select class="form-select form-select-sm" name="use_yn" id="configUseSelect">
                <option value="Y">USE (사용)</option>
                <option value="N">HIDE (숨김)</option>
              </select>
            </div>
          </div>
        </div>
        <div class="modal-footer bg-light py-2">
          <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">취소</button>
          <button type="submit" class="btn btn-sm btn-success px-3" id="btnSaveConfig">저장하기</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: 빠른 값 수정 모달                               -->
<!-- ======================================================== -->
<div class="modal fade" id="modalQuickEdit" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow">
      <div class="modal-header bg-light">
        <h5 class="modal-title fw-bold fs-6">
          <i class="bi bi-pencil-square text-primary me-1"></i> 설정 값(Value) 빠른 수정
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-4">
        <input type="hidden" id="quickEditId">
        <div class="mb-2">
          <span class="badge bg-secondary-subtle text-dark border font-monospace" id="quickEditGroup"></span>
          <strong class="font-monospace ms-1 text-primary" id="quickEditItem"></strong>
        </div>
        <div class="mb-3">
          <label class="form-label small fw-semibold text-secondary">변경할 값</label>
          <textarea class="form-control font-monospace" id="quickEditValue" rows="4"></textarea>
        </div>
      </div>
      <div class="modal-footer bg-light py-2">
        <button type="button" class="btn btn-sm btn-light border" data-bs-dismiss="modal">닫기</button>
        <button type="button" class="btn btn-sm btn-primary px-3" onclick="submitQuickEdit()">적용하기</button>
      </div>
    </div>
  </div>
</div>

<!-- Frontend JavaScript -->
<script>
  // 알림 메시지 헬퍼
  function showAlert(msg, type = 'success') {
    const box = document.getElementById('systemAlertBox');
    box.className = `alert alert-${type} py-2 px-3 small mb-3`;
    box.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle-fill' : 'exclamation-triangle-fill'} me-1"></i> ${msg}`;
    box.classList.remove('d-none');
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => {
      box.classList.add('d-none');
    }, 4000);
  }

  // ==========================================
  // 공통 설정 / 코드 모달 관리 (지연 생성으로 Bootstrap 오류 방지)
  // ==========================================
  function openConfigModal() {
    document.getElementById('formConfig').reset();
    document.getElementById('configIdInput').value = '';
    document.getElementById('modalConfigTitle').innerHTML = '<i class="bi bi-sliders text-success me-1"></i> 신규 설정/코드 등록';
    document.getElementById('configUseSelect').value = 'Y';
    const modalEl = document.getElementById('modalConfig');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  function editConfig(c) {
    document.getElementById('configIdInput').value = c.id;
    document.getElementById('modalConfigTitle').innerHTML = '<i class="bi bi-pencil-square text-success me-1"></i> 설정 수정: ' + c.item_code;
    document.getElementById('configGroupInput').value = c.group_code || '';
    document.getElementById('configItemInput').value = c.item_code || '';
    document.getElementById('configNameInput').value = c.item_name || '';
    document.getElementById('configValueInput').value = c.item_value || '';
    document.getElementById('configDescInput').value = c.description || '';
    document.getElementById('configSortInput').value = c.sort_order || 0;
    document.getElementById('configUseSelect').value = c.use_yn || 'Y';
    const modalEl = document.getElementById('modalConfig');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  window.addEventListener('DOMContentLoaded', () => {
    // 설정 상세 수정 버튼 이벤트
    document.querySelectorAll('.btn-edit-config').forEach(btn => {
      btn.addEventListener('click', () => {
        try {
          const config = JSON.parse(decodeURIComponent(btn.dataset.config));
          editConfig(config);
        } catch (e) {
          console.error(e);
        }
      });
    });

    // 설정 값 빠른 수정 버튼 이벤트
    document.querySelectorAll('.btn-quick-edit').forEach(btn => {
      btn.addEventListener('click', () => {
        const { id, group, item, value } = btn.dataset;
        quickEditValue(parseInt(id, 10), group, item, value);
      });
    });
  });

  document.getElementById('formConfig').addEventListener('submit', async (e) => {
    e.preventDefault();
    const configId = document.getElementById('configIdInput').value;
    const isEdit = !!configId;

    const payload = {
      group_code: document.getElementById('configGroupInput').value.trim().toUpperCase(),
      item_code: document.getElementById('configItemInput').value.trim().toUpperCase(),
      item_name: document.getElementById('configNameInput').value.trim(),
      item_value: document.getElementById('configValueInput').value,
      description: document.getElementById('configDescInput').value.trim(),
      sort_order: parseInt(document.getElementById('configSortInput').value, 10) || 0,
      use_yn: document.getElementById('configUseSelect').value
    };

    const url = isEdit ? `/api/system/configs/${configId}` : '/api/system/configs';
    const method = isEdit ? 'PUT' : 'POST';

    try {
      const res = await fetch(url, {
        method,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getInstance(document.getElementById('modalConfig')) : null;
        if (modal) modal.hide();
        showAlert(data.message);
        setTimeout(() => {
          location.reload();
        }, 600);
      } else {
        alert('오류: ' + data.message);
      }
    } catch (err) {
      alert('요청 중 통신 에러 발생: ' + err.message);
    }
  });

  async function deleteConfig(configId, itemCode) {
    if (!confirm(`[${itemCode}] 설정 항목을 삭제하시겠습니까?`)) return;

    try {
      const res = await fetch(`/api/system/configs/${configId}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) {
        showAlert(data.message);
        setTimeout(() => {
          location.reload();
        }, 600);
      } else {
        alert('삭제 실패: ' + data.message);
      }
    } catch (err) {
      alert('삭제 중 통신 에러 발생: ' + err.message);
    }
  }

  // 그룹 필터 변경
  function filterConfigGroup(group) {
    const url = group ? `/system/configs?group=${encodeURIComponent(group)}` : '/system/configs';
    location.href = url;
  }

  // ==========================================
  // 빠른 값 수정 모달
  // ==========================================
  let currentQuickEditConfig = null;

  async function quickEditValue(id, group, item, val) {
    document.getElementById('quickEditId').value = id;
    document.getElementById('quickEditGroup').textContent = group;
    document.getElementById('quickEditItem').textContent = item;
    document.getElementById('quickEditValue').value = val;

    try {
      const res = await fetch(`/api/system/configs?group=${group}`);
      const data = await res.json();
      if (data.success) {
        currentQuickEditConfig = data.configs.find(c => c.id === id);
      }
    } catch (e) {}

    const modalEl = document.getElementById('modalQuickEdit');
    const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getOrCreateInstance(modalEl) : null;
    if (modal) modal.show();
  }

  async function submitQuickEdit() {
    const id = document.getElementById('quickEditId').value;
    const newVal = document.getElementById('quickEditValue').value;

    if (!currentQuickEditConfig) {
      alert('설정 정보를 불러오지 못했습니다.');
      return;
    }

    const payload = {
      ...currentQuickEditConfig,
      item_value: newVal
    };

    try {
      const res = await fetch(`/api/system/configs/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (data.success) {
        const modalEl = document.getElementById('modalQuickEdit');
        const modal = (window.bootstrap && bootstrap.Modal) ? bootstrap.Modal.getInstance(modalEl) : null;
        if (modal) modal.hide();
        showAlert('설정 값이 성공적으로 변경되었습니다.');
        setTimeout(() => location.reload(), 600);
      } else {
        alert('수정 실패: ' + data.message);
      }
    } catch (err) {
      alert('통신 에러: ' + err.message);
    }
  }

  // ==========================================
  // 공인 IP 감지 및 갱신 버튼 이벤트
  // ==========================================
  document.getElementById('btnDetectIp').addEventListener('click', async () => {
    const btn = document.getElementById('btnDetectIp');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> IP 감지 중...';

    try {
      const res = await fetch('/api/system/detect-ip', { method: 'POST' });
      const data = await res.json();

      if (data.success) {
        document.getElementById('summaryPublicIp').textContent = data.ip;
        showAlert(data.message);
      } else {
        alert('IP 감지 실패: ' + data.message);
      }
    } catch (err) {
      alert('IP 감지 요청 실패: ' + err.message);
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="bi bi-broadcast"></i> <span>공인 IP 자동 감지/갱신</span>';
    }
  });
</script>

